{
	quest.B100000000000352.title: "Engineer's Hammer"
	quest.B100000000000352.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000352.quest_desc: [
		"&6Goal:&r Craft an Engineer's Hammer.",
		"",
		"Multiblock formation, plate crafting, and many IE interactions start with this hammer.",
		"",
		"&7Tip:&r Keep it in your hotbar whenever you place coke oven or blast furnace bricks.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B100000000000353.title: "Engineer's Manual"
	quest.B100000000000353.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000353.quest_desc: [
		"&6Goal:&r Craft the Engineer's Manual.",
		"",
		"In-game documentation for every multiblock and wire — worth a permanent Curios/offhand slot.",
		"",
		"&7Tip:&r Form structures as the book shows; the hammer confirms when they click into place."
	]
	quest.B100000000000354.title: "Treated Wood"
	quest.B100000000000354.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000354.quest_desc: [
		"&6Goal:&r Craft &632 Treated Wood Planks&r.",
		"",
		"Creosote-treated wood is IE scaffolding for waterwheels, windmills, and crafting tables.",
		"",
		"&7Tip:&r Coke ovens produce creosote — bootstrap with Immersive or MI coke byproducts."
	]
	quest.B100000000000355.title: "Industrial Hemp"
	quest.B100000000000355.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000355.quest_desc: [
		"&6Goal:&r Collect &624 Industrial Hemp Fibers&r.",
		"",
		"Hemp makes tough fabric for windmill sails, wiring insulation, and engineering crafts.",
		"",
		"&7Tip:&r Farm hemp like a crop; rope and fabric recipes burn stacks."
	]
	quest.B100000000000356.title: "Coke Bricks"
	quest.B100000000000356.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000356.quest_desc: [
		"&6Goal:&r Craft &627 Coke Bricks&r.",
		"",
		"Build a 3×3×3 Coke Oven hollow and form it with the Engineer's Hammer.",
		"",
		"&7Tip:&r Coal in, coal coke + creosote out — steel's best friend."
	]
	quest.B100000000000357.title: "Coal Coke"
	quest.B100000000000357.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000357.quest_desc: [
		"&6Goal:&r Produce &616 Coal Coke&r from a Coke Oven.",
		"",
		"Coke fuels the Blast Furnace. Creosote byproduct treats wood for more IE structures.",
		"",
		"&7Tip:&r Pipe creosote to a wooden barrel or tank so it doesn't void."
	]
	quest.B100000000000358.title: "Blast Bricks"
	quest.B100000000000358.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000358.quest_desc: [
		"&6Goal:&r Craft &627 Blast Bricks&r.",
		"",
		"Assemble a Crude Blast Furnace and hammer-form it to smelt iron + coke into steel.",
		"",
		"&7Tip:&r Reinforced blast bricks upgrade throughput later."
	]
	quest.B100000000000359.title: "IE Steel"
	quest.B100000000000359.quest_subtitle: "Immersive Engineering · Steel"
	quest.B100000000000359.quest_desc: [
		"&6Goal:&r Produce &616 Steel Ingots&r via Immersive Engineering.",
		"",
		"Steel feeds Heavy Engineering blocks, steel scaffolding, and HV components.",
		"",
		"&7Tip:&r Slag is a byproduct — stash or process it instead of clogging hoppers."
	]
	quest.B10000000000035A.title: "Light Engineering"
	quest.B10000000000035A.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035A.quest_desc: [
		"&6Goal:&r Craft &68 Light Engineering Blocks&r.",
		"",
		"Component blocks for many mid-tier IE machines and multiblocks.",
		"",
		"&7Tip:&r Iron, copper, and components — batch craft with a Create press line if you like."
	]
	quest.B10000000000035B.title: "Heavy Engineering"
	quest.B10000000000035B.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035B.quest_desc: [
		"&6Goal:&r Craft &64 Heavy Engineering Blocks&r.",
		"",
		"Steel-tier component blocks for crushers, diesel generators, and arc furnaces.",
		"",
		"&7Tip:&r Keep steel sheetmetal and scaffolding in the same chest."
	]
	quest.B10000000000035C.title: "Engineer's Workbench"
	quest.B10000000000035C.quest_subtitle: "Immersive Engineering · Crafting"
	quest.B10000000000035C.quest_desc: [
		"&6Goal:&r Craft an Engineer's Workbench.",
		"",
		"Craft blueprints, schematics, and specialized IE recipes here.",
		"",
		"&7Tip:&r The Automated Workbench later runs blueprint recipes hands-free."
	]
	quest.B10000000000035D.title: "LV Copper Coils"
	quest.B10000000000035D.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035D.quest_desc: [
		"&6Goal:&r Craft &616 LV Wire Coils&r.",
		"",
		"Connect LV connectors with copper coils to move IFE across your workshop.",
		"",
		"&7Tip:&r Wirecutters remove wires; relays extend long runs."
	]
	quest.B10000000000035E.title: "LV Connectors"
	quest.B10000000000035E.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035E.quest_desc: [
		"&6Goal:&r Craft &68 LV Wire Connectors&r.",
		"",
		"Attach connectors to machines and capacitors, then spool wire between them.",
		"",
		"&7Tip:&r Mind voltage tiers — LV/MV/HV are not freely interchangeable."
	]
	quest.B10000000000035F.title: "LV Accumulator"
	quest.B10000000000035F.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035F.quest_desc: [
		"&6Goal:&r Craft an LV Accumulator.",
		"",
		"Buffer IFE so waterwheels and diesel generators don't brown out machines.",
		"",
		"&7Tip:&r Upgrade to MV/HV capacitors as you climb wire tiers."
	]
	quest.B100000000000360.title: "Windmill"
	quest.B100000000000360.quest_subtitle: "Immersive Engineering · Kinetic"
	quest.B100000000000360.quest_desc: [
		"&6Goal:&r Craft a Windmill.",
		"",
		"Kinetic power from wind — attach sails and connect through IE's kinetic dynamo chain.",
		"",
		"&7Tip:&r Place high with clear air; hemp fabric sails improve capture."
	]
	quest.B100000000000361.title: "Radiator Block"
	quest.B100000000000361.quest_subtitle: "Immersive Engineering · Power"
	quest.B100000000000361.quest_desc: [
		"&6Goal:&r Craft &64 Radiator Blocks&r.",
		"",
		"Radiators appear in Diesel Generator multiblocks and other heat-heavy IE structures.",
		"",
		"&7Tip:&r Follow the Engineer's Manual to form a Diesel Generator once you have biodiesel."
	]
	quest.B100000000000362.title: "IE Conveyors"
	quest.B100000000000362.quest_subtitle: "Immersive Engineering · Processing"
	quest.B100000000000362.quest_desc: [
		"&6Goal:&r Craft &616 Basic Conveyors&r.",
		"",
		"Move items into crushers, furnaces, and assemblers without Create belts if you prefer IE logistics.",
		"",
		"&7Tip:&r Covered and vertical variants help keep factories tidy."
	]
	quest.B100000000000363.title: "Graphite Electrode"
	quest.B100000000000363.quest_subtitle: "Immersive Engineering · Endgame"
	quest.B100000000000363.quest_desc: [
		"&6Goal:&r Craft a Graphite Electrode.",
		"",
		"Electrodes fuel the Arc Furnace multiblock — IE's high-throughput alloying endgame.",
		"",
		"&7Tip:&r Blueprint the electrode at the Engineer's Workbench, then build the Arc Furnace from the manual."
	]
}
