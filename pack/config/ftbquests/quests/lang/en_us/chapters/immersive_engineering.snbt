{
	quest.B100000000000352.title: "Engineer's Hammer"
	quest.B100000000000352.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000352.quest_desc: [
		"&6Goal:&r Craft an Engineer's Hammer.",
		"",
		"Multiblock formation, plate crafting, and most IE interactions start with this hammer — keep it hotbarred.",
		"",
		"&6How:&r
&e1.&r Craft the &6Engineer's Hammer&r (iron + stick pattern — JEI).
&e2.&r Right-click metal ingots in-world or in crafting contexts to form plates when recipes call for hammering.
&e3.&r After building a brick multiblock, right-click the center face block to form it.",
		"",
		"&7Tip:&r Without the hammer, Coke Ovens and Blast Furnaces stay as pretty brick piles.",
		"",
		"&7Next:&r Craft the Engineer's Manual for in-game diagrams.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B100000000000353.title: "Engineer's Manual"
	quest.B100000000000353.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000353.quest_desc: [
		"&6Goal:&r Craft the Engineer's Manual.",
		"",
		"In-game documentation for every multiblock, wire tier, and blueprint — worth a permanent offhand/Curios slot.",
		"",
		"&6How:&r
&e1.&r Craft the &6Engineer's Manual&r and open it.
&e2.&r Find the Coke Oven / Blast Furnace pages and note the 3×3×3 brick layouts before you place blocks.",
		"",
		"&7Tip:&r Form structures exactly as the book shows; the hammer click confirms when they assemble.",
		"",
		"&7Next:&r Make Treated Wood once you have creosote (or bootstrap from another coke source)."
	]
	quest.B100000000000354.title: "Treated Wood"
	quest.B100000000000354.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000354.quest_desc: [
		"&6Goal:&r Craft &632 Treated Wood Planks&r.",
		"",
		"Creosote-treated wood is IE scaffolding for waterwheels, windmills, crafting stations, and many recipes.",
		"",
		"&6How:&r
&e1.&r Obtain &6Creosote Oil&r from a Coke Oven (or another mod's coke byproduct).
&e2.&r Craft planks with creosote in the crafting grid / JEI recipe to make &6Treated Wood&r.
&e3.&r Stock a chest — sails, scaffolds, and engineering crafts burn through it.",
		"",
		"&7Tip:&r Pipe creosote into a wooden barrel or tank so the Coke Oven never voids fluid.",
		"",
		"&7Next:&r Grow Industrial Hemp for fabric and insulation."
	]
	quest.B100000000000355.title: "Industrial Hemp"
	quest.B100000000000355.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000355.quest_desc: [
		"&6Goal:&r Collect &624 Industrial Hemp Fibers&r.",
		"",
		"Hemp makes tough fabric for windmill sails, wiring insulation, and engineering crafts.",
		"",
		"&6How:&r
&e1.&r Find or craft &6Industrial Hemp Seeds&r and plant them on farmland.
&e2.&r Harvest mature hemp for fibers; craft fabric/rope as recipes need.",
		"",
		"&7Tip:&r Farm hemp like a crop — rope and fabric recipes burn stacks.",
		"",
		"&7Next:&r Craft Coke Bricks for the Coke Oven multiblock."
	]
	quest.B100000000000356.title: "Coke Bricks"
	quest.B100000000000356.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000356.quest_desc: [
		"&6Goal:&r Craft &627 Coke Bricks&r.",
		"",
		"Exactly 27 Coke Bricks build the 3×3×3 Coke Oven — coal in, coal coke + creosote out.",
		"",
		"&6How:&r
&e1.&r Craft &627 Coke Bricks&r (clay + sand + brick pattern — JEI).
&e2.&r Build a solid &63×3×3&r cube of Coke Bricks on flat ground.
&e3.&r Right-click the &6center block of any face&r with the &6Engineer's Hammer&r to form the Coke Oven.
&e4.&r Open the formed oven GUI — if it did not form, recheck the cube is complete and flush.",
		"",
		"&7Tip:&r Leave space beside one face for hoppers/pipes; the GUI face is where you hammered.",
		"",
		"&7Next:&r Run coal through for Coal Coke and creosote."
	]
	quest.B100000000000357.title: "Coal Coke"
	quest.B100000000000357.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000357.quest_desc: [
		"&6Goal:&r Produce &616 Coal Coke&r from a Coke Oven.",
		"",
		"Coke fuels the Blast Furnace. Creosote byproduct treats wood for more IE structures.",
		"",
		"&6How:&r
&e1.&r Put &6Coal&r (or cokeable blocks) into the Coke Oven input.
&e2.&r Wait for the process; pull &6Coal Coke&r from the item output.
&e3.&r Pipe or bucket &6Creosote&r from the fluid output into a tank/barrel — do not let it void.",
		"",
		"&7Tip:&r Hopper coal in and coke out for a hands-free coke stack.",
		"",
		"&7Next:&r Craft Blast Bricks for the Crude Blast Furnace."
	]
	quest.B100000000000358.title: "Blast Bricks"
	quest.B100000000000358.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000358.quest_desc: [
		"&6Goal:&r Craft &627 Blast Bricks&r.",
		"",
		"Assemble a Crude Blast Furnace and hammer-form it to smelt iron + coke into steel.",
		"",
		"&6How:&r
&e1.&r Craft &627 Blast Bricks&r.
&e2.&r Build a solid &63×3×3&r cube of Blast Bricks (same shape as the Coke Oven).
&e3.&r Engineer's Hammer the &6center of a face&r to form the Crude Blast Furnace.
&e4.&r Later: upgrade bricks to &6Reinforced Blast Bricks&r for the Improved Blast Furnace (faster, keeps fuel).",
		"",
		"&7Tip:&r Keep coke and iron chests next to the GUI face before you start steel runs.",
		"",
		"&7Next:&r Smelt your first IE Steel batch."
	]
	quest.B100000000000359.title: "IE Steel"
	quest.B100000000000359.quest_subtitle: "Immersive Engineering · Steel"
	quest.B100000000000359.quest_desc: [
		"&6Goal:&r Produce &616 Steel Ingots&r via Immersive Engineering.",
		"",
		"Steel feeds Heavy Engineering blocks, steel scaffolding, HV components, and many multiblocks.",
		"",
		"&6How:&r
&e1.&r In the Blast Furnace GUI, add &6Iron Ingots&r and &6Coal Coke&r as fuel/input (JEI shows ratios).
&e2.&r Collect &6Steel Ingots&r and &6Slag&r from the outputs.
&e3.&r Hopper slag aside so it does not clog the item output.",
		"",
		"&7Tip:&r Improved Blast Furnace recycles coke better — upgrade when steel demand spikes.",
		"",
		"&7Next:&r Craft Light Engineering Blocks from components."
	]
	quest.B10000000000035A.title: "Light Engineering"
	quest.B10000000000035A.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035A.quest_desc: [
		"&6Goal:&r Craft &68 Light Engineering Blocks&r.",
		"",
		"Component blocks for mid-tier IE machines, workbenches, and many multiblock recipes.",
		"",
		"&6How:&r
&e1.&r Craft &6Iron Components&r / related parts (plates, copper) as JEI shows.
&e2.&r Assemble &6Light Engineering Blocks&r in batches of 8+.",
		"",
		"&7Tip:&r Create presses help plate spam if you already have a brass factory.",
		"",
		"&7Next:&r Heavy Engineering for crushers, diesel, and arc furnaces."
	]
	quest.B10000000000035B.title: "Heavy Engineering"
	quest.B10000000000035B.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035B.quest_desc: [
		"&6Goal:&r Craft &64 Heavy Engineering Blocks&r.",
		"",
		"Steel-tier component blocks for crushers, diesel generators, excavators, and arc furnaces.",
		"",
		"&6How:&r
&e1.&r Craft steel components / sheetmetal as required (JEI).
&e2.&r Assemble &6Heavy Engineering Blocks&r; store beside steel scaffolding.",
		"",
		"&7Tip:&r Keep steel sheetmetal and scaffolding in the same chest as these blocks.",
		"",
		"&7Next:&r Engineer's Workbench for blueprints, then wiring."
	]
	quest.B10000000000035C.title: "Engineer's Workbench"
	quest.B10000000000035C.quest_subtitle: "Immersive Engineering · Crafting"
	quest.B10000000000035C.quest_desc: [
		"&6Goal:&r Craft an Engineer's Workbench.",
		"",
		"Craft blueprints, schematics, and specialized IE recipes — electrodes and many tools start here.",
		"",
		"&6How:&r
&e1.&r Craft and place the &6Engineer's Workbench&r.
&e2.&r Insert a &6Blueprint&r (engineer's craft) and the listed materials to make blueprint items.
&e3.&r Use it for Graphite Electrodes and other schematic crafts before Arc Furnace work.",
		"",
		"&7Tip:&r The Automated Workbench later runs blueprint recipes hands-free.",
		"",
		"&7Next:&r LV Copper Coils to start the power grid."
	]
	quest.B10000000000035D.title: "LV Copper Coils"
	quest.B10000000000035D.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035D.quest_desc: [
		"&6Goal:&r Craft &616 LV Wire Coils&r.",
		"",
		"Spool copper coils between LV connectors to move Immersive Flux (IFE) across your workshop.",
		"",
		"&6How:&r
&e1.&r Craft &6Copper Wire&r then wind &6LV Wire Coils&r.
&e2.&r Hold a coil and right-click from one connector to another to string the wire.
&e3.&r Use &6Wire Cutters&r to remove bad links; add &6LV Relays&r to extend long runs.",
		"",
		"&7Tip:&r Do not mix LV coils onto MV/HV connectors — voltage tiers are separate.",
		"",
		"&7Next:&r Craft LV Wire Connectors to attach to machines."
	]
	quest.B10000000000035E.title: "LV Connectors"
	quest.B10000000000035E.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035E.quest_desc: [
		"&6Goal:&r Craft &68 LV Wire Connectors&r.",
		"",
		"Connectors attach to machines and capacitors — then you spool wire between them.",
		"",
		"&6How:&r
&e1.&r Place &6LV Wire Connectors&r on machine faces or capacitor sides that should receive/send power.
&e2.&r String &6LV Wire Coils&r connector-to-connector.
&e3.&r Add an &6LV Transformer&r (or MV/HV equivalents) when stepping between voltage tiers.",
		"",
		"&cCaution:&r Wrong-tier wire on a connector fails or wastes the coil — match LV/MV/HV.",
		"",
		"&7Tip:&r Capacitors in the middle of a run buffer brownouts from kinetic dynamos.",
		"",
		"&7Next:&r Craft an LV Accumulator for storage."
	]
	quest.B10000000000035F.title: "LV Accumulator"
	quest.B10000000000035F.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035F.quest_desc: [
		"&6Goal:&r Craft an LV Accumulator.",
		"",
		"Buffers IFE so waterwheels, windmills, and diesel generators do not brown out machines mid-craft.",
		"",
		"&6How:&r
&e1.&r Place the &6LV Accumulator&r near your machine cluster.
&e2.&r Put connectors on the capacitor and on machines; spool LV wire between them.
&e3.&r Feed power from a Kinetic Dynamo / Diesel Generator into the capacitor first, then out to loads.",
		"",
		"&7Tip:&r Upgrade to MV/HV capacitors as you climb wire tiers and Arc Furnace power draw.",
		"",
		"&7Next:&r Optional kinetic: Windmill — or Radiators toward diesel."
	]
	quest.B100000000000360.title: "Windmill"
	quest.B100000000000360.quest_subtitle: "Immersive Engineering · Kinetic"
	quest.B100000000000360.quest_desc: [
		"&6Goal:&r Craft a Windmill.",
		"",
		"Kinetic power from wind — attach sails and convert through a Kinetic Dynamo into IFE.",
		"",
		"&6How:&r
&e1.&r Place the &6Windmill&r high with clear air around the blades.
&e2.&r Craft &6Windmill Sails&r (hemp fabric) and right-click them onto the windmill hub.
&e3.&r Connect a &6Wooden Axle&r from the windmill into a &6Kinetic Dynamo&r.
&e4.&r Wire the dynamo with LV connectors/coils into your accumulator.",
		"",
		"&7Tip:&r More sails and higher placement improve capture; waterwheels are steadier if you have flowing water.",
		"",
		"&7Next:&r Radiator Blocks for Diesel Generator multiblocks."
	]
	quest.B100000000000361.title: "Radiator Block"
	quest.B100000000000361.quest_subtitle: "Immersive Engineering · Power"
	quest.B100000000000361.quest_desc: [
		"&6Goal:&r Craft &64 Radiator Blocks&r.",
		"",
		"Radiators appear in the Diesel Generator multiblock and other heat-heavy IE structures.",
		"",
		"&6How:&r
&e1.&r Craft &6Radiator Blocks&r from plate/copper recipes (JEI).
&e2.&r Open the Engineer's Manual Diesel Generator page and place Heavy Engineering, Radiators, and generators per the diagram.
&e3.&r Hammer-form the multiblock on the indicated block face.
&e4.&r Pipe &6Biodiesel&r (or diesel) into the fuel hatch; wire IFE out with MV-capable connectors.",
		"",
		"&7Tip:&r Refine biodiesel from ethanol + plant oil in IE fermenters/refineries before relying on diesel power.",
		"",
		"&7Next:&r Conveyors for machine I/O, then Graphite Electrodes for the Arc Furnace."
	]
	quest.B100000000000362.title: "IE Conveyors"
	quest.B100000000000362.quest_subtitle: "Immersive Engineering · Processing"
	quest.B100000000000362.quest_desc: [
		"&6Goal:&r Craft &616 Basic Conveyors&r.",
		"",
		"Move items into crushers, furnaces, and assemblers without Create belts if you prefer IE logistics.",
		"",
		"&6How:&r
&e1.&r Place conveyors in a line into machine input faces; sneak-place to change direction.
&e2.&r Use covered/vertical variants to climb into crusher or Arc Furnace inputs.
&e3.&r Drop items from hoppers onto belts, or pull from chests with conveyor variants that extract.",
		"",
		"&7Tip:&r Covered conveyors keep players and stray items from kicking stacks off the line.",
		"",
		"&7Next:&r Blueprint a Graphite Electrode for the Arc Furnace."
	]
	quest.B100000000000363.title: "Graphite Electrode"
	quest.B100000000000363.quest_subtitle: "Immersive Engineering · Endgame"
	quest.B100000000000363.quest_desc: [
		"&6Goal:&r Craft a Graphite Electrode.",
		"",
		"Electrodes fuel the Arc Furnace multiblock — IE's high-throughput alloying and smelting endgame.",
		"",
		"&6How:&r
&e1.&r At the Engineer's Workbench, use the electrode &6Blueprint&r with the listed materials to craft &6Graphite Electrodes&r.
&e2.&r Build the &6Arc Furnace&r from the Manual (refractory bricks, Heavy Engineering, electrodes on top).
&e3.&r Hammer-form the structure; insert electrodes into the electrode slots.
&e4.&r Feed IFE (HV recommended), ores/ingots on conveyors, and pull slag/metals from the outputs.",
		"",
		"&cCaution:&r Electrodes wear out — keep spares crafted or the furnace stops mid-run.",
		"",
		"&7Tip:&r Pair with a Crusher multiblock upstream for dust → Arc Furnace alloy lines.",
		"",
		"&7Next:&r Chapter complete — excavator and metal press await in the Manual when you need bulk ore."
	]
}
