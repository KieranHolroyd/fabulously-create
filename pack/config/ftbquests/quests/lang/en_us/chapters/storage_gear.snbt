	quest.B100000000000140.quest_subtitle: "Building"
	quest.B100000000000140.quest_desc: [
		"&6Goal:&r Craft the Copy-Paste Gadget.",
		"",
		"Save a structure and stamp it elsewhere — repeated factory modules become trivial."
	]
