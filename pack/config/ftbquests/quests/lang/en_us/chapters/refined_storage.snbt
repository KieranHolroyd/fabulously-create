{
	quest.B100000000000144.title: "Quartz-Enriched Iron"
	quest.B100000000000144.quest_subtitle: "Core"
	quest.B100000000000144.quest_desc: [
		"&6Goal:&r Craft &616 Quartz-Enriched Iron&r.",
		"",
		"This is Refined Storage's base material. Keep quartz, iron, redstone, and silicon processing close to your factory.",
		"",
		"&7Tip:&r Batch the processor ingredients now; every network device uses them.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Precision Mechanisms\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000E3\"}}"
	]
	quest.B100000000000145.title: "Network Controller"
	quest.B100000000000145.quest_subtitle: "Core"
	quest.B100000000000145.quest_desc: [
		"&6Goal:&r Craft and power a Refined Storage Controller.",
		"",
		"The Controller is the network heart. Feed it FE from a Create Crafts \\& Additions alternator, diesel setup, or another generator.",
		"",
		"&7Tip:&r A lit controller means the network has power; every connected device consumes some FE."
	]
	quest.B100000000000146.title: "Run the Network"
	quest.B100000000000146.quest_subtitle: "Core"
	quest.B100000000000146.quest_desc: [
		"&6Goal:&r Craft &632 Refined Storage cables&r.",
		"",
		"Cables join every RS device into one network. Route them behind walls and under Create machines for clean service corridors.",
		"",
		"&7Tip:&r Devices can touch directly; use cable only where you need distance."
	]
	quest.B100000000000147.title: "Disk Drive"
	quest.B100000000000147.quest_subtitle: "Items"
	quest.B100000000000147.quest_desc: [
		"&6Goal:&r Craft a Disk Drive and connect it to the Controller.",
		"",
		"A drive holds up to eight item or fluid disks. It provides bays, not capacity—the disks do that.",
		"",
		"&7Tip:&r Keep spare bays for fluid and Extra Disks upgrades."
	]
	quest.B100000000000148.title: "16K Item Disk"
	quest.B100000000000148.quest_subtitle: "Items"
	quest.B100000000000148.quest_desc: [
		"&6Goal:&r Craft a 16K Item Storage Disk and place it in the drive.",
		"",
		"Item disks store many item types without chest-slot juggling. Upgrade through 64K before entering addon capacities.",
		"",
		"&7Tip:&r Use a Disk Manipulator later to migrate contents between tiers safely."
	]
	quest.B100000000000149.title: "Storage Grid"
	quest.B100000000000149.quest_subtitle: "Access"
	quest.B100000000000149.quest_desc: [
		"&6Goal:&r Craft a Grid and connect it to the network.",
		"",
		"The Grid is the unified view of every disk and attached external inventory. Search, insert, and extract from one screen.",
		"",
		"&7Tip:&r Build the Crafting Grid next so stored ingredients are usable directly."
	]
	quest.B10000000000014A.title: "Crafting Grid + JEI"
	quest.B10000000000014A.quest_subtitle: "JEI addon"
	quest.B10000000000014A.quest_desc: [
		"&6Goal:&r Upgrade to a Crafting Grid.",
		"",
		"The official RS JEI integration lets JEI transfer recipe ingredients into this grid from network storage.",
		"",
		"&7Tip:&r Open a JEI recipe and press the transfer button; missing ingredients stay highlighted."
	]
	quest.B10000000000014B.title: "Fluid Storage"
	quest.B10000000000014B.quest_subtitle: "Fluids"
	quest.B10000000000014B.quest_desc: [
		"&6Goal:&r Craft a 4096B Fluid Storage Disk.",
		"",
		"RS 2 shows items and fluids in the same Grid. Insert filled containers, or move fluids with importers and exporters.",
		"",
		"&7Tip:&r One bucket equals one bucket of disk capacity; reserve space before automating bulk liquids."
	]
	quest.B10000000000014C.title: "Expose Create Storage"
	quest.B10000000000014C.quest_subtitle: "Create integration"
	quest.B10000000000014C.quest_desc: [
		"&6Goal:&r Craft &62 External Storage devices&r.",
		"",
		"Attach one to a Create Item Vault, Functional Storage controller, chest, or fluid tank so RS can use it without copying contents onto disks.",
		"",
		"&7Tip:&r Set priorities: high-priority drawers receive bulk items before general-purpose disks."
	]
	quest.B10000000000014D.title: "Import Factory Output"
	quest.B10000000000014D.quest_subtitle: "Create integration"
	quest.B10000000000014D.quest_desc: [
		"&6Goal:&r Craft &62 Importers&r.",
		"",
		"An Importer pulls items or fluids from an adjacent inventory or tank into RS—ideal on the output buffer of a Create processing line.",
		"",
		"&7Tip:&r Add speed and stack upgrades for high-throughput crushing or washing lines."
	]
	quest.B10000000000014E.title: "Export Ingredients"
	quest.B10000000000014E.quest_subtitle: "Create integration"
	quest.B10000000000014E.quest_desc: [
		"&6Goal:&r Craft &62 Exporters&r.",
		"",
		"An Exporter keeps selected items or fluids supplied to an adjacent machine, basin buffer, deployer chest, or Create tank.",
		"",
		"&7Tip:&r Use regulator upgrades when a machine should hold an exact stock instead of being flooded."
	]
	quest.B10000000000014F.title: "Factory Interface"
	quest.B10000000000014F.quest_subtitle: "Outside automation"
	quest.B10000000000014F.quest_desc: [
		"&6Goal:&r Craft &62 Interfaces&r.",
		"",
		"Interfaces expose filtered stock to outside automation. Create funnels, chutes, arms, belts, and Pipez can interact with their slots.",
		"",
		"&7Tip:&r Use interfaces as clean hand-off points between the digital network and physical factory logistics."
	]
	quest.B100000000000150.title: "Pattern Grid"
	quest.B100000000000150.quest_subtitle: "Autocrafting"
	quest.B100000000000150.quest_desc: [
		"&6Goal:&r Craft a Pattern Grid.",
		"",
		"Encode crafting recipes and processing recipes onto patterns. Processing patterns describe inputs sent out and outputs expected back.",
		"",
		"&7Tip:&r Use processing patterns for Create crushing, mixing, pressing, deploying, and sequenced assembly."
	]
	quest.B100000000000151.title: "Encode Patterns"
	quest.B100000000000151.quest_subtitle: "Autocrafting"
	quest.B100000000000151.quest_desc: [
		"&6Goal:&r Craft &68 blank Patterns&r and encode useful recipes.",
		"",
		"Start with common components, then encode Create processes. Put crafting patterns and processing patterns into the right autocrafters.",
		"",
		"&7Tip:&r Test one processing step before chaining a long production request."
	]
	quest.B100000000000152.title: "Autocrafter"
	quest.B100000000000152.quest_subtitle: "Autocrafting"
	quest.B100000000000152.quest_desc: [
		"&6Goal:&r Craft &62 Autocrafters&r.",
		"",
		"Autocrafters execute patterns. Point processing outputs toward an Interface so RS can detect returned products and finish the job.",
		"",
		"&7Tip:&r The Autocrafter Manager helps organize large walls of patterns."
	]
	quest.B100000000000153.title: "Wireless Transmitter"
	quest.B100000000000153.quest_subtitle: "Wireless"
	quest.B100000000000153.quest_desc: [
		"&6Goal:&r Craft a Wireless Transmitter.",
		"",
		"Connect it to the network and install range upgrades to reach across your base.",
		"",
		"&7Tip:&r Wireless access still consumes network power and has a configured range."
	]
	quest.B100000000000154.title: "Wireless Grid + Curios"
	quest.B100000000000154.quest_subtitle: "Curios addon"
	quest.B100000000000154.quest_desc: [
		"&6Goal:&r Craft and link a Wireless Grid.",
		"",
		"The official Curios integration adds dedicated RS slots, letting a linked portable or wireless grid travel equipped outside your inventory.",
		"",
		"&7Tip:&r Use the linking tool on the network, charge the grid, then equip it in its Curios slot."
	]
	quest.B100000000000155.title: "Extra Disks: 1024K"
	quest.B100000000000155.quest_subtitle: "Extra Disks addon"
	quest.B100000000000155.quest_desc: [
		"&6Goal:&r Craft a 1024K Item Storage Disk from Extra Disks.",
		"",
		"Extra Disks extends RS with enormous item and fluid tiers for mature factories. Upgrade gradually instead of crafting infinite storage early.",
		"",
		"&7Tip:&r Withering processors gate the highest tiers behind Nether progression."
	]
	quest.B100000000000156.title: "Advanced Importer"
	quest.B100000000000156.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000156.quest_desc: [
		"&6Goal:&r Craft an ExtraStorage Advanced Importer.",
		"",
		"Its larger filter and higher throughput suit multi-output Create farms and processing arrays.",
		"",
		"&7Tip:&r Filter explicitly so valuable outputs never loop back into the wrong line."
	]
	quest.B100000000000157.title: "Advanced Exporter"
	quest.B100000000000157.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000157.quest_desc: [
		"&6Goal:&r Craft an ExtraStorage Advanced Exporter.",
		"",
		"Use the expanded filter to stock several ingredients at a shared factory input buffer.",
		"",
		"&7Tip:&r Pair it with a Create belt or mechanical arm to distribute ingredients physically."
	]
	quest.B100000000000158.title: "Netherite Crafter"
	quest.B100000000000158.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000158.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's Netherite Crafter.",
		"",
		"This top-tier crafter holds more patterns and processes requests faster—ideal for a dense late-game pattern hall.",
		"",
		"&7Tip:&r Spread processing recipes across crafters when several Create lines can run in parallel."
	]
	quest.B100000000000159.title: "Million-Bucket Fluid Disk"
	quest.B100000000000159.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000159.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's 1,048,576B Fluid Storage Disk.",
		"",
		"Use this endgame tank for diesel products, liquid experience, chocolate, honey, lava, or any other factory-scale fluid.",
		"",
		"&7Tip:&r External Storage is still better when you want the fluid visibly stored in Create tanks."
	]
}
