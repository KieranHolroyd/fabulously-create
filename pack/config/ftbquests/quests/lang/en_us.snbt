{
	file.0000000000000001.title: "Fabulously Create"
	chapter_group.A100000000000001.title: "Main Progression"
	chapter.A200000000000001.title: "1. Getting Started"
	chapter.A200000000000001.chapter_subtitle: ["Wood, iron, food, Waystones — leave the caves ready"]
	chapter.A200000000000002.title: "2. Turning Gears"
	chapter.A200000000000002.chapter_subtitle: ["Andesite → brass → drills, trains, and power"]
	chapter.A200000000000003.title: "3. Bags \\& Blades"
	chapter.A200000000000003.chapter_subtitle: ["Backpacks, drawers, pipes, Silent Gear, building tools"]
	chapter.A200000000000004.title: "4. Wires \\& Wits"
	chapter.A200000000000004.chapter_subtitle: ["ID networks, diesel, FE, and factory enchanting"]
	chapter.A200000000000006.title: "5. Refined Storage"
	chapter.A200000000000006.chapter_subtitle: ["Digital item and fluid storage, Create integration, and autocrafting"]
	chapter.A200000000000007.title: "6. Powah"
	chapter.A200000000000007.chapter_subtitle: ["FE generation, energizing tiers, reactors, and wireless charging"]
	chapter.A200000000000008.title: "7. RFTools"
	chapter.A200000000000008.chapter_subtitle: ["Power, automation, storage scanning, teleportation, and dimensions"]
	chapter.A200000000000009.title: "8. Flux Networks"
	chapter.A200000000000009.chapter_subtitle: ["Cross-dimensional wireless FE transfer, control, and storage"]
	chapter.A20000000000000A.title: "9. Mekanism"
	chapter.A20000000000000A.chapter_subtitle: ["Steel casings, ore processing, gases, factories, and QIO"]
	chapter.A20000000000000B.title: "10. Mekanism Reactors"
	chapter.A20000000000000B.chapter_subtitle: ["Heat, solar, wind, fission, turbines, and fusion power"]
	chapter.A20000000000000C.title: "11. Extreme Reactors"
	chapter.A20000000000000C.chapter_subtitle: ["Yellorium reactors, steam turbines, and fuel reprocessing"]
	chapter.A20000000000000D.title: "12. Modern Industrialization"
	chapter.A20000000000000D.chapter_subtitle: ["Steam age, steel, circuits, electric machines, and quarries"]
	chapter.A20000000000000E.title: "13. Industrial Foregoing"
	chapter.A20000000000000E.chapter_subtitle: ["Latex, plastic, farms, mob slaughter, lasers, and infinity tools"]
	chapter.A20000000000000F.title: "14. Immersive Engineering"
	chapter.A20000000000000F.chapter_subtitle: ["Coke ovens, blast furnaces, wires, diesel, and arc furnaces"]
	chapter.A200000000000005.title: "15. Beyond Brass"
	chapter.A200000000000005.chapter_subtitle: ["Netherite, flight, railways, bosses, and the sky"]
	quest.B100000000000064.title: "Welcome to Fabulously Create"
	quest.B100000000000064.quest_subtitle: "Start here"
	quest.B100000000000064.quest_desc: [
		"This pack is about &6Create factories&r, smarter storage, Silent Gear tools, Integrated Dynamics logistics, and late-game flight. Quests complete when items are in your inventory — they are &anot consumed&r. Optional quests are dashed outlines; skip them anytime.",
		"",
		"&6You will:&r\n&e•&r Follow dependency lines — chapters chain (iron → Create → brass → automation → netherite)\n&e•&r Claim rewards from completed quests\n&e•&r Use JEI (R) on any unfamiliar item",
		"",
		"&7Tip:&r Side paths unlock as you progress. Start with wood, stone, and iron, then plant a Waystone before you dig deep."
	]
	quest.B100000000000065.title: "Timber!"
	quest.B100000000000065.quest_subtitle: "Gathering"
	quest.B100000000000065.quest_desc: [
		"&6Goal:&r Collect &616 oak logs&r.",
		"",
		"Wood is your first building block: crafting tables, charcoal, Create casings, and early chests all burn through logs.",
		"",
		"&6How:&r\n&e1.&r Punch or axe nearby trees until you have 16 oak logs in inventory.\n&e2.&r Keep a few extras for a crafting table and sticks.\n&e3.&r Plant saplings near your spawn so the next harvest is closer.",
		"",
		"&7Tip:&r Any wood works for most recipes — explore once you have iron.",
		"",
		"&7Next:&r Craft a workbench, then start a stone stockpile."
	]
	quest.B100000000000066.title: "Workbench"
	quest.B100000000000066.quest_subtitle: "Gathering"
	quest.B100000000000066.quest_desc: [
		"&6Goal:&r Craft a crafting table.",
		"",
		"Early recipes still start here. Create automates later — until then, a bench (or Crafting on a Stick) is your workshop.",
		"",
		"&6How:&r\n&e1.&r Craft planks from 1 log (4 planks).\n&e2.&r Arrange 4 planks in a 2×2 to make a crafting table.\n&e3.&r Place it somewhere easy to reach and open it to unlock the 3×3 grid.",
		"",
		"&7Next:&r Mine cobble for furnaces and generators."
	]
	quest.B100000000000067.title: "Stone Stockpile"
	quest.B100000000000067.quest_subtitle: "Gathering"
	quest.B100000000000067.quest_desc: [
		"&6Goal:&r Mine &664 cobblestone&r.",
		"",
		"Stone feeds furnaces, cobble gens, Create casings, and endless scaffolding. Grab more than feels polite.",
		"",
		"&6How:&r\n&e1.&r Craft a wooden pickaxe, then mine 3 cobble for a stone pickaxe.\n&e2.&r Dig a starter mine or quarry a hillside until you hold 64 cobble.\n&e3.&r Stash extras in a chest — you will spend stacks on furnaces and Create.",
		"",
		"&7Tip:&r A stone pickaxe unlocks iron ore. Don't dig straight down.",
		"",
		"&7Next:&r Smelt a furnace, then hunt iron."
	]
	quest.B100000000000068.title: "First Fire"
	quest.B100000000000068.quest_subtitle: "Smelting"
	quest.B100000000000068.quest_desc: [
		"&6Goal:&r Craft a furnace.",
		"",
		"Smelting unlocks metals. Coal is ideal; charcoal from logs works if caves are stingy.",
		"",
		"&6How:&r\n&e1.&r Surround the crafting grid edges with 8 cobblestone (leave the center empty).\n&e2.&r Place the furnace and put fuel in the bottom slot (coal or charcoal).\n&e3.&r Smelt a few logs into charcoal if you still need fuel for iron.",
		"",
		"&7Next:&r Smelt a stack of iron — Create starts there."
	]
	quest.B100000000000069.title: "Fuel Reserve"
	quest.B100000000000069.quest_subtitle: "Fuel"
	quest.B100000000000069.quest_desc: [
		"&6Goal:&r Stockpile &632 coal&r.",
		"",
		"Furnaces, Iron Furnaces, blaze burners (later), and long mining trips all want fuel on hand.",
		"",
		"&6How:&r\n&e1.&r Mine coal ore in caves (Y levels vary — check exposed cliffs too).\n&e2.&r Collect until you have 32 coal (or smelt coal ore if needed).\n&e3.&r Optional: craft coal blocks to compress storage for later trips.",
		"",
		"&7Tip:&r Charcoal works in furnaces too, but this quest wants coal ore/smelted coal."
	]
	quest.B10000000000006A.title: "Iron Stockpile"
	quest.B10000000000006A.quest_subtitle: "Iron"
	quest.B10000000000006A.quest_desc: [
		"&6Goal:&r Smelt &632 iron ingots&r.",
		"",
		"Iron is the pack's first real gate: Create andesite alloy, Pipez, Iron Chests/Furnaces, Construction Sticks, and more.",
		"",
		"&6How:&r\n&e1.&r Mine iron ore with a stone (or better) pickaxe — bring torches and food.\n&e2.&r Smelt raw iron / ore in your furnace until you have 32 ingots.\n&e3.&r Stash a chest of extras; Turning Gears and Bags \\& Blades both spend iron fast.",
		"",
		"&7Tip:&r FTB Ultimine (hold Grave / ` by default) clears connected ore fast when you hit a Large Ore Vein.",
		"",
		"&7Next:&r Make an iron pickaxe, then set a Waystone before deep caves."
	]
	quest.B10000000000006B.title: "Iron Tools"
	quest.B10000000000006B.quest_subtitle: "Iron"
	quest.B10000000000006B.quest_desc: [
		"&6Goal:&r Craft an iron pickaxe.",
		"",
		"Diamonds and Create's deeper ores wait below. Bring food, torches, and a way home.",
		"",
		"&6How:&r\n&e1.&r Craft sticks if needed (2 planks → 4 sticks).\n&e2.&r Craft an iron pickaxe: 3 iron ingots across the top, 2 sticks down the middle.\n&e3.&r Optional: craft a shield and sword before your first deep trip.",
		"",
		"&7Next:&r Find diamonds, then plant a Waystone at base."
	]
	quest.B10000000000006C.title: "Copper Cache"
	quest.B10000000000006C.quest_subtitle: "Metals"
	quest.B10000000000006C.quest_desc: [
		"&6Goal:&r Smelt &632 copper ingots&r.",
		"",
		"Copper becomes Create fluid pipes, backtanks, and brass (with zinc). Large copper veins are common — fill a chest.",
		"",
		"&6How:&r\n&e1.&r Mine copper ore (often in large blobs near stone / deepslate).\n&e2.&r Smelt until you hold 32 copper ingots.\n&e3.&r Keep a dedicated chest — fluid tanks and brass will empty it later.",
		"",
		"&7Tip:&r JEI: look ahead at brass and fluid tanks so you know why you're hoarding."
	]
	quest.B10000000000006D.title: "Sparkly Rocks"
	quest.B10000000000006D.quest_subtitle: "Diamonds"
	quest.B10000000000006D.quest_desc: [
		"&6Goal:&r Find &65 diamonds&r.",
		"",
		"Save some for a pickaxe and enchanting. Create's midgame wants &6brass and precision mechanisms&r more than full diamond armor.",
		"",
		"&6How:&r\n&e1.&r Mine around deepslate levels with your iron pickaxe and plenty of torches.\n&e2.&r Collect 5 diamonds (ores or loot — Lootr chests are per-player).\n&e3.&r Craft a diamond pickaxe when ready; bank extras for enchanting later.",
		"",
		"&7Tip:&r Silent Gear can stretch materials further once you unlock blueprints."
	]
	quest.B10000000000006E.title: "Set a Waystone"
	quest.B10000000000006E.quest_subtitle: "Travel"
	quest.B10000000000006E.quest_desc: [
		"&6Goal:&r Craft and place a Waystone near your base.",
		"",
		"Warp home after every mining trip. Deaths hurt less with a recall point — especially once you hit the Nether for blaze burners.",
		"",
		"&6How:&r\n&e1.&r Craft a Waystone (check JEI for the recipe — usually stone + obsidian + pearls / nebula).\n&e2.&r Place it at your base entrance and activate / name it.\n&e3.&r Carry a Warp Stone for temporary links while exploring.",
		"",
		"&7Tip:&r Warp Stones make temporary links while exploring. Sharestones help multiplayer bases.",
		"",
		"&7Next:&r You're ready for Turning Gears — or finish the food/QoL side path first."
	]
	quest.B10000000000006F.title: "Carb Loading"
	quest.B10000000000006F.quest_subtitle: "Food"
	quest.B10000000000006F.quest_desc: [
		"&6Goal:&r Bake &616 bread&r.",
		"",
		"Hunger kills more early bases than creepers. Keep a stack for every cave run.",
		"",
		"&6How:&r\n&e1.&r Plant wheat seeds on tilled hydrated farmland near water.\n&e2.&r Harvest wheat and craft bread (3 wheat in a row → 1 bread).\n&e3.&r Bake until you hold 16 bread; keep a stack in your hotbar."
	]
	quest.B100000000000070.title: "Cooking Pot"
	quest.B100000000000070.quest_subtitle: "Food"
	quest.B100000000000070.quest_desc: [
		"&6Goal:&r Craft a Farmer's Delight cooking pot.",
		"",
		"Meals beat plain steaks for saturation. Pair with a cutting board and stove for a proper kitchen.",
		"",
		"&6How:&r\n&e1.&r Gather brick / iron / wood as shown in JEI for the cooking pot.\n&e2.&r Craft the pot and place it above a heat source (campfire or stove).\n&e3.&r Add a bowl + ingredients to cook your first meal.",
		"",
		"&7Tip:&r Later, Slice \\& Dice lets Create automate cutting boards — see Wires \\& Wits.",
		"",
		"&7Next:&r Add a stove and knife when you're settled."
	]
	quest.B100000000000071.title: "Farmer's Kitchen"
	quest.B100000000000071.quest_subtitle: "Food"
	quest.B100000000000071.quest_desc: [
		"&6Goal:&r Craft a Farmer's Delight stove.",
		"",
		"The stove is the heart of meal cooking — fire it up next to your cooking pot.",
		"",
		"&6How:&r\n&e1.&r Craft the stove (JEI) and place it as a solid heat block.\n&e2.&r Put your cooking pot on top (or beside, per recipe needs).\n&e3.&r Keep fuel / fire going while you cook multi-ingredient meals."
	]
	quest.B100000000000072.title: "Kitchen Knife"
	quest.B100000000000072.quest_subtitle: "Food"
	quest.B100000000000072.quest_desc: [
		"&6Goal:&r Craft an iron knife.",
		"",
		"Knives process meats and plants on a cutting board — required for many Delight recipes.",
		"",
		"&6How:&r\n&e1.&r Craft an iron knife (iron + stick pattern in JEI).\n&e2.&r Place a cutting board on a counter.\n&e3.&r Hold the knife and right-click ingredients on the board to process them."
	]
	quest.B100000000000073.title: "Portable Bed"
	quest.B100000000000073.quest_subtitle: "QoL"
	quest.B100000000000073.quest_desc: [
		"&6Goal:&r Craft a sleeping bag.",
		"",
		"Unlike beds, it &adoesn't set your respawn&r — perfect for Nether trips and caves without wrecking your Waystone home.",
		"",
		"&6How:&r\n&e1.&r Gather wool (dye optional — red is the checklist color).\n&e2.&r Craft a sleeping bag from JEI.\n&e3.&r Use it to skip night or rest in dangerous dimensions without moving your spawn."
	]
	quest.B100000000000074.title: "Crafting on a Stick"
	quest.B100000000000074.quest_subtitle: "QoL"
	quest.B100000000000074.quest_desc: [
		"&6Goal:&r Craft a crafting table on a stick.",
		"",
		"Portable crafting from your hotbar — huge quality-of-life while strip-mining or wiring factories.",
		"",
		"&6How:&r\n&e1.&r Craft the crafting-table-on-a-stick (crafting table + stick per JEI).\n&e2.&r Put it on your hotbar and right-click to open a 3×3 anywhere.\n&e3.&r Optional: craft sticks for smithing, stonecutter, and grindstone too.",
		"",
		"&7Tip:&r There are sticks for smithing, stonecutter, grindstone, and more."
	]
	quest.B100000000000075.title: "Iron Chest"
	quest.B100000000000075.quest_subtitle: "Storage"
	quest.B100000000000075.quest_desc: [
		"&6Goal:&r Upgrade to an Iron Chest.",
		"",
		"More slots than wood. Keep upgrading toward gold / diamond / obsidian as junk piles grow.",
		"",
		"&6How:&r\n&e1.&r Place a wooden chest (or craft a new iron chest from JEI).\n&e2.&r Craft the iron chest upgrade materials and apply / craft the Iron Chest.\n&e3.&r Move your starter junk into it — leave room for Create alloys later.",
		"",
		"&7Next:&r Iron Furnaces speed smelting while you prep Create."
	]
	quest.B100000000000076.title: "Iron Furnace"
	quest.B100000000000076.quest_subtitle: "Smelting"
	quest.B100000000000076.quest_desc: [
		"&6Goal:&r Craft an Iron Furnace.",
		"",
		"Faster smelting now; gold and diamond tiers wait until throughput really matters.",
		"",
		"&6How:&r\n&e1.&r Craft an Iron Furnace (upgrade path from a stone furnace — check JEI).\n&e2.&r Place it and move your fuel + ore line over.\n&e3.&r Feed it continuously while you mine copper and prep Andesite Alloy."
	]
	quest.B100000000000077.title: "Nature's Compass"
	quest.B100000000000077.quest_subtitle: "Exploration"
	quest.B100000000000077.quest_desc: [
		"&6Goal:&r Craft a Nature's Compass.",
		"",
		"Hunt biomes for crops, building vibes, or menril-friendly areas before Integrated Dynamics.",
		"",
		"&6How:&r\n&e1.&r Craft Nature's Compass from JEI.\n&e2.&r Right-click, pick a biome, and follow the pointer.\n&e3.&r Mark good farm / menril spots with a Waystone or map."
	]
	quest.B100000000000078.title: "Explorer's Compass"
	quest.B100000000000078.quest_subtitle: "Exploration"
	quest.B100000000000078.quest_desc: [
		"&6Goal:&r Craft an Explorer's Compass.",
		"",
		"Locate structures for loot. Reminder: &6Lootr&r makes structure chests per-player — no racing friends.",
		"",
		"&6How:&r\n&e1.&r Craft Explorer's Compass from JEI.\n&e2.&r Select a structure type and travel toward the marker.\n&e3.&r Loot freely — each player gets their own chest contents."
	]
	quest.B100000000000079.title: "Supplementaries Wrench"
	quest.B100000000000079.quest_subtitle: "Building"
	quest.B100000000000079.quest_desc: [
		"&6Goal:&r Craft a Supplementaries wrench.",
		"",
		"Rotate and tweak functional décor — faucets, turn tables, and more. Great alongside Create's own wrench.",
		"",
		"&6How:&r\n&e1.&r Craft the Supplementaries wrench (JEI).\n&e2.&r Right-click functional blocks to rotate / configure them.\n&e3.&r Keep Create's wrench too — each mod touches different blocks."
	]
	quest.B10000000000007A.title: "Furnish the Base"
	quest.B10000000000007A.quest_subtitle: "Building"
	quest.B10000000000007A.quest_desc: [
		"&6Goal:&r Craft an oak chair (Another Furniture).",
		"",
		"Optional décor goal — make the base feel lived-in before the factory takes over every block.",
		"",
		"&6How:&r\n&e1.&r Craft an oak chair from JEI.\n&e2.&r Place seating near your crafting / kitchen area.\n&e3.&r Add a table if you want the base to feel finished."
	]
	quest.B10000000000007B.title: "Leather Bundle"
	quest.B10000000000007B.quest_subtitle: "Gathering"
	quest.B10000000000007B.quest_desc: [
		"&6Goal:&r Collect &616 leather&r.",
		"",
		"Backpacks, books, and early armor all want leather. Breed cows or hunt while exploring.",
		"",
		"&6How:&r\n&e1.&r Hunt cows / horses, or start a small cow pen with wheat.\n&e2.&r Collect 16 leather (or craft from rabbit hide if needed).\n&e3.&r Save it for a Sophisticated Backpack in Bags \\& Blades.",
		"",
		"&7Next:&r Bags \\& Blades opens with a Sophisticated Backpack."
	]
	quest.B1000000000000C8.title: "Andesite Alloy"
	quest.B1000000000000C8.quest_subtitle: "Create basics"
	quest.B1000000000000C8.quest_desc: [
		"Create's basic component. Everything kinetic — shafts, cogs, casings, presses — starts with andesite alloy.",
		"",
		"&6You will:&r\n&e•&r Craft 32 andesite alloy (andesite + iron nuggets, or bulk-mix later)\n&e•&r Hand-crank early machines, then graduate to water wheels\n&e•&r Build a press → mixer → crushing → brass line",
		"",
		"&7Tip:&r Stockpile alloy now — every casing and cog spends it.",
		"",
		"&6Goal:&r Craft &632 Andesite Alloy&r.",
		"",
		"Every shaft, cogwheel, casing, and press recipe spends alloy. A 32-stack is the minimum starter kit.",
		"",
		"&6How:&r\n&e1.&r Mine &6andesite&r and smelt iron into &eingots/nuggets&r.\n&e2.&r Craft alloy in a crafting table (andesite + iron nuggets) — JEI shows the exact shape.\n&e3.&r Later, bulk-mix andesite with iron nuggets in a basin under a Mechanical Mixer for mass production.",
		"",
		"&7Tip:&r Keep a chest of alloy next to your first kinetic line.",
		"",
		"&7Next:&r Hand crank a millstone or press to prove the network works.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B1000000000000C9.title: "Hand Crank"
	quest.B1000000000000C9.quest_subtitle: "Kinetics"
	quest.B1000000000000C9.quest_desc: [
		"&6Goal:&r Craft a hand crank.",
		"",
		"Manually spin early machines before water wheels. Great for testing a press or millstone setup.",
		"",
		"&6How:&r\n&e1.&r Craft a hand crank from andesite alloy (JEI).\n&e2.&r Place it on the end of a shaft connected to a machine.\n&e3.&r Hold right-click to spin — watch the stressometer overlay (goggles help).",
		"",
		"&7Tip:&r Use the crank only to prove a machine works; swap to a water wheel next.",
		"",
		"&7Next:&r Lay shafts so rotation can travel across your workshop."
	]
	quest.B1000000000000CA.title: "Shafts"
	quest.B1000000000000CA.quest_subtitle: "Kinetics"
	quest.B1000000000000CA.quest_desc: [
		"&6Goal:&r Craft &616 shafts&r.",
		"",
		"Shafts carry rotation in a straight line — the backbone of every kinetic network.",
		"",
		"&6How:&r\n&e1.&r Craft 16 shafts from andesite alloy.\n&e2.&r Place a shaft on your hand crank (or water wheel) output.\n&e3.&r Extend the line: hold a shaft and look at another shaft to place long runs.\n&e4.&r Use a Create wrench to reverse rotation direction when a machine spins the wrong way.",
		"",
		"&7Tip:&r Overstressed networks stop — add power or cut machines until SU balances."
	]
	quest.B1000000000000CB.title: "Cogwheels"
	quest.B1000000000000CB.quest_subtitle: "Kinetics"
	quest.B1000000000000CB.quest_desc: [
		"&6Goal:&r Craft &616 cogwheels&r.",
		"",
		"Small cogs turn corners and change shaft axis — the elbows of your kinetic network.",
		"",
		"&6How:&r\n&e1.&r Craft 16 cogwheels (andesite alloy + planks).\n&e2.&r Place a cog on the side of a shaft to branch rotation 90°.\n&e3.&r Mesh two cogs to transfer power between parallel shafts.\n&e4.&r Encasing a cog with andesite casing stops sideways interlocking when you need a clean run.",
		"",
		"&7Tip:&r Cogs also act as belt pulleys later — keep extras."
	]
	quest.B1000000000000CC.title: "Large Cogwheels"
	quest.B1000000000000CC.quest_subtitle: "Kinetics"
	quest.B1000000000000CC.quest_desc: [
		"&6Goal:&r Craft &68 large cogwheels&r.",
		"",
		"Pair large + small for gear ratios — speed up or slow down machines (stress changes too).",
		"",
		"&6How:&r\n&e1.&r Craft 8 large cogwheels.\n&e2.&r Mesh a large cog with a small cog: driving the large slows the small side; driving the small speeds the large side.\n&e3.&r Use slow shafts for high-stress machines (crushing, presses) and fast shafts for belts / fans.\n&e4.&r Check the stress overlay after each ratio change.",
		"",
		"&7Tip:&r If a machine needs more torque, gear down; if belts crawl, gear up."
	]
	quest.B1000000000000CD.title: "Water Power"
	quest.B1000000000000CD.quest_subtitle: "Power"
	quest.B1000000000000CD.quest_desc: [
		"&6Goal:&r Craft a water wheel.",
		"",
		"Flowing water against the blades generates free SU (stress units). One or two wheels power a whole andesite workshop.",
		"",
		"&6How:&r\n&e1.&r Craft a water wheel and place it with space for water on both faces.\n&e2.&r Place water source blocks so water flows across the wheel blades (not still water).\n&e3.&r Attach a shaft to the wheel hub and run it into your workshop.\n&e4.&r Add a second wheel or large water wheel when stress capacity runs out.",
		"",
		"&7Tip:&r Later you'll want steam engines, diesel, or electricity for megabases.",
		"",
		"&7Next:&r Build andesite casings into a press + mixer line."
	]
	quest.B1000000000000CE.title: "Windmill Bearing"
	quest.B1000000000000CE.quest_subtitle: "Power"
	quest.B1000000000000CE.quest_desc: [
		"&6Goal:&r Craft a windmill bearing.",
		"",
		"Sail-powered SU when you have space for a big windmill — optional alternative to water wheels.",
		"",
		"&6How:&r\n&e1.&r Craft a windmill bearing and place it facing open sky / wind.\n&e2.&r Build a sail structure (wool sails on a rotatable frame) attached to the bearing.\n&e3.&r Assemble / start the bearing so the windmill spins and outputs rotation.\n&e4.&r Connect a shaft from the bearing into your kinetic network.",
		"",
		"&7Tip:&r Bigger sail area = more SU. Keep the rotor clear of buildings."
	]
	quest.B1000000000000CF.title: "Andesite Casing"
	quest.B1000000000000CF.quest_subtitle: "Machines"
	quest.B1000000000000CF.quest_desc: [
		"&6Goal:&r Craft &616 andesite casings&r.",
		"",
		"Stripped logs + andesite alloy. Almost every andesite machine is built on casing.",
		"",
		"&6How:&r\n&e1.&r Strip logs with an axe (right-click) for stripped wood.\n&e2.&r Craft casings: stripped log + andesite alloy (or apply alloy to stripped logs in-world).\n&e3.&r Stock 16+ — press, mixer, saw, fan, and gearbox recipes all spend them.",
		"",
		"&7Tip:&r A mechanical saw later makes plank/casing spam trivial."
	]
	quest.B1000000000000D0.title: "Mechanical Press"
	quest.B1000000000000D0.quest_subtitle: "Machines"
	quest.B1000000000000D0.quest_desc: [
		"&6Goal:&r Build a Mechanical Press.",
		"",
		"Presses compact plates, smash items on a depot, and unlock sheet metal for pipes and casings.",
		"",
		"&6How:&r\n&e1.&r Craft a Mechanical Press and place it with clearance underneath.\n&e2.&r Power the press from the side with a shaft / cog from your water wheel.\n&e3.&r Put a depot (or basin) under the press head.\n&e4.&r Drop iron ingots on the depot — the press stamps them into iron sheets.",
		"",
		"&7Tip:&r Sheets unlock fluid tanks, pipes, and many Create recipes — press a stack.",
		"",
		"&7Next:&r Add a basin under mixers/presses for bulk crafting."
	]
	quest.B1000000000000D1.title: "Basin"
	quest.B1000000000000D1.quest_subtitle: "Machines"
	quest.B1000000000000D1.quest_desc: [
		"&6Goal:&r Craft a Basin.",
		"",
		"Mixers, presses, and bulk crafting use basins — dough, alloys, concrete, brass later with heat.",
		"",
		"&6How:&r\n&e1.&r Craft a basin and place it on the ground (or on a depot-style spot under a machine).\n&e2.&r Leave one block of air above for a mixer or press head.\n&e3.&r Toss ingredients into the basin (or funnel them in once you have belts).\n&e4.&r Outputs can be pulled with funnels on the sides once logistics exist.",
		"",
		"&7Tip:&r Basins hold both items and fluids — keep a spare for chocolate / dough later."
	]
	quest.B1000000000000D2.title: "Mechanical Mixer"
	quest.B1000000000000D2.quest_subtitle: "Machines"
	quest.B1000000000000D2.quest_desc: [
		"&6Goal:&r Build a Mechanical Mixer above a basin.",
		"",
		"Bulk-craft andesite alloy, dough, and (with a blaze burner) brass. Automate inputs with funnels once belts exist.",
		"",
		"&6How:&r\n&e1.&r Place a basin, then place the Mechanical Mixer in the block above it.\n&e2.&r Power the mixer from the side (shaft/cog).\n&e3.&r Drop andesite + iron nuggets into the basin — watch them bulk-mix into alloy.\n&e4.&r Later: put a blaze burner under the basin for heated mixes (brass).",
		"",
		"&7Tip:&r JEI shows which mixes need heat — no burner means no brass."
	]
	quest.B1000000000000D3.title: "Millstone"
	quest.B1000000000000D3.quest_subtitle: "Machines"
	quest.B1000000000000D3.quest_desc: [
		"&6Goal:&r Build a Millstone.",
		"",
		"Mill wheat into flour and process early bulk goods with low stress cost.",
		"",
		"&6How:&r\n&e1.&r Craft and place a millstone.\n&e2.&r Power it from the side with a shaft.\n&e3.&r Drop wheat on top (or funnel in) to mill flour.\n&e4.&r Collect outputs from the bottom / sides for dough mixes."
	]
	quest.B1000000000000D4.title: "Mechanical Saw"
	quest.B1000000000000D4.quest_subtitle: "Machines"
	quest.B1000000000000D4.quest_desc: [
		"&6Goal:&r Build a Mechanical Saw.",
		"",
		"Auto-cut logs into planks and process wood at factory scale — huge for casing spam.",
		"",
		"&6How:&r\n&e1.&r Craft a Mechanical Saw and place it facing a processing spot.\n&e2.&r Power it; drop logs onto a depot/belt in front of the blade.\n&e3.&r Collect planks — feed stripped wood + alloy into more casings.\n&e4.&r Optional: mount a saw on a contraption for tree farms later."
	]
	quest.B1000000000000D5.title: "Encased Fan"
	quest.B1000000000000D5.quest_subtitle: "Machines"
	quest.B1000000000000D5.quest_desc: [
		"&6Goal:&r Build an Encased Fan.",
		"",
		"Fans blast items through processing paths — smoking, blasting, washing, and haunting.",
		"",
		"&6How:&r\n&e1.&r Craft an Encased Fan and power it so air blows forward.\n&e2.&r Build a short tunnel of passable blocks in front of the fan.\n&e3.&r For washing: place water in the path and drop gravel / crushed ore through it for nuggets.\n&e4.&r For smoking/blasting: put fire / lava in the path (careful with lava). Haunting uses soul fire.",
		"",
		"&7Tip:&r Washing crushed ores after crushing wheels is a massive early ore multiplier."
	]
	quest.B1000000000000D6.title: "Belts"
	quest.B1000000000000D6.quest_subtitle: "Logistics"
	quest.B1000000000000D6.quest_desc: [
		"&6Goal:&r Craft &616 belt connectors&r.",
		"",
		"Belts move items between depots, basins, and inventories — Create's conveyor system.",
		"",
		"&6How:&r\n&e1.&r Craft belt connectors (dried kelp + andesite alloy).\n&e2.&r Place two shafts (or cogs) apart, then right-click both with a belt connector to stretch a belt.\n&e3.&r Power one shaft so the belt moves; drop items on top to convey them.\n&e4.&r Slope belts with shafts at different heights for chutes between floors.",
		"",
		"&7Tip:&r Dried kelp farms pay for themselves once belts go wide."
	]
	quest.B1000000000000D7.title: "Depots"
	quest.B1000000000000D7.quest_subtitle: "Logistics"
	quest.B1000000000000D7.quest_desc: [
		"&6Goal:&r Craft &68 depots&r.",
		"",
		"Depots hold a single stack for presses, deployers, and belt handoff — the workbench of kinetics.",
		"",
		"&6How:&r\n&e1.&r Craft 8 depots and place them under presses or along belt lines.\n&e2.&r Drop an item on a depot — a press above will process it in place.\n&e3.&r Use belts + funnels to load/unload depots automatically.\n&e4.&r Chain depot → belt → depot for assembly lines."
	]
	quest.B1000000000000D8.title: "Andesite Funnels"
	quest.B1000000000000D8.quest_subtitle: "Logistics"
	quest.B1000000000000D8.quest_desc: [
		"&6Goal:&r Craft &68 andesite funnels&r.",
		"",
		"Pull and push items onto belts and into inventories. Brass funnels come later with filters.",
		"",
		"&6How:&r\n&e1.&r Craft 8 andesite funnels.\n&e2.&r Place a funnel on a chest/basin facing a belt to extract items onto the belt.\n&e3.&r Place a funnel facing into an inventory to insert from a belt.\n&e4.&r Use chutes for vertical drops when belts are overkill.",
		"",
		"&7Tip:&r Funnels only move when powered by kinetics on their belt/shaft side — check the goggles overlay."
	]
	quest.B1000000000000D9.title: "Crushing Wheels"
	quest.B1000000000000D9.quest_subtitle: "Ores"
	quest.B1000000000000D9.quest_desc: [
		"&6Goal:&r Craft &62 crushing wheels&r and place them as a pair.",
		"",
		"Crush ores for &amore output&r than a furnace — the pack's first real ore multiplier.",
		"",
		"&6How:&r\n&e1.&r Craft 2 crushing wheels.\n&e2.&r Place them as a facing pair (JEI / ponder shows the gap) so items fall between.\n&e3.&r Power both wheels so they rotate toward each other.\n&e4.&r Drop raw ore into the gap; collect crushed ore below with a belt or hopper.\n&e5.&r Wash crushed ore with a fan + water path for extra nuggets, then smelt.",
		"",
		"&7Tip:&r Wash crushed ores with a fan + water for extra nuggets.",
		"",
		"&7Next:&r Hunt zinc, then blaze burners for brass."
	]
	quest.B1000000000000DA.title: "Zinc Stockpile"
	quest.B1000000000000DA.quest_subtitle: "Metals"
	quest.B1000000000000DA.quest_desc: [
		"&6Goal:&r Produce &616 zinc ingots&r.",
		"",
		"Zinc + copper (+ heat) = brass. Mine zinc ore or crush raw zinc.",
		"",
		"&6How:&r\n&e1.&r Mine zinc ore (or find raw zinc) — check JEI for worldgen look.\n&e2.&r Optional: crush zinc ore for better yields, then wash.\n&e3.&r Smelt until you hold 16 zinc ingots.\n&e4.&r Store next to copper — brass mixing will burn through both."
	]
	quest.B1000000000000DB.title: "Fluid Tanks"
	quest.B1000000000000DB.quest_subtitle: "Fluids"
	quest.B1000000000000DB.quest_desc: [
		"&6Goal:&r Craft &64 fluid tanks&r.",
		"",
		"Store water, lava, chocolate, plant oil, diesel, and liquid XP later. Stack tanks into towers.",
		"",
		"&6How:&r\n&e1.&r Press copper into copper sheets, then craft fluid tanks.\n&e2.&r Place tanks adjacent to each other to form a multiblock tank tower.\n&e3.&r Right-click with a bucket to fill/empty for testing.\n&e4.&r Pipe in with mechanical pumps once you craft them.",
		"",
		"&7Next:&r Mechanical pumps and hose pulleys move fluids around the factory."
	]
	quest.B1000000000000DC.title: "Mechanical Pump"
	quest.B1000000000000DC.quest_subtitle: "Fluids"
	quest.B1000000000000DC.quest_desc: [
		"&6Goal:&r Build a Mechanical Pump.",
		"",
		"Move fluids through Create pipes under SU power — water for steam, oil for diesel, XP for enchanting.",
		"",
		"&6How:&r\n&e1.&r Craft copper fluid pipes and a mechanical pump.\n&e2.&r Connect pipe from a fluid tank (or source) through the pump to a destination tank.\n&e3.&r Power the pump with a shaft — flow direction follows pump orientation (wrench to flip).\n&e4.&r Verify transfer with a tank window or by bucket-testing the output."
	]
	quest.B1000000000000DD.title: "Hose Pulley"
	quest.B1000000000000DD.quest_subtitle: "Fluids"
	quest.B1000000000000DD.quest_desc: [
		"&6Goal:&r Craft a hose pulley.",
		"",
		"Drain or fill lakes and infinite fluid sources into your tank network.",
		"",
		"&6How:&r\n&e1.&r Craft a hose pulley and place it above a fluid surface or tank.\n&e2.&r Connect fluid pipes from the pulley to your tank farm.\n&e3.&r Power the pulley; extend the hose into the fluid.\n&e4.&r Use it to drain a lake into tanks or dump fluids back out."
	]
	quest.B1000000000000DE.title: "Blaze Burner"
	quest.B1000000000000DE.quest_subtitle: "Brass gate"
	quest.B1000000000000DE.quest_desc: [
		"&6Goal:&r Craft a Blaze Burner.",
		"",
		"Empty burner + blaze. Feed blaze cakes or fuel to &6superheat&r for brass and heated mixes.",
		"",
		"&6How:&r\n&e1.&r Go to a Nether fortress (Waystone home first) and collect blaze rods / catch a blaze.\n&e2.&r Craft an empty blaze burner, then right-click it with a blaze to fill.\n&e3.&r Place the burner under a basin that has a mixer above.\n&e4.&r Feed fuel / blaze cakes until the burner reaches the heat level JEI shows for brass.",
		"",
		"&7Tip:&r Nether fortress or piglin trades. Place a Waystone before the trip.",
		"",
		"&7Next:&r Mix copper + zinc with heat → brass age."
	]
	quest.B1000000000000DF.title: "Brass Age"
	quest.B1000000000000DF.quest_subtitle: "Brass"
	quest.B1000000000000DF.quest_desc: [
		"&6Goal:&r Produce &632 brass ingots&r.",
		"",
		"Brass unlocks smart mechanisms, deployers, arms, trains, and most midgame Create addons.",
		"",
		"&6How:&r\n&e1.&r Set up basin + mixer + heated blaze burner underneath.\n&e2.&r Insert copper ingots + zinc ingots into the basin (ratios per JEI).\n&e3.&r Power the mixer until brass ingots craft; repeat until you have 32.\n&e4.&r Automate with funnels: copper chest → basin ← zinc chest, output funnel to a brass chest.",
		"",
		"&7Tip:&r Automate brass early — precision mechanisms will eat it forever."
	]
	quest.B1000000000000E0.title: "Brass Casing"
	quest.B1000000000000E0.quest_subtitle: "Brass"
	quest.B1000000000000E0.quest_desc: [
		"&6Goal:&r Craft &616 brass casings&r.",
		"",
		"Frames deployers, mechanical arms, smart chutes, and precision machines.",
		"",
		"&6How:&r\n&e1.&r Press brass into brass sheets if the recipe needs them.\n&e2.&r Craft brass casings from brass + stripped wood (same idea as andesite casing).\n&e3.&r Stock 16+ before starting deployers and mechanical crafters."
	]
	quest.B1000000000000E1.title: "Electron Tubes"
	quest.B1000000000000E1.quest_subtitle: "Brass"
	quest.B1000000000000E1.quest_desc: [
		"&6Goal:&r Craft &68 electron tubes&r.",
		"",
		"Polished rose quartz + iron plates. The redstone-smart part inside precision builds.",
		"",
		"&6How:&r\n&e1.&r Craft rose quartz (quartz + redstone), then polish it (sandpaper / deployers).\n&e2.&r Press iron sheets as needed.\n&e3.&r Craft 8 electron tubes from JEI.\n&e4.&r Keep extras — mechanical crafters and smart machines spend them."
	]
	quest.B1000000000000E2.title: "Mechanical Crafters"
	quest.B1000000000000E2.quest_subtitle: "Midgame"
	quest.B1000000000000E2.quest_desc: [
		"&6Goal:&r Craft &69 mechanical crafters&r.",
		"",
		"Arrange them into a crafting grid for sequenced assembly — how precision mechanisms are born.",
		"",
		"&6How:&r\n&e1.&r Craft 9 mechanical crafters.\n&e2.&r Place them in a 3×3 grid facing the same way; connect with a crafter arrangement (wrench / ponder).\n&e3.&r Power the bank of crafters from one kinetic input.\n&e4.&r Set the crafting pattern for the next recipe (or prepare for sequenced assembly with deployers).",
		"",
		"&7Tip:&r JEI shows the assembly sequence. Automate inputs with funnels/arms."
	]
	quest.B1000000000000E3.title: "Precision Mechanisms"
	quest.B1000000000000E3.quest_subtitle: "Midgame"
	quest.B1000000000000E3.quest_desc: [
		"&6Goal:&r Assemble &68 precision mechanisms&r.",
		"",
		"Midgame Create currency — arms, consoles, trains, and many addons want them.",
		"",
		"&6How:&r\n&e1.&r Open JEI on Precision Mechanism and note the sequenced assembly steps.\n&e2.&r Build a loop: belt + depot/belt chain with deployers holding the required parts (cogwheels, large cogs, electron tubes, etc.).\n&e3.&r Insert incomplete mechanisms into the loop; deployers apply parts in order until complete.\n&e4.&r Output finished mechanisms to a chest — craft 8 total (automate if hand-feeding hurts).",
		"",
		"&7Tip:&r If crafting these by hand hurts, your factory isn't finished yet.",
		"",
		"&7Next:&r Deployers and arms next — then Ore Excavation for infinite ore."
	]
	quest.B1000000000000E4.title: "Deployer"
	quest.B1000000000000E4.quest_subtitle: "Brass machines"
	quest.B1000000000000E4.quest_desc: [
		"&6Goal:&r Build a Deployer.",
		"",
		"Auto-uses items: applying tools, placing blocks, assembly sequences, farming, and more.",
		"",
		"&6How:&r\n&e1.&r Craft a Deployer and place it facing a depot or belt lane.\n&e2.&r Power it; put the held item (tool, cogwheel, electron tube…) in the deployer hand slot.\n&e3.&r Filter/hand items so each deployer applies one assembly step.\n&e4.&r Use on a depot: item arrives → deployer uses held item → item continues down the line.",
		"",
		"&7Tip:&r Deployers are the hands of sequenced assembly — one deployer per ingredient step."
	]
	quest.B1000000000000E5.title: "Mechanical Arm"
	quest.B1000000000000E5.quest_subtitle: "Brass machines"
	quest.B1000000000000E5.quest_desc: [
		"&6Goal:&r Build a Mechanical Arm.",
		"",
		"Program inputs/outputs to move items between inventories without belts everywhere.",
		"",
		"&6How:&r\n&e1.&r Craft a Mechanical Arm and place it within reach of two inventories/depots.\n&e2.&r Power the arm; open its UI and set deposit/withdraw targets by clicking inventories.\n&e3.&r Assign which slots / filters it should move.\n&e4.&r Test with a single stack, then trust it for crafter feeding and mechanism outputs."
	]
	quest.B1000000000000E6.title: "Steam Engine"
	quest.B1000000000000E6.quest_subtitle: "Power"
	quest.B1000000000000E6.quest_desc: [
		"&6Goal:&r Build a Steam Engine.",
		"",
		"Serious SU from water tanks + blaze burners — the jump from water wheels to real factories.",
		"",
		"&6How:&r\n&e1.&r Build a fluid tank tower filled with water.\n&e2.&r Attach blaze burners to heat the boiler / tank setup per JEI \\& ponder.\n&e3.&r Place the steam engine against the heated tank and connect a shaft output.\n&e4.&r Whisk / engine assembly produces high SU — gear it into your main network.",
		"",
		"&7Tip:&r Keep water topped up with a pump + hose pulley from a lake."
	]
	quest.B1000000000000E7.title: "Vein Finder"
	quest.B1000000000000E7.quest_subtitle: "Ores"
	quest.B1000000000000E7.quest_desc: [
		"&6Goal:&r Craft a Vein Finder (Create Ore Excavation).",
		"",
		"Scan for infinite ore veins, then plant a drilling machine. The pack's answer to strip-mining forever.",
		"",
		"&6How:&r\n&e1.&r Craft the Vein Finder from JEI.\n&e2.&r Right-click in the world to scan; note vein type and position.\n&e3.&r Travel to the vein marker and clear a pad for the drilling machine.\n&e4.&r Return once you have drills and SU to spare.",
		"",
		"&7Tip:&r Best once crushing wheels make processing cheap."
	]
	quest.B1000000000000E8.title: "Drilling Machine"
	quest.B1000000000000E8.quest_subtitle: "Ores"
	quest.B1000000000000E8.quest_desc: [
		"&6Goal:&r Build a Drilling Machine on a found vein.",
		"",
		"Feed it SU and drills for passive ore. Pair with crushing + washing for absurd ingot/hour.",
		"",
		"&6How:&r\n&e1.&r Place the Drilling Machine on the located vein.\n&e2.&r Connect kinetic power (water wheels → steam/diesel later).\n&e3.&r Insert drill heads and set fluid/drill requirements per JEI.\n&e4.&r Pipe or funnel ore output into your crushing → washing → smelting line."
	]
	quest.B1000000000000E9.title: "New Age Coil"
	quest.B1000000000000E9.quest_subtitle: "Power"
	quest.B1000000000000E9.quest_desc: [
		"&6Goal:&r Craft a Create: New Age generator coil.",
		"",
		"Magnets and electrical generation that pair with Create kinetics — another power path beside diesel and CCA.",
		"",
		"&6How:&r\n&e1.&r Craft a generator coil and the magnets / wires JEI lists.\n&e2.&r Assemble the New Age generator structure (coil + magnets) per ponder/JEI.\n&e3.&r Spin the kinetic input to generate electricity.\n&e4.&r Route power to motors or FE machines as needed."
	]
	quest.B1000000000000EA.title: "New Age Motor"
	quest.B1000000000000EA.quest_subtitle: "Power"
	quest.B1000000000000EA.quest_desc: [
		"&6Goal:&r Craft a basic motor (Create: New Age).",
		"",
		"Turn electrical power back into rotation for remote workshops.",
		"",
		"&6How:&r\n&e1.&r Craft a basic motor.\n&e2.&r Supply it with New Age / FE electricity from your generator.\n&e3.&r Attach a shaft to the motor output and power distant machines.\n&e4.&r Use for outposts where water wheels are awkward."
	]
	quest.B1000000000000EB.title: "Factory Catwalks"
	quest.B1000000000000EB.quest_subtitle: "Building"
	quest.B1000000000000EB.quest_desc: [
		"&6Goal:&r Craft an andesite catwalk (Create Deco).",
		"",
		"Industrial décor that makes factories readable — walkways, hulls, lamps, and sheet metal.",
		"",
		"&6How:&r\n&e1.&r Craft an andesite catwalk from JEI.\n&e2.&r Place walkways above machine lines so you can service kinetics safely.\n&e3.&r Add supports / lamps so the factory stays navigable at night."
	]
	quest.B1000000000000EC.title: "Copycat Block"
	quest.B1000000000000EC.quest_subtitle: "Building"
	quest.B1000000000000EC.quest_desc: [
		"&6Goal:&r Craft a Copycats+ copycat block.",
		"",
		"Disguise technical blocks as any material — hide cables and machines inside pretty walls.",
		"",
		"&6How:&r\n&e1.&r Craft a copycat block.\n&e2.&r Place it, then apply a material (right-click with a block) to copy its appearance.\n&e3.&r Wrap shafts, pipes, or ugly machinery in matching walls."
	]
	quest.B1000000000000ED.title: "Train Interiors"
	quest.B1000000000000ED.quest_subtitle: "Building"
	quest.B1000000000000ED.quest_desc: [
		"&6Goal:&r Craft seatwood planks (Create: Interiors).",
		"",
		"Furniture and seating for trains and stations — optional flair once tracks exist.",
		"",
		"&6How:&r\n&e1.&r Craft seatwood planks from JEI.\n&e2.&r Build chairs / interiors inside a train carriage or station.\n&e3.&r Ride in style once your track network is online."
	]
	quest.B1000000000000EE.title: "Train Track"
	quest.B1000000000000EE.quest_subtitle: "Trains"
	quest.B1000000000000EE.quest_desc: [
		"&6Goal:&r Craft &616 Create train tracks&r.",
		"",
		"Trains move bulk items and players across the map. Steam 'n' Rails adds more track styles and conductors later.",
		"",
		"&6How:&r\n&e1.&r Craft 16 tracks (andesite alloy + stone/andesite per JEI).\n&e2.&r Place a track line by clicking sequentially along the path (shift for slopes/curves as prompted).\n&e3.&r Add a station block / train assembly when you have a locomotive package.\n&e4.&r Assemble a train on a robust track, define schedules, and haul items between bases.",
		"",
		"&7Tip:&r Trains need precision mechanisms and brass — finish those first if assembly is locked.",
		"",
		"&7Next:&r Beyond Brass covers conductor whistles and fuel tanks."
	]
	quest.B1000000000000EF.title: "Copper Magnet"
	quest.B1000000000000EF.quest_subtitle: "Tools"
	quest.B1000000000000EF.quest_desc: [
		"&6Goal:&r Craft a copper magnet (Stuff 'N Additions).",
		"",
		"Pull nearby items — great while mining or standing near crushing outputs.",
		"",
		"&6How:&r\n&e1.&r Craft a copper magnet from JEI.\n&e2.&r Keep it in your inventory / Curios as the mod expects.\n&e3.&r Stand near crushing-wheel outputs or ore drops to vacuum items."
	]
	quest.B10000000000012C.title: "Backpack"
	quest.B10000000000012C.quest_subtitle: "Carry more"
	quest.B10000000000012C.quest_desc: [
		"Upgradeable carry storage — stack, magnet, feeding, and tool-swap upgrades turn your inventory into a workshop.",
		"",
		"&6You will:&r\n&e•&r Craft a Sophisticated Backpack and open it with right-click\n&e•&r Install upgrades from the backpack GUI\n&e•&r Graduate to drawers, Pipez, and Tom's Storage for base logistics",
		"",
		"&7Tip:&r Iron backpack + stack upgrade first, then drawers for bulk materials.",
		"",
		"&6Goal:&r Craft a Sophisticated Backpack.",
		"",
		"Your first expandable inventory — mining trips and factory wiring stop fighting a 36-slot limit.",
		"",
		"&6How:&r\n&e1.&r Craft the basic backpack (leather + chest materials — check JEI).\n&e2.&r Right-click to open it; wear it in the chest/back slot if your UI supports it.\n&e3.&r Open the upgrade tab and note empty upgrade slots for later stack/magnet upgrades.",
		"",
		"&7Tip:&r Do not throw the backpack away when upgrading — higher tiers usually upgrade in place.",
		"",
		"&7Next:&r Iron backpack for more slots, then drawers for bulk ore.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B10000000000012D.title: "Iron Backpack"
	quest.B10000000000012D.quest_subtitle: "Carry more"
	quest.B10000000000012D.quest_desc: [
		"&6Goal:&r Upgrade to an Iron Backpack.",
		"",
		"More slots for long cave runs and factory wiring sessions.",
		"",
		"&6How:&r\n&e1.&r Craft the iron backpack upgrade / recipe from JEI.\n&e2.&r Apply it to your basic backpack (crafting grid or upgrade UI).\n&e3.&r Re-equip and confirm the extra slots before your next mining trip."
	]
	quest.B10000000000012E.title: "Stack Upgrade"
	quest.B10000000000012E.quest_subtitle: "Carry more"
	quest.B10000000000012E.quest_desc: [
		"&6Goal:&r Craft a stack upgrade (tier 1) for your backpack.",
		"",
		"Carry fewer slot types and more of what matters — alloy, sheets, mechanisms.",
		"",
		"&6How:&r\n&e1.&r Craft a tier-1 stack upgrade.\n&e2.&r Open the backpack GUI and place the upgrade in an upgrade slot.\n&e3.&r Fill stacks of alloy / ingots to see the higher stack size.",
		"",
		"&7Tip:&r Pickup and magnet upgrades pair well for crushing-wheel cleanup."
	]
	quest.B10000000000012F.title: "Drawers"
	quest.B10000000000012F.quest_subtitle: "Storage"
	quest.B10000000000012F.quest_desc: [
		"&6Goal:&r Craft &64 Functional Storage drawers&r.",
		"",
		"Drawers compact a huge count of one item — perfect for cobble, andesite alloy, and ingots.",
		"",
		"&6How:&r\n&e1.&r Craft 4 oak (or any wood) 1×1 drawers.\n&e2.&r Place them on a wall near your factory inputs.\n&e3.&r Right-click with an item to lock / fill that drawer's type.\n&e4.&r Label mentally: cobble, alloy, iron, copper — one type each.",
		"",
		"&7Next:&r Add a storage controller to talk to many drawers at once."
	]
	quest.B100000000000130.title: "Drawer Controller"
	quest.B100000000000130.quest_subtitle: "Storage"
	quest.B100000000000130.quest_desc: [
		"&6Goal:&r Craft a Functional Storage controller.",
		"",
		"Access a whole drawer wall from one block — pipe into the controller, not every drawer.",
		"",
		"&6How:&r\n&e1.&r Craft a storage controller.\n&e2.&r Place it touching your drawer cluster (same contiguous wall).\n&e3.&r Open the controller to browse all linked drawers.\n&e4.&r Point Pipez / funnels at the controller for bulk import/export."
	]
	quest.B100000000000131.title: "Compacting Drawer"
	quest.B100000000000131.quest_subtitle: "Storage"
	quest.B100000000000131.quest_desc: [
		"&6Goal:&r Craft a compacting drawer.",
		"",
		"Auto-crafts nuggets ↔ ingots ↔ blocks. Perfect for iron, gold, and Create metals.",
		"",
		"&6How:&r\n&e1.&r Craft a compacting drawer and place it in your drawer wall.\n&e2.&r Insert iron (or another compactable metal) — watch nuggets/ingots/blocks convert.\n&e3.&r Link it through the storage controller with the rest of the wall.\n&e4.&r Pipe forge outputs here to auto-compress storage."
	]
	quest.B100000000000132.title: "Sophisticated Chest"
	quest.B100000000000132.quest_subtitle: "Storage"
	quest.B100000000000132.quest_desc: [
		"&6Goal:&r Craft a Sophisticated Storage iron chest.",
		"",
		"Upgradeable chests/barrels with the same upgrade ecosystem as backpacks — filters, compacting, and more.",
		"",
		"&6How:&r\n&e1.&r Craft a Sophisticated Storage iron chest.\n&e2.&r Place it and open the upgrade slots in its GUI.\n&e3.&r Install filters / pickup / compacting upgrades as needed.\n&e4.&r Use for mixed junk that does not belong in single-item drawers."
	]
	quest.B100000000000133.title: "Storage Controller"
	quest.B100000000000133.quest_subtitle: "Storage"
	quest.B100000000000133.quest_desc: [
		"&6Goal:&r Craft a Sophisticated Storage controller.",
		"",
		"Network nearby sophisticated containers for combined access.",
		"",
		"&6How:&r\n&e1.&r Craft a Sophisticated Storage controller.\n&e2.&r Place it within range of your sophisticated chests/barrels.\n&e3.&r Open the controller to access the networked containers together.\n&e4.&r Optional: link to pipes for a second storage bus beside drawers."
	]
	quest.B100000000000134.title: "Tom's Storage Hub"
	quest.B100000000000134.quest_subtitle: "Storage"
	quest.B100000000000134.quest_desc: [
		"&6Goal:&r Craft Tom's Inventory Connector.",
		"",
		"Link nearby inventories and browse them from a terminal — lightweight digital storage without AE2.",
		"",
		"&6How:&r\n&e1.&r Craft Tom's Inventory Connector and place it centrally.\n&e2.&r Ensure chests/drawers you want linked are within range (use cables for larger bases).\n&e3.&r Open the connector / attached terminal to browse combined inventories.\n&e4.&r Add more storage in range rather than running across the base.",
		"",
		"&7Tip:&r Keep linked chests close; use cables for larger bases.",
		"",
		"&7Next:&r Add a crafting terminal for JEI-friendly crafting from the network."
	]
	quest.B100000000000135.title: "Crafting Terminal"
	quest.B100000000000135.quest_subtitle: "Storage"
	quest.B100000000000135.quest_desc: [
		"&6Goal:&r Craft Tom's Crafting Terminal.",
		"",
		"Craft using everything the Inventory Connector can see. Pair with Pipez or Create for restocking.",
		"",
		"&6How:&r\n&e1.&r Craft a Crafting Terminal.\n&e2.&r Attach / place it on the Inventory Connector network.\n&e3.&r Open it and craft with JEI transfer from networked items.\n&e4.&r Restock ingredients via Pipez into connector-linked chests."
	]
	quest.B100000000000136.title: "Item Pipes"
	quest.B100000000000136.quest_subtitle: "Pipes"
	quest.B100000000000136.quest_desc: [
		"&6Goal:&r Craft &632 Pipez item pipes&r.",
		"",
		"Chest-to-chest logistics with filters — simpler than Create belts for bulk sorting.",
		"",
		"&6How:&r\n&e1.&r Craft 32 item pipes and a Pipez wrench if you lack one.\n&e2.&r Connect a source chest to a destination (drawer controller works great).\n&e3.&r Use the wrench to set extract/insert sides and distribution mode.\n&e4.&r Add filter upgrades so only the right items move.",
		"",
		"&7Tip:&r Configure with a wrench. Upgrades raise speed."
	]
	quest.B100000000000137.title: "Fluid Pipes"
	quest.B100000000000137.quest_subtitle: "Pipes"
	quest.B100000000000137.quest_desc: [
		"&6Goal:&r Craft &616 fluid pipes&r.",
		"",
		"Move water, lava, chocolate, diesel, and Create fluids between tanks and machines.",
		"",
		"&6How:&r\n&e1.&r Craft 16 fluid pipes.\n&e2.&r Connect a fluid tank or cauldron to a machine/tank destination.\n&e3.&r Wrench-configure extract on the source and insert on the sink.\n&e4.&r Use filters when multiple fluids share a pipe network."
	]
	quest.B100000000000138.title: "Energy Pipes"
	quest.B100000000000138.quest_subtitle: "Pipes"
	quest.B100000000000138.quest_desc: [
		"&6Goal:&r Craft &616 energy pipes&r.",
		"",
		"Move FE between Create Crafts \\& Additions machines, jetpack chargers, and electric addons.",
		"",
		"&6How:&r\n&e1.&r Craft 16 energy pipes.\n&e2.&r Connect an FE source (alternator buffer, diesel gens, etc.) to a consumer.\n&e3.&r Wrench sides to extract from batteries and insert into machines.\n&e4.&r Upgrade transfer rate if chargers starve."
	]
	quest.B100000000000139.title: "Gold Chest"
	quest.B100000000000139.quest_subtitle: "Storage"
	quest.B100000000000139.quest_desc: [
		"&6Goal:&r Upgrade to a Gold Chest.",
		"",
		"When drawer networks aren't enough for mixed junk storage.",
		"",
		"&6How:&r\n&e1.&r Craft / upgrade to a Gold Chest from JEI.\n&e2.&r Place it near your crafting terminal for overflow misc items.\n&e3.&r Keep ores and bulk mats in drawers — gold chests for mixed loot."
	]
	quest.B10000000000013A.title: "Gold Furnace"
	quest.B10000000000013A.quest_subtitle: "Smelting"
	quest.B10000000000013A.quest_desc: [
		"&6Goal:&r Craft a Gold Furnace.",
		"",
		"Big smelting speed jump. Diamond / netherite tiers wait in Beyond Brass.",
		"",
		"&6How:&r\n&e1.&r Craft a Gold Furnace (upgrade path from iron — check JEI).\n&e2.&r Move your smelting line over and keep it fueled.\n&e3.&r Pipe ore in / ingots out with Pipez for a hands-off smeltery."
	]
	quest.B10000000000013B.title: "Blueprint Paper"
	quest.B10000000000013B.quest_subtitle: "Gear"
	quest.B10000000000013B.quest_desc: [
		"&6Goal:&r Craft &64 Silent Gear blueprint papers&r.",
		"",
		"Blueprints let you stamp modular tool recipes. Mix materials for mining speed, durability, and harvest level.",
		"",
		"&6How:&r\n&e1.&r Craft 4 blueprint papers from JEI.\n&e2.&r Keep them for tool blueprints (pickaxe next).\n&e3.&r Skim JEI material traits so you know which metals to save."
	]
	quest.B10000000000013C.title: "Pickaxe Blueprint"
	quest.B10000000000013C.quest_subtitle: "Gear"
	quest.B10000000000013C.quest_desc: [
		"&6Goal:&r Craft a Silent Gear pickaxe blueprint.",
		"",
		"Build modular pickaxes — head, rod, and tip materials each matter.",
		"",
		"&6How:&r\n&e1.&r Craft a pickaxe blueprint.\n&e2.&r Use it at the Silent Gear crafting station / recipe to assemble head + rod (+ tip).\n&e3.&r Pick materials for harvest level and durability (iron/diamond early; better metals later).\n&e4.&r Repair / swap parts as you unlock stronger materials.",
		"",
		"&7Tip:&r JEI shows material traits. Upgrade tips as you find better metals."
	]
	quest.B10000000000013D.title: "Sword Blueprint"
	quest.B10000000000013D.quest_subtitle: "Gear"
	quest.B10000000000013D.quest_desc: [
		"&6Goal:&r Craft a Silent Gear sword blueprint.",
		"",
		"Optional combat path — match materials to your mining set for style points.",
		"",
		"&6How:&r\n&e1.&r Craft a sword blueprint.\n&e2.&r Assemble a sword with the same material family as your pickaxe.\n&e3.&r Test damage / durability; re-part if a better metal drops."
	]
	quest.B10000000000013E.title: "Construction Stick"
	quest.B10000000000013E.quest_subtitle: "Building"
	quest.B10000000000013E.quest_desc: [
		"&6Goal:&r Craft an Iron Construction Stick.",
		"",
		"Extend walls and platforms in one click — faster base building before Building Gadgets.",
		"",
		"&6How:&r\n&e1.&r Craft an Iron Construction Stick.\n&e2.&r Select a building block and aim at a surface.\n&e3.&r Extend floors/walls in the stick's placement mode (scroll / keys per mod).\n&e4.&r Undo mistakes with the stick's undo if available — practice on a test wall."
	]
	quest.B10000000000013F.title: "Building Gadget"
	quest.B10000000000013F.quest_subtitle: "Building"
	quest.B10000000000013F.quest_desc: [
		"&6Goal:&r Craft a Building Gadget 2.",
		"",
		"Copy / build / exchange blocks in bulk — perfect for factories and railways.",
		"",
		"&6How:&r\n&e1.&r Craft a Building Gadget and charge / fuel it if required.\n&e2.&r Set the block type and build mode (wall, surface, etc.).\n&e3.&r Hold enough blocks in inventory, then click to place large sections.\n&e4.&r Use it to stamp Create factory footprints quickly.",
		"",
		"&7Tip:&r Exchanging and copy-paste gadgets are worth unlocking next."
	]
	quest.B100000000000140.title: "Copy-Paste Gadget"
	quest.B100000000000140.quest_subtitle: "Building"
	quest.B100000000000140.quest_desc: [
		"&6Goal:&r Craft the Copy-Paste Gadget.",
		"",
		"Save a structure and stamp it elsewhere — repeated factory modules become trivial.",
		"",
		"&6How:&r\n&e1.&r Craft the Copy-Paste Gadget.\n&e2.&r Select a region of your factory module and copy it.\n&e3.&r Paste at a new location with the required blocks in inventory.\n&e4.&r Save templates for belt lines, steam setups, or station buildings."
	]
	quest.B100000000000141.title: "Artifact Hunt"
	quest.B100000000000141.quest_subtitle: "Trinkets"
	quest.B100000000000141.quest_desc: [
		"&6Goal:&r Find an Artifacts umbrella (or any artifact you prefer — umbrella is the checklist item).",
		"",
		"Trinkets drop from chests, mobs, and exploration. Equip them in Curios slots.",
		"",
		"&6How:&r\n&e1.&r Explore structures / defeat mobs that drop Artifacts.\n&e2.&r Pick up an umbrella (or keep hunting until one drops).\n&e3.&r Equip it in a Curios slot and test its effect.",
		"",
		"&7Tip:&r Truly optional scavenger hunt — skip if RNG hates you."
	]
	quest.B100000000000142.title: "Structure Scout"
	quest.B100000000000142.quest_subtitle: "Exploration"
	quest.B100000000000142.quest_desc: [
		"&6Goal:&r Craft an Eye of Ender.",
		"",
		"Stronghold energy is optional this early — mostly a reminder that &6Lootr&r makes structure chests per-player.",
		"",
		"&6How:&r\n&e1.&r Craft an Eye of Ender (blaze powder + ender pearl).\n&e2.&r Optional: throw it to locate a stronghold when you are ready.\n&e3.&r Raid structures with friends — each player gets their own Lootr chests.",
		"",
		"&7Tip:&r Raid structures with friends without loot drama."
	]
	quest.B100000000000143.title: "Faucet"
	quest.B100000000000143.quest_subtitle: "QoL"
	quest.B100000000000143.quest_desc: [
		"&6Goal:&r Craft a Supplementaries faucet.",
		"",
		"Pour fluids from tanks/cauldrons — handy QoL beside Create pumps.",
		"",
		"&6How:&r\n&e1.&r Craft a Supplementaries faucet.\n&e2.&r Place it on the side of a tank, jar, or cauldron.\n&e3.&r Activate to pour fluid into the block below (cauldron, basin, etc.).\n&e4.&r Use for small kitchen / XP bottle setups without a full pipe network."
	]
	quest.B100000000000190.title: "Menril Wood"
	quest.B100000000000190.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000190.quest_desc: [
		"Menril fuels Integrated Dynamics crafting — this chapter's programmable logistics brain, plus diesel power and factory enchanting.",
		"",
		"&6You will:&r\n&e•&r Gather menril and spin up an ID cable network\n&e•&r Read inventories, tunnel items/fluids, and browse from a storage terminal\n&e•&r Generate FE with alternators and burn diesel for kinetic power",
		"",
		"&7Tip:&r Nature's Compass helps find menril biomes. Crystalized menril chunks also drop — keep them.",
		"",
		"&6Goal:&r Collect &616 Menril Logs&r.",
		"",
		"Menril is the wood/crystal backbone of Integrated Dynamics — cables, logic, and terminals all start here.",
		"",
		"&6How:&r\n&e1.&r Use Nature's Compass (or explore) to find a menril biome / menril trees.\n&e2.&r Chop &616 Menril Logs&r; keep crystalized menril chunks that drop.\n&e3.&r Haul the logs home and leave space for an ID cable spine through storage.",
		"",
		"&7Tip:&r Saplings replant near base so you are not hiking for every cable batch.",
		"",
		"&7Next:&r Craft ID cables and form your first logic network.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Brass Age\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000DF\"}}"
	]
	quest.B100000000000191.title: "Logic Network"
	quest.B100000000000191.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000191.quest_desc: [
		"&6Goal:&r Craft &632 Integrated Dynamics cables&r.",
		"",
		"ID is this pack's programmable logistics brain — readers, writers, and terminals plug into cable.",
		"",
		"&6How:&r\n&e1.&r Craft 32 ID cables from menril materials (JEI).\n&e2.&r Place a continuous cable line through your storage / factory area.\n&e3.&r Think of cables like a tiny computer bus — every part must touch the network.\n&e4.&r Leave branches toward chests you want to automate later.",
		"",
		"&7Tip:&r Break and replace cables carefully — orphaned segments lose network access."
	]
	quest.B100000000000192.title: "Logic Programmer"
	quest.B100000000000192.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000192.quest_desc: [
		"&6Goal:&r Craft a Logic Programmer.",
		"",
		"The desk where you write variable cards — numbers, items, lists, operators, and filters.",
		"",
		"&6How:&r\n&e1.&r Craft a Logic Programmer and place it near your cable network.\n&e2.&r Open it and create a simple variable (e.g. an item type or number).\n&e3.&r Write the variable onto a blank variable card.\n&e4.&r Keep the programmer accessible — you will iterate filters often.",
		"",
		"&7Tip:&r There's also a portable programmer for field work."
	]
	quest.B100000000000193.title: "Variables"
	quest.B100000000000193.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000193.quest_desc: [
		"&6Goal:&r Craft &616 variables&r.",
		"",
		"Store numbers, items, lists, and logic — programming cards for your network.",
		"",
		"&6How:&r\n&e1.&r Craft 16 blank variable cards.\n&e2.&r Use the Logic Programmer to label a few: item filters, integers, operators.\n&e3.&r Insert written cards into readers / panels / tunnels as you build them.\n&e4.&r Keep blanks on hand — every new filter needs a card."
	]
	quest.B100000000000194.title: "Inventory Reader"
	quest.B100000000000194.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000194.quest_desc: [
		"&6Goal:&r Craft an Inventory Reader part.",
		"",
		"Attach to a cable facing an inventory to read contents into variables — the eyes of your network.",
		"",
		"&6How:&r\n&e1.&r Craft an Inventory Reader part.\n&e2.&r Place it on a cable block facing a chest or drawer controller.\n&e3.&r Insert a variable card configured to read items / counts.\n&e4.&r Verify with a display panel that the network sees the inventory."
	]
	quest.B100000000000195.title: "Display Panel"
	quest.B100000000000195.quest_subtitle: "Integrated Dynamics"
	quest.B100000000000195.quest_desc: [
		"&6Goal:&r Craft a display panel.",
		"",
		"Show variable values on the wall — debug your logic without guessing.",
		"",
		"&6How:&r\n&e1.&r Craft a display panel and place it on a cable.\n&e2.&r Insert the variable card you want to visualize.\n&e3.&r Watch values update as chests fill/empty — use this while tuning tunnels."
	]
	quest.B100000000000196.title: "Item Tunnels"
	quest.B100000000000196.quest_subtitle: "Tunnels"
	quest.B100000000000196.quest_desc: [
		"&6Goal:&r Craft &64 item interfaces&r (Integrated Tunnels).",
		"",
		"Pull and push items with filters — ID's version of import/export buses.",
		"",
		"&6How:&r\n&e1.&r Craft 4 item interface parts.\n&e2.&r Place interfaces on cable facing the inventories you want to link.\n&e3.&r Configure each interface with variable filters (which items to expose).\n&e4.&r Confirm items appear to the network before adding importers.",
		"",
		"&7Next:&r Importers automate continuous transfer; terminals let you browse the network."
	]
	quest.B100000000000197.title: "Item Importer"
	quest.B100000000000197.quest_subtitle: "Tunnels"
	quest.B100000000000197.quest_desc: [
		"&6Goal:&r Craft an item importer.",
		"",
		"Continuously pull items into the network with filters and conditions.",
		"",
		"&6How:&r\n&e1.&r Craft an item importer part.\n&e2.&r Place it on cable facing a machine output or chest to drain.\n&e3.&r Set filter variables (item type, rate, conditions).\n&e4.&r Watch items move into networked storage — tweak if the wrong items move."
	]
	quest.B100000000000198.title: "Fluid Tunnels"
	quest.B100000000000198.quest_subtitle: "Tunnels"
	quest.B100000000000198.quest_desc: [
		"&6Goal:&r Craft &62 fluid interfaces&r.",
		"",
		"Move Create fluids, diesel fuels, and liquid XP through the ID network.",
		"",
		"&6How:&r\n&e1.&r Craft 2 fluid interface parts.\n&e2.&r Place them on cable facing fluid tanks (Create tanks, barrels, etc.).\n&e3.&r Configure fluid filters so only the intended liquid transfers.\n&e4.&r Pair with importers/exporters when you automate diesel or XP lines."
	]
	quest.B100000000000199.title: "Storage Terminal"
	quest.B100000000000199.quest_subtitle: "Terminals"
	quest.B100000000000199.quest_desc: [
		"&6Goal:&r Craft a Storage Terminal.",
		"",
		"Browse and craft from everything your tunnels can see — the AE2 vibe without AE2.",
		"",
		"&6How:&r\n&e1.&r Craft a Storage Terminal part.\n&e2.&r Place it on your cable network within reach of a working desk.\n&e3.&r Open it — you should see items from every linked interface.\n&e4.&r Pull / deposit items from the terminal like a digital chest.",
		"",
		"&7Tip:&r Portable terminal exists for on-the-go access once unlocked."
	]
	quest.B10000000000019A.title: "Crafting Interface"
	quest.B10000000000019A.quest_subtitle: "Autocrafting"
	quest.B10000000000019A.quest_desc: [
		"&6Goal:&r Craft a Crafting Interface.",
		"",
		"Request autocrafting through your ID terminal once patterns / recipes are set up.",
		"",
		"&6How:&r\n&e1.&r Craft a Crafting Interface and place it on the network near crafting storage.\n&e2.&r Register recipes / patterns the mod expects (JEI + interface UI).\n&e3.&r Request a craft from the storage terminal.\n&e4.&r Verify ingredients pull from networked chests and outputs return.",
		"",
		"&7Next:&r You're ready for factory-scale enchanting and fuel systems."
	]
	quest.B10000000000019B.title: "Alternator"
	quest.B10000000000019B.quest_subtitle: "Power"
	quest.B10000000000019B.quest_desc: [
		"&6Goal:&r Build a Create Crafts \\& Additions Alternator.",
		"",
		"Spin it with SU to generate FE (Forge Energy) for electric addons and jetpack charging.",
		"",
		"&6How:&r\n&e1.&r Craft an Alternator and place it on a shaft from your kinetic network.\n&e2.&r Connect CCA energy connectors / wires / capacitors to the alternator output.\n&e3.&r Spin the shaft — confirm FE appears in a connected energy buffer.\n&e4.&r Route FE to chargers, electric motors, or energy pipes.",
		"",
		"&7Tip:&r More RPM / SU → more FE. Gear up if generation is weak."
	]
	quest.B10000000000019C.title: "Electric Motor"
	quest.B10000000000019C.quest_subtitle: "Power"
	quest.B10000000000019C.quest_desc: [
		"&6Goal:&r Build an Electric Motor.",
		"",
		"Turn FE back into SU — great for remote bases powered by diesel or New Age electricity.",
		"",
		"&6How:&r\n&e1.&r Craft an Electric Motor.\n&e2.&r Feed it FE from your alternator / battery line.\n&e3.&r Attach a shaft to the motor and set speed in its UI.\n&e4.&r Power a remote workshop without running long kinetic shafts."
	]
	quest.B10000000000019D.title: "Rolling Mill"
	quest.B10000000000019D.quest_subtitle: "Power"
	quest.B10000000000019D.quest_desc: [
		"&6Goal:&r Build a CCA Rolling Mill.",
		"",
		"Roll rods and wires for electrical crafting — pairs with the alternator line.",
		"",
		"&6How:&r\n&e1.&r Craft a Rolling Mill and power it with SU.\n&e2.&r Insert ingots / plates per JEI to roll rods and wires.\n&e3.&r Stock copper/electrum spools for more CCA machines."
	]
	quest.B10000000000019E.title: "Oil Scanner"
	quest.B10000000000019E.quest_subtitle: "Diesel"
	quest.B10000000000019E.quest_desc: [
		"&6Goal:&r Craft an oil scanner (Create Diesel Generators).",
		"",
		"Find crude oil deposits before committing to a pumpjack.",
		"",
		"&6How:&r\n&e1.&r Craft an oil scanner.\n&e2.&r Use it in the world to locate crude oil pockets.\n&e3.&r Mark the spot (Waystone / coords) for a pumpjack pad.\n&e4.&r Return with pipes, tanks, and a diesel engine plan."
	]
	quest.B10000000000019F.title: "Diesel Engine"
	quest.B10000000000019F.quest_subtitle: "Diesel"
	quest.B10000000000019F.quest_desc: [
		"&6Goal:&r Build a Diesel Engine.",
		"",
		"Process plant oil / crude into fuel and burn it for strong kinetic power — Create's combustion route.",
		"",
		"&6How:&r\n&e1.&r Craft a Diesel Engine and place it with shaft clearance.\n&e2.&r Supply fuel (plant oil early, diesel later) via buckets or fluid pipes.\n&e3.&r Start the engine and connect its kinetic output to your network.\n&e4.&r Scale fuel production before attaching high-stress machines.",
		"",
		"&7Tip:&r Distillation controller + pumpjacks scale this into a fuel empire."
	]
	quest.B1000000000001A0.title: "Distillation"
	quest.B1000000000001A0.quest_subtitle: "Diesel"
	quest.B1000000000001A0.quest_desc: [
		"&6Goal:&r Craft a distillation controller.",
		"",
		"Refine crude into diesel, gasoline, and other fractions for engines and asphalt builds.",
		"",
		"&6How:&r\n&e1.&r Craft a distillation controller.\n&e2.&r Build the distillation tower multiblock per JEI / ponder.\n&e3.&r Pump crude oil into the tower and heat / power as required.\n&e4.&r Pipe diesel (and other fractions) into barrels feeding your engines."
	]
	quest.B1000000000001A1.title: "Experience Hatch"
	quest.B1000000000001A1.quest_subtitle: "Enchanting"
	quest.B1000000000001A1.quest_desc: [
		"&6Goal:&r Craft an experience hatch (Enchantment Industry).",
		"",
		"Get liquid XP into Create fluid networks — the fuel for automated enchanting.",
		"",
		"&6How:&r\n&e1.&r Craft an experience hatch.\n&e2.&r Place it on a Create fluid tank / pipe line that will hold liquid XP.\n&e3.&r Feed XP into the system (bottles, grinders, or farm drops per mod recipes).\n&e4.&r Confirm liquid experience appears in the tank before building the enchanter."
	]
	quest.B1000000000001A2.title: "Blaze Enchanter"
	quest.B1000000000001A2.quest_subtitle: "Enchanting"
	quest.B1000000000001A2.quest_desc: [
		"&6Goal:&r Build a Blaze Enchanter.",
		"",
		"Pump liquid experience and automate enchanted books / gear — factory magic.",
		"",
		"&6How:&r\n&e1.&r Craft a Blaze Enchanter and place it with fluid access.\n&e2.&r Pipe liquid XP into the enchanter.\n&e3.&r Supply books / gear and set the enchanting mode in its UI.\n&e4.&r Power / configure per JEI, then pull enchanted outputs with funnels or arms.",
		"",
		"&7Tip:&r Printers copy enchanted books once you have templates."
	]
	quest.B1000000000001A3.title: "Enchantment Printer"
	quest.B1000000000001A3.quest_subtitle: "Enchanting"
	quest.B1000000000001A3.quest_desc: [
		"&6Goal:&r Craft an Enchantment Industry printer.",
		"",
		"Copy enchantments onto books/gear with liquid XP — mass-produce your favorite setups.",
		"",
		"&6How:&r\n&e1.&r Craft the printer and place it on your XP fluid line.\n&e2.&r Insert an enchanting template / source book.\n&e3.&r Feed blank books or gear plus liquid XP.\n&e4.&r Collect copies — duplicate your best tool enchants."
	]
	quest.B1000000000001A4.title: "Slice \\& Dice"
	quest.B1000000000001A4.quest_subtitle: "Food automation"
	quest.B1000000000001A4.quest_desc: [
		"&6Goal:&r Craft a Slice \\& Dice slicer.",
		"",
		"Pair with Create to automate Farmer's Delight cutting — salads on a conveyor belt.",
		"",
		"&6How:&r\n&e1.&r Craft a slicer and place it in a Create kinetic line.\n&e2.&r Power it and feed ingredients that need cutting-board recipes.\n&e3.&r Collect outputs onto a belt toward cooking pots / chests."
	]
	quest.B1000000000001A5.title: "Sprinkler"
	quest.B1000000000001A5.quest_subtitle: "Food automation"
	quest.B1000000000001A5.quest_desc: [
		"&6Goal:&r Craft a Slice \\& Dice sprinkler.",
		"",
		"Automate crop hydration / fertilizer vibes for bigger farms.",
		"",
		"&6How:&r\n&e1.&r Craft a sprinkler.\n&e2.&r Place it above farmland and supply fluid (water) as the mod requires.\n&e3.&r Power / activate so crops stay hydrated across the plot."
	]
	quest.B1000000000001A6.title: "Kinetic Brake"
	quest.B1000000000001A6.quest_subtitle: "Create extras"
	quest.B1000000000001A6.quest_desc: [
		"&6Goal:&r Craft a Brake (Create: Connected).",
		"",
		"Connected adds practical kinetic utilities — brakes, clutches, copycats-adjacent helpers, and more.",
		"",
		"&6How:&r\n&e1.&r Craft a Brake.\n&e2.&r Place it on a shaft line you want to stop on demand.\n&e3.&r Power / redstone-control the brake to halt rotation without breaking the network.\n&e4.&r Use it to pause crushers or assembly lines safely."
	]
	quest.B1000000000001A7.title: "Parallel Gearbox"
	quest.B1000000000001A7.quest_subtitle: "Create extras"
	quest.B1000000000001A7.quest_desc: [
		"&6Goal:&r Craft a parallel gearbox (Create: Connected).",
		"",
		"Compact kinetic routing for dense factory floors — squeeze more shafts into less space.",
		"",
		"&6How:&r\n&e1.&r Craft a parallel gearbox.\n&e2.&r Place it where two parallel shafts need to share rotation in a tight footprint.\n&e3.&r Connect inputs/outputs and verify direction with a wrench.\n&e4.&r Replace bulky cog towers on crowded floors."
	]
	quest.B100000000000144.title: "Quartz-Enriched Iron"
	quest.B100000000000144.quest_subtitle: "Core"
	quest.B100000000000144.quest_desc: [
		"&6Goal:&r Craft &616 Quartz-Enriched Iron&r.",
		"",
		"This is Refined Storage's base metal — processors, cables, and nearly every network block consume it.",
		"",
		"&6How:&r\n&e1.&r Gather iron, quartz, and redstone (and silicon once you need processors).\n&e2.&r Craft Quartz-Enriched Iron in a crafting table or Create mechanical crafter.\n&e3.&r Stockpile a chest or drawer of it before the machine rush.",
		"",
		"&7Tip:&r Batch processor ingredients now; every network device uses them.",
		"",
		"&7Next:&r Craft and power a Controller.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Precision Mechanisms\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000E3\"}}"
	]
	quest.B100000000000145.title: "Network Controller"
	quest.B100000000000145.quest_subtitle: "Core"
	quest.B100000000000145.quest_desc: [
		"&6Goal:&r Craft and power a Refined Storage Controller.",
		"",
		"The Controller is the network heart — no power, no storage, no grids.",
		"",
		"&6How:&r\n&e1.&r Place the Controller where you want the digital hub.\n&e2.&r Feed it FE from a Create Crafts \\& Additions alternator, diesel setup, Powah, or another generator.\n&e3.&r Confirm the Controller lights up; that means the network is online.",
		"",
		"&7Tip:&r Every connected device draws some FE — buffer power before growing the network.",
		"",
		"&7Next:&r Run cables to expand the network."
	]
	quest.B100000000000146.title: "Run the Network"
	quest.B100000000000146.quest_subtitle: "Core"
	quest.B100000000000146.quest_desc: [
		"&6Goal:&r Craft &632 Refined Storage cables&r.",
		"",
		"Cables join every RS device into one network across your factory.",
		"",
		"&6How:&r\n&e1.&r Place cable from the Controller toward machine and storage rooms.\n&e2.&r Route behind walls or under Create lines for clean service corridors.\n&e3.&r Touch devices to cable (or to each other) so they join the same network.",
		"",
		"&7Tip:&r Devices can touch directly; use cable only where you need distance.",
		"",
		"&7Next:&r Add a Disk Drive for storage bays."
	]
	quest.B100000000000147.title: "Disk Drive"
	quest.B100000000000147.quest_subtitle: "Items"
	quest.B100000000000147.quest_desc: [
		"&6Goal:&r Craft a Disk Drive and connect it to the Controller.",
		"",
		"A drive holds up to eight item or fluid disks — it provides bays, not capacity.",
		"",
		"&6How:&r\n&e1.&r Place the Disk Drive adjacent to cable (or touching the Controller).\n&e2.&r Open the drive GUI and confirm it shows as part of the network.\n&e3.&r Leave spare bays for fluid disks and future upgrades.",
		"",
		"&7Tip:&r Keep empty bays ready for Extra Disks tiers later.",
		"",
		"&7Next:&r Craft a 16K Item Storage Disk."
	]
	quest.B100000000000148.title: "16K Item Disk"
	quest.B100000000000148.quest_subtitle: "Items"
	quest.B100000000000148.quest_desc: [
		"&6Goal:&r Craft a 16K Item Storage Disk and place it in the drive.",
		"",
		"Item disks store many item types without chest-slot juggling.",
		"",
		"&6How:&r\n&e1.&r Craft the 16K Item Storage Disk (parts → housing → disk).\n&e2.&r Put the finished disk into an empty Disk Drive bay.\n&e3.&r Insert a few test items through a Grid (next) or by dropping into network importers later.",
		"",
		"&7Tip:&r Use a Disk Manipulator later to migrate contents between tiers safely.",
		"",
		"&7Next:&r Add a Storage Grid to browse the network."
	]
	quest.B100000000000149.title: "Storage Grid"
	quest.B100000000000149.quest_subtitle: "Access"
	quest.B100000000000149.quest_desc: [
		"&6Goal:&r Craft a Grid and connect it to the network.",
		"",
		"The Grid is the unified view of every disk and attached external inventory.",
		"",
		"&6How:&r\n&e1.&r Place the Grid on the RS cable network.\n&e2.&r Open it and search for an item you inserted onto disks.\n&e3.&r Pull and push items from this one screen instead of opening chests.",
		"",
		"&7Tip:&r Build the Crafting Grid next so stored ingredients are usable directly.",
		"",
		"&7Next:&r Upgrade to a Crafting Grid."
	]
	quest.B10000000000014A.title: "Crafting Grid + JEI"
	quest.B10000000000014A.quest_subtitle: "JEI addon"
	quest.B10000000000014A.quest_desc: [
		"&6Goal:&r Upgrade to a Crafting Grid.",
		"",
		"Craft from network storage in place — JEI can transfer recipes into this grid.",
		"",
		"&6How:&r\n&e1.&r Replace or place a Crafting Grid on the network.\n&e2.&r Open a JEI recipe and use the transfer button to pull ingredients from RS.\n&e3.&r Craft the result; leftovers return to network storage.",
		"",
		"&7Tip:&r Missing ingredients stay highlighted after transfer — fill those first.",
		"",
		"&7Next:&r Add fluid storage for liquids."
	]
	quest.B10000000000014B.title: "Fluid Storage"
	quest.B10000000000014B.quest_subtitle: "Fluids"
	quest.B10000000000014B.quest_desc: [
		"&6Goal:&r Craft a 4096B Fluid Storage Disk.",
		"",
		"RS 2 shows items and fluids in the same Grid — one place for buckets and tanks.",
		"",
		"&6How:&r\n&e1.&r Craft the fluid disk and slot it into a free Disk Drive bay.\n&e2.&r Insert filled buckets/containers via the Grid, or pipe fluids with importers later.\n&e3.&r Check the Grid fluid tab to confirm capacity.",
		"",
		"&7Tip:&r One bucket equals one bucket of disk capacity; reserve space before automating bulk liquids.",
		"",
		"&7Next:&r Expose Create vaults with External Storage."
	]
	quest.B10000000000014C.title: "Expose Create Storage"
	quest.B10000000000014C.quest_subtitle: "Create integration"
	quest.B10000000000014C.quest_desc: [
		"&6Goal:&r Craft &62 External Storage devices&r.",
		"",
		"Attach RS to Create Item Vaults, Functional Storage, chests, or tanks without copying contents onto disks.",
		"",
		"&6How:&r\n&e1.&r Place External Storage against the inventory or tank face you want to expose.\n&e2.&r Connect it to the RS cable network.\n&e3.&r Set priority so high-priority drawers receive bulk items before general disks.",
		"",
		"&7Tip:&r Use External Storage for visible Create tanks; keep disks for mixed junk.",
		"",
		"&7Next:&r Import factory output into the network."
	]
	quest.B10000000000014D.title: "Import Factory Output"
	quest.B10000000000014D.quest_subtitle: "Create integration"
	quest.B10000000000014D.quest_desc: [
		"&6Goal:&r Craft &62 Importers&r.",
		"",
		"Importers pull items or fluids from an adjacent inventory or tank into RS.",
		"",
		"&6How:&r\n&e1.&r Place an Importer on the output buffer of a Create line (chest, basin, tank).\n&e2.&r Connect it to cable and open the filter GUI.\n&e3.&r Whitelist outputs you want sucked in; add speed/stack upgrades for high throughput.",
		"",
		"&7Tip:&r Filter trash and loop materials so your network stays clean.",
		"",
		"&7Next:&r Export ingredients back to machines."
	]
	quest.B10000000000014E.title: "Export Ingredients"
	quest.B10000000000014E.quest_subtitle: "Create integration"
	quest.B10000000000014E.quest_desc: [
		"&6Goal:&r Craft &62 Exporters&r.",
		"",
		"Exporters keep selected items or fluids supplied to an adjacent machine or buffer.",
		"",
		"&6How:&r\n&e1.&r Place an Exporter on a machine, basin chest, deployer buffer, or Create tank.\n&e2.&r Configure the filter with the ingredients that machine needs.\n&e3.&r Add a regulator upgrade when you need an exact stock level instead of flooding.",
		"",
		"&7Tip:&r Pair exporters with Create funnels/arms for physical distribution.",
		"",
		"&7Next:&r Add Interfaces for outside automation hand-offs."
	]
	quest.B10000000000014F.title: "Factory Interface"
	quest.B10000000000014F.quest_subtitle: "Outside automation"
	quest.B10000000000014F.quest_desc: [
		"&6Goal:&r Craft &62 Interfaces&r.",
		"",
		"Interfaces expose filtered stock to Create funnels, chutes, arms, belts, and Pipez.",
		"",
		"&6How:&r\n&e1.&r Place an Interface on the cable network at a factory hand-off point.\n&e2.&r Configure export slots with items the physical line should pull.\n&e3.&r Point Create logistics at the Interface instead of digging into disk drives.",
		"",
		"&7Tip:&r Interfaces are the clean boundary between digital RS and physical Create logistics.",
		"",
		"&7Next:&r Unlock autocrafting with a Pattern Grid."
	]
	quest.B100000000000150.title: "Pattern Grid"
	quest.B100000000000150.quest_subtitle: "Autocrafting"
	quest.B100000000000150.quest_desc: [
		"&6Goal:&r Craft a Pattern Grid.",
		"",
		"Encode crafting and processing recipes onto patterns for autocrafting.",
		"",
		"&6How:&r\n&e1.&r Place the Pattern Grid on the network.\n&e2.&r Choose crafting mode for table recipes, or processing mode for machine steps.\n&e3.&r For Create: set inputs that leave the network and outputs you expect back.",
		"",
		"&7Tip:&r Use processing patterns for crushing, mixing, pressing, deploying, and sequenced assembly.",
		"",
		"&7Next:&r Craft blank Patterns and encode recipes."
	]
	quest.B100000000000151.title: "Encode Patterns"
	quest.B100000000000151.quest_subtitle: "Autocrafting"
	quest.B100000000000151.quest_desc: [
		"&6Goal:&r Craft &68 blank Patterns&r and encode useful recipes.",
		"",
		"Patterns are the recipes Autocrafters execute — start simple, then chain Create steps.",
		"",
		"&6How:&r\n&e1.&r Craft blank Patterns and open the Pattern Grid.\n&e2.&r Encode common components first (gears, sheets, casings).\n&e3.&r Encode one Create processing step and test it before chaining a long request.",
		"",
		"&7Tip:&r Put crafting patterns and processing patterns into the right Autocrafters.",
		"",
		"&7Next:&r Build Autocrafters to run those patterns."
	]
	quest.B100000000000152.title: "Autocrafter"
	quest.B100000000000152.quest_subtitle: "Autocrafting"
	quest.B100000000000152.quest_desc: [
		"&6Goal:&r Craft &62 Autocrafters&r.",
		"",
		"Autocrafters execute patterns — crafting in-world or sending processing jobs to machines.",
		"",
		"&6How:&r\n&e1.&r Place Autocrafters on the network and insert encoded patterns.\n&e2.&r For processing: Autocrafter pushes inputs out; route products back via an Interface or Importer.\n&e3.&r Request a craft from the Grid and watch the job complete end-to-end.",
		"",
		"&7Tip:&r The Autocrafter Manager helps organize large walls of patterns.",
		"",
		"&7Next:&r Go wireless with a Wireless Transmitter."
	]
	quest.B100000000000153.title: "Wireless Transmitter"
	quest.B100000000000153.quest_subtitle: "Wireless"
	quest.B100000000000153.quest_desc: [
		"&6Goal:&r Craft a Wireless Transmitter.",
		"",
		"Extends network access across your base for wireless grids and tools.",
		"",
		"&6How:&r\n&e1.&r Place the Wireless Transmitter on the cable network.\n&e2.&r Install range upgrades until coverage reaches your work areas.\n&e3.&r Keep the network powered — wireless still draws FE.",
		"",
		"&7Tip:&r Coverage is a sphere from the transmitter; raise it for multi-floor bases.",
		"",
		"&7Next:&r Link a Wireless Grid (Curios slot friendly)."
	]
	quest.B100000000000154.title: "Wireless Grid + Curios"
	quest.B100000000000154.quest_subtitle: "Curios addon"
	quest.B100000000000154.quest_desc: [
		"&6Goal:&r Craft and link a Wireless Grid.",
		"",
		"Portable network access — Curios adds a dedicated RS slot so it can travel equipped.",
		"",
		"&6How:&r\n&e1.&r Craft the Wireless Grid and a Network/Security Card if required by your version.\n&e2.&r Link it to your network (use the linking tool on the Controller or transmitter).\n&e3.&r Charge the grid, then equip it in its Curios slot for on-the-go access.",
		"",
		"&7Tip:&r Stay inside transmitter range or the wireless grid goes dark.",
		"",
		"&7Next:&r Scale capacity with Extra Disks."
	]
	quest.B100000000000155.title: "Extra Disks: 1024K"
	quest.B100000000000155.quest_subtitle: "Extra Disks addon"
	quest.B100000000000155.quest_desc: [
		"&6Goal:&r Craft a 1024K Item Storage Disk from Extra Disks.",
		"",
		"Extra Disks adds enormous item and fluid tiers for mature factories.",
		"",
		"&6How:&r\n&e1.&r Check JEI for the Extra Disks crafting chain (advanced parts + processors).\n&e2.&r Craft the 1024K disk and insert it into a Disk Drive bay.\n&e3.&r Migrate bulk stock from smaller disks with a Disk Manipulator when ready.",
		"",
		"&7Tip:&r Withering processors gate the highest tiers behind Nether progression.",
		"",
		"&7Next:&r Speed up logistics with Advanced Importers."
	]
	quest.B100000000000156.title: "Advanced Importer"
	quest.B100000000000156.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000156.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's Advanced Importer.",
		"",
		"Larger filters and higher throughput suit multi-output Create farms.",
		"",
		"&6How:&r\n&e1.&r Replace a busy Importer with the Advanced Importer on the output buffer.\n&e2.&r Fill the expanded filter with every product that line produces.\n&e3.&r Add upgrades and confirm nothing valuable loops back into the wrong chest.",
		"",
		"&7Tip:&r Filter explicitly — advanced speed without filters will vacuum everything.",
		"",
		"&7Next:&r Stock inputs with an Advanced Exporter."
	]
	quest.B100000000000157.title: "Advanced Exporter"
	quest.B100000000000157.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000157.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's Advanced Exporter.",
		"",
		"Expanded filters stock several ingredients at a shared factory input buffer.",
		"",
		"&6How:&r\n&e1.&r Place the Advanced Exporter on a shared Create input chest or basin buffer.\n&e2.&r List every ingredient that buffer should keep stocked.\n&e3.&r Use a belt or mechanical arm to distribute those items to machines.",
		"",
		"&7Tip:&r Regulator upgrades prevent overfilling shared buffers.",
		"",
		"&7Next:&r Upgrade autocrafting with a Netherite Crafter."
	]
	quest.B100000000000158.title: "Netherite Crafter"
	quest.B100000000000158.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000158.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's Netherite Crafter.",
		"",
		"Top-tier crafter: more patterns and faster requests for a dense pattern hall.",
		"",
		"&6How:&r\n&e1.&r Place the Netherite Crafter on the autocrafting wall.\n&e2.&r Move high-traffic patterns into it from slower Autocrafters.\n&e3.&r Spread processing recipes across crafters when several Create lines can run in parallel.",
		"",
		"&7Tip:&r Parallel Create lines need parallel crafters — one block is not a whole factory.",
		"",
		"&7Next:&r Cap fluid storage with a million-bucket disk."
	]
	quest.B100000000000159.title: "Million-Bucket Fluid Disk"
	quest.B100000000000159.quest_subtitle: "ExtraStorage addon"
	quest.B100000000000159.quest_desc: [
		"&6Goal:&r Craft ExtraStorage's 1,048,576B Fluid Storage Disk.",
		"",
		"Endgame tank capacity for diesel, liquid XP, chocolate, honey, lava, and more.",
		"",
		"&6How:&r\n&e1.&r Craft the mega fluid disk via ExtraStorage recipes.\n&e2.&r Install it in a Disk Drive and verify the Grid fluid capacity.\n&e3.&r Point fluid importers/exporters at factory liquids you want digitized.",
		"",
		"&7Tip:&r External Storage is still better when you want fluids visibly stored in Create tanks.",
		"",
		"&7Next:&r Your RS hub is complete — grow patterns and power as the factory expands."
	]
	quest.B1000000000001A8.title: "Dielectric Beginnings"
	quest.B1000000000001A8.quest_subtitle: "Powah · Materials"
	quest.B1000000000001A8.quest_desc: [
		"&6Goal:&r Craft &616 Dielectric Paste&r.",
		"",
		"Powah uses dielectric paste, rods, and casings throughout every generator and storage tier.",
		"",
		"&6How:&r\n&e1.&r Check JEI for Dielectric Paste ingredients (clay, silicon/lava variants by pack recipe).\n&e2.&r Craft a batch of 16+ paste.\n&e3.&r Keep a drawer stocked — upgrading machines repeatedly consumes plenty.",
		"",
		"&7Tip:&r Cook or craft paste in batches before the generator rush.",
		"",
		"&7Next:&r Build a Starter Furnator for first FE.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Brass Age\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000DF\"}}"
	]
	quest.B1000000000001A9.title: "Starter Furnator"
	quest.B1000000000001A9.quest_subtitle: "Powah · Generation"
	quest.B1000000000001A9.quest_desc: [
		"&6Goal:&r Craft a Starter Furnator.",
		"",
		"Burn solid fuel for your first independent FE supply — enough to bootstrap RS and the Energizing Orb.",
		"",
		"&6How:&r\n&e1.&r Place the Furnator near your early power room.\n&e2.&r Open the GUI and insert coal/charcoal (or other solid fuel).\n&e3.&r Set the energy output side, or connect a Powah energy cable to that face.",
		"",
		"&7Tip:&r A small Energy Cell next door absorbs spikes so the Furnator keeps burning.",
		"",
		"&7Next:&r Run Starter Energy Cables."
	]
	quest.B1000000000001AA.title: "Starter Energy Cables"
	quest.B1000000000001AA.quest_subtitle: "Powah · Transfer"
	quest.B1000000000001AA.quest_desc: [
		"&6Goal:&r Craft &616 Starter Energy Cables&r.",
		"",
		"Powah cables move FE between generators, cells, RS controllers, chargers, and Create electrical machines.",
		"",
		"&6How:&r\n&e1.&r Place cable from the Furnator toward machines that need FE.\n&e2.&r Connect the RS Controller and any chargers on the same bus.\n&e3.&r Upgrade cable tier later when transfer rate becomes the bottleneck.",
		"",
		"&7Tip:&r Color-code or separate buses if you mix low-tier and Nitro gear later.",
		"",
		"&7Next:&r Add a Starter Energy Cell buffer."
	]
	quest.B1000000000001AB.title: "Starter Energy Cell"
	quest.B1000000000001AB.quest_subtitle: "Powah · Storage"
	quest.B1000000000001AB.quest_desc: [
		"&6Goal:&r Craft a Starter Energy Cell.",
		"",
		"Cells buffer generation so machines survive demand spikes and generators keep working between jobs.",
		"",
		"&6How:&r\n&e1.&r Place the Energy Cell between generation and the factory bus.\n&e2.&r Cable generators into the cell, then cable the cell out to consumers.\n&e3.&r Watch the fill bar under load — if it empties, add generation before more machines.",
		"",
		"&7Tip:&r Storage between generation and demand is the difference between brownouts and smooth FE.",
		"",
		"&7Next:&r Add Thermo, Magmator, or Solar — then the Energizing Orb."
	]
	quest.B1000000000001AC.title: "Thermo Generator"
	quest.B1000000000001AC.quest_subtitle: "Powah · Generation"
	quest.B1000000000001AC.quest_desc: [
		"&6Goal:&r Craft a Starter Thermo Generator.",
		"",
		"Passive, fuel-free FE from heat + water — great baseline under the factory.",
		"",
		"&6How:&r\n&e1.&r Place a hot block (magma, lava, blaze burner heat, etc.) under or against the generator per JEI rules.\n&e2.&r Place the Thermo Generator above/on that heat source.\n&e3.&r Supply water (sink, Create tank, or bucket loop) and cable FE out to your cell.",
		"",
		"&7Tip:&r Better heat sources improve output — upgrade the heat, not only the generator tier.",
		"",
		"&7Next:&r Add Magmator and/or Solar for more generation."
	]
	quest.B1000000000001AD.title: "Magmator"
	quest.B1000000000001AD.quest_subtitle: "Powah · Generation"
	quest.B1000000000001AD.quest_desc: [
		"&6Goal:&r Craft a Starter Magmator.",
		"",
		"Consumes lava for steady power — excellent with Create hose pulleys and train-delivered lava.",
		"",
		"&6How:&r\n&e1.&r Place the Magmator and cable it to your Energy Cell.\n&e2.&r Buffer lava in a Create Fluid Tank or tank cart.\n&e3.&r Pipe or hose-pulley lava into the Magmator fluid input, then confirm FE output.",
		"",
		"&7Tip:&r Never starve the Magmator of lava mid-spike — keep a tank buffer.",
		"",
		"&7Next:&r Solar for daytime surplus, or jump to the Energizing Orb."
	]
	quest.B1000000000001AE.title: "Solar Panel"
	quest.B1000000000001AE.quest_subtitle: "Powah · Generation"
	quest.B1000000000001AE.quest_desc: [
		"&6Goal:&r Craft a Starter Solar Panel.",
		"",
		"Free daytime power with clear sky access — combine sources rather than relying on one generator.",
		"",
		"&6How:&r\n&e1.&r Place Solar Panels on a roof or open sky platform (no opaque blocks above).\n&e2.&r Cable them into your Energy Cell bus.\n&e3.&r Let daytime surplus fill the cell for overnight use.",
		"",
		"&7Tip:&r Rain and night cut solar — keep Magmator/Thermo as baseline.",
		"",
		"&7Next:&r Build the Energizing Orb when your buffer is healthy."
	]
	quest.B1000000000001AF.title: "Energizing Orb"
	quest.B1000000000001AF.quest_subtitle: "Powah · Energizing"
	quest.B1000000000001AF.quest_desc: [
		"&6Goal:&r Craft an Energizing Orb.",
		"",
		"The Orb turns ordinary materials into Powah's tier crystals when Energizing Rods supply enough FE.",
		"",
		"&6How:&r\n&e1.&r Place the Orb with clear air around it for rod line-of-sight.\n&e2.&r Leave space on several sides for Energizing Rods to aim at the Orb.\n&e3.&r Plan item I/O with Create funnels, arms, Pipez, or RS interfaces.",
		"",
		"&7Tip:&r The Orb itself does not pull FE — rods do. Build rods next.",
		"",
		"&7Next:&r Craft Starter Energizing Rods and aim them at the Orb."
	]
	quest.B1000000000001B0.title: "Energizing Rod"
	quest.B1000000000001B0.quest_subtitle: "Powah · Energizing"
	quest.B1000000000001B0.quest_desc: [
		"&6Goal:&r Craft &62 Starter Energizing Rods&r.",
		"",
		"Rods beam FE into the Orb — more and better rods finish recipes faster.",
		"",
		"&6How:&r\n&e1.&r Place rods with an unobstructed line of sight to the Energizing Orb.\n&e2.&r Rotate/adjust each rod so it faces the Orb (check the beam in-world).\n&e3.&r Cable every rod to the same buffered power network as your generators.",
		"",
		"&7Tip:&r If energizing stalls, add rods or upgrade generation — not just the Orb.",
		"",
		"&7Next:&r Produce Energized Steel as your first tier material."
	]
	quest.B1000000000001B1.title: "Energized Steel"
	quest.B1000000000001B1.quest_subtitle: "Powah · Tier: Basic"
	quest.B1000000000001B1.quest_desc: [
		"&6Goal:&r Produce &68 Energized Steel&r.",
		"",
		"First energized material — unlocks Basic-tier generators, cables, cells, batteries, and wireless devices.",
		"",
		"&6How:&r\n&e1.&r Check JEI for the Energizing Orb recipe (iron/steel + FE cost).\n&e2.&r Drop ingredients into the Orb (or funnel them in).\n&e3.&r Wait for rods to finish the energize, then pull Energized Steel out.",
		"",
		"&7Tip:&r Encode the Orb recipe in Refined Storage once processing autocrafting is ready.",
		"",
		"&7Next:&r Climb Blazing → Niotic → Spirited → Nitro crystals."
	]
	quest.B1000000000001B2.title: "Blazing Crystal"
	quest.B1000000000001B2.quest_subtitle: "Powah · Tier: Blazing"
	quest.B1000000000001B2.quest_desc: [
		"&6Goal:&r Produce &68 Blazing Crystals&r.",
		"",
		"Blazing tier raises generation, capacity, and transfer with Nether materials.",
		"",
		"&6How:&r\n&e1.&r Gather blaze products (rods/powder) via farm or bulk processing.\n&e2.&r Energize the JEI recipe in the Orb with enough rod power.\n&e3.&r Upgrade key generators/cables/cells to Blazing when you need the rate.",
		"",
		"&7Tip:&r Keep blaze automated with a Create farm or bulk processing line.",
		"",
		"&7Next:&r Niotic crystals for diamond-tier power."
	]
	quest.B1000000000001B3.title: "Niotic Crystal"
	quest.B1000000000001B3.quest_subtitle: "Powah · Tier: Niotic"
	quest.B1000000000001B3.quest_desc: [
		"&6Goal:&r Produce &68 Niotic Crystals&r.",
		"",
		"Niotic uses diamonds and marks the jump into serious factory-scale FE.",
		"",
		"&6How:&r\n&e1.&r Stock diamonds and check the Orb energizing cost in JEI.\n&e2.&r Run the Orb only when your Energy Cell can afford the spike.\n&e3.&r Upgrade generator, cell, and cable tiers together so one piece is not the bottleneck.",
		"",
		"&7Tip:&r Upgrade bottlenecks together: generator, cell, and cable throughput.",
		"",
		"&7Next:&r Spirited crystals next."
	]
	quest.B1000000000001B4.title: "Spirited Crystal"
	quest.B1000000000001B4.quest_subtitle: "Powah · Tier: Spirited"
	quest.B1000000000001B4.quest_desc: [
		"&6Goal:&r Produce &68 Spirited Crystals&r.",
		"",
		"Emerald-heavy late-game step suited to large RS autocrafting networks.",
		"",
		"&6How:&r\n&e1.&r Gather emeralds (villager trades or mining) before starting the batch.\n&e2.&r Energize in the Orb with upgraded rods and a fat FE buffer.\n&e3.&r Only upgrade machines whose capacity or rate you actually need.",
		"",
		"&7Tip:&r Skip upgrading decorative chargers — spend Spirited on generation and transfer.",
		"",
		"&7Next:&r Nitro crystals for top survival tier."
	]
	quest.B1000000000001B5.title: "Nitro Crystal"
	quest.B1000000000001B5.quest_subtitle: "Powah · Tier: Nitro"
	quest.B1000000000001B5.quest_desc: [
		"&6Goal:&r Produce &64 Nitro Crystals&r.",
		"",
		"Nitro is Powah's top survival tier — Nether Stars plus a major FE investment.",
		"",
		"&6How:&r\n&e1.&r Defeat the Wither (or stock Nether Stars) before committing.\n&e2.&r Buffer a reactor-scale Energy Cell so energizing does not brown out the base.\n&e3.&r Energize Nitro in the Orb, then craft Nitro generators/cables as needed.",
		"",
		"&7Tip:&r A buffered reactor network prevents energizing from starving RS autocrafting.",
		"",
		"&7Next:&r Build toward a Nitro Reactor."
	]
	quest.B1000000000001B6.title: "Uraninite Supply"
	quest.B1000000000001B6.quest_subtitle: "Powah · Reactors"
	quest.B1000000000001B6.quest_desc: [
		"&6Goal:&r Process &616 Uraninite&r.",
		"",
		"Uraninite fuels Powah reactors — stock it before assembling sustained reactor power.",
		"",
		"&6How:&r\n&e1.&r Mine uraninite ore (check JEI worldgen heights).\n&e2.&r Smelt or energize it into usable Uraninite per JEI.\n&e3.&r Also stock coal, redstone, water, and dry ice — reactors want supporting inputs.",
		"",
		"&7Tip:&r Automate ore → Uraninite before you rely on reactor uptime.",
		"",
		"&7Next:&r Assemble a Starter Reactor."
	]
	quest.B1000000000001B7.title: "Starter Reactor"
	quest.B1000000000001B7.quest_subtitle: "Powah · Reactors"
	quest.B1000000000001B7.quest_desc: [
		"&6Goal:&r Craft and assemble a Starter Reactor.",
		"",
		"Compact continuous FE from uraninite and supporting resources.",
		"",
		"&6How:&r\n&e1.&r Craft reactor blocks and place the multiblock/assembly per JEI or in-world guide.\n&e2.&r Pipe in Uraninite plus required coolants/fuels before enabling full production.\n&e3.&r Cable reactor output through an Energy Cell, not straight into hungry machines.",
		"",
		"&7Tip:&r Automate each consumable — a dry reactor is just expensive décor.",
		"",
		"&7Next:&r Climb reactor tiers toward Nitro."
	]
	quest.B1000000000001B8.title: "Nitro Reactor"
	quest.B1000000000001B8.quest_subtitle: "Powah · Reactors"
	quest.B1000000000001B8.quest_desc: [
		"&6Goal:&r Upgrade all the way to a Nitro Reactor.",
		"",
		"Endgame Powah generator — enormous output for RS, jetpacks, and electric Create factories.",
		"",
		"&6How:&r\n&e1.&r Craft Nitro-tier reactor components with Nitro crystals and high-end materials.\n&e2.&r Rebuild or upgrade the reactor assembly to Nitro.\n&e3.&r Verify automated fuel/cooling and watch real FE/t into your buffer under full load.",
		"",
		"&7Tip:&r Huge theoretical output is useless without automated supply — monitor fuel first.",
		"",
		"&7Next:&r Wireless FE via Ender Cells and Player Transmitters."
	]
	quest.B1000000000001B9.title: "Ender Cell"
	quest.B1000000000001B9.quest_subtitle: "Powah · Wireless network"
	quest.B1000000000001B9.quest_desc: [
		"&6Goal:&r Craft a Starter Ender Cell.",
		"",
		"Frequency-based wireless energy storage shared by linked Ender Gates.",
		"",
		"&6How:&r\n&e1.&r Place the Ender Cell and cable FE into it from your main generation.\n&e2.&r Open the GUI and set a channel/frequency name for this network.\n&e3.&r Use separate channels for public infrastructure vs critical machines.",
		"",
		"&7Tip:&r Name channels clearly — “Factory”, “Quarry”, “Dims” beats “1”.",
		"",
		"&7Next:&r Attach Ender Gates at distant machines."
	]
	quest.B1000000000001BA.title: "Ender Gate"
	quest.B1000000000001BA.quest_subtitle: "Powah · Wireless network"
	quest.B1000000000001BA.quest_desc: [
		"&6Goal:&r Craft &62 Starter Ender Gates&r.",
		"",
		"Cable-free FE access for distant machines through the selected Ender Cell channel.",
		"",
		"&6How:&r\n&e1.&r Place a gate on (or beside) a remote machine that needs power.\n&e2.&r Set the gate to the same channel as your Ender Cell.\n&e3.&r Confirm transfer; upgrade gate tier if the transfer limit caps your machine.",
		"",
		"&7Tip:&r A gate's transfer limit still depends on its tier — upgrade hungry endpoints.",
		"",
		"&7Next:&r Add a Player Transmitter for on-person charging."
	]
	quest.B1000000000001BB.title: "Player Transmitter"
	quest.B1000000000001BB.quest_subtitle: "Powah · Wireless charging"
	quest.B1000000000001BB.quest_desc: [
		"&6Goal:&r Craft a Starter Player Transmitter.",
		"",
		"Wireless charging for carried equipment — especially Iron Jetpacks and Powah batteries.",
		"",
		"&6How:&r\n&e1.&r Place the Player Transmitter and cable it to a strong FE supply.\n&e2.&r Bind yourself with the player binding card / GUI binding.\n&e3.&r Carry a battery or jetpack and walk in range to confirm charge rate.",
		"",
		"&7Tip:&r No bind + no FE = a fancy lamp. Bind and power it before long trips.",
		"",
		"&7Next:&r Craft a Portable Battery to test the link."
	]
	quest.B1000000000001BC.title: "Portable Battery"
	quest.B1000000000001BC.quest_subtitle: "Powah · Wireless charging"
	quest.B1000000000001BC.quest_desc: [
		"&6Goal:&r Craft a Starter Battery.",
		"",
		"Carries FE between jobs and is a simple test item for your Player Transmitter.",
		"",
		"&6How:&r\n&e1.&r Craft the battery and keep it in your inventory or Curios/hotbar as needed.\n&e2.&r Stand near the Player Transmitter and watch charge climb.\n&e3.&r Upgrade battery tier alongside wireless charging rate and equipment demand.",
		"",
		"&7Tip:&r Nitro batteries + Nitro transmitters keep jetpacks aloft all day.",
		"",
		"&7Next:&r Powah chapter complete — feed Flux Networks or RS from this grid."
	]
	quest.B1000000000001BD.title: "RFTools Framework"
	quest.B1000000000001BD.quest_subtitle: "RFTools · Foundation"
	quest.B1000000000001BD.quest_desc: [
		"&6Goal:&r Craft &64 RFTools Machine Frames&r.",
		"",
		"Machine Frames are the common chassis for the entire RFTools suite.",
		"",
		"&6How:&r\n&e1.&r Gather iron and the other JEI ingredients for Machine Frames.\n&e2.&r Craft at least four frames to start Power, Utility, and Storage branches.\n&e3.&r Stock extras in Refined Storage — nearly every branch consumes them.",
		"",
		"&7Tip:&r Batch frames once; rebuilding every machine from scratch hurts.",
		"",
		"&7Next:&r Craft a Smart Wrench before placing machines.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Starter Energy Cell\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000001AB\"}}"
	]
	quest.B1000000000001BE.title: "Smart Wrench"
	quest.B1000000000001BE.quest_subtitle: "RFTools · Tools"
	quest.B1000000000001BE.quest_desc: [
		"&6Goal:&r Craft an RFTools Smart Wrench.",
		"",
		"Rotates, configures, links, and safely moves RFTools setups.",
		"",
		"&6How:&r\n&e1.&r Craft the Smart Wrench and keep it on your hotbar.\n&e2.&r Sneak-click / mode-cycle to switch rotate vs pick-up modes as needed.\n&e3.&r Use it when placing machines whose facing or card links matter.",
		"",
		"&7Tip:&r Pick up machines with the wrench to keep modules and settings intact.",
		"",
		"&7Next:&r Optional: Coal Generator, or jump into crafters/screens from frames."
	]
	quest.B1000000000001BF.title: "Coal Generator"
	quest.B1000000000001BF.quest_subtitle: "RFTools · Power"
	quest.B1000000000001BF.quest_desc: [
		"&6Goal:&r Craft an RFTools Coal Generator.",
		"",
		"Compact fallback FE and a clear intro to RFTools Power — Powah still handles serious generation.",
		"",
		"&6How:&r\n&e1.&r Place the Coal Generator near a Power Cell.\n&e2.&r Insert coal and cable FE into your RFTools/Powah bus.\n&e3.&r Use it as backup, not as your only base generator.",
		"",
		"&7Tip:&r Feed the same power bus as Powah so tools and cells share one buffer.",
		"",
		"&7Next:&r Craft a Level 1 Power Cell."
	]
	quest.B1000000000001C0.title: "Power Cell"
	quest.B1000000000001C0.quest_subtitle: "RFTools · Power"
	quest.B1000000000001C0.quest_desc: [
		"&6Goal:&r Craft a Level 1 Power Cell.",
		"",
		"Buffers FE locally and can grow into linked power networks with cards.",
		"",
		"&6How:&r\n&e1.&r Place the Power Cell beside bursty machines (crafters, teleporters).\n&e2.&r Cable generation in and consumers out; note input/output faces in the GUI.\n&e3.&r Upgrade or link cells later instead of starring every machine to live gen.",
		"",
		"&7Tip:&r Local buffers keep cable demand smooth under teleport spikes.",
		"",
		"&7Next:&r Craft a Powercell Card to link cells."
	]
	quest.B1000000000001C1.title: "Powercell Card"
	quest.B1000000000001C1.quest_subtitle: "RFTools · Power networking"
	quest.B1000000000001C1.quest_desc: [
		"&6Goal:&r Craft a Powercell Card.",
		"",
		"Cards link compatible RFTools power cells and dimensional cells into a shared network.",
		"",
		"&6How:&r\n&e1.&r Craft the card and open a Power Cell GUI.\n&e2.&r Insert matching cards (or link per GUI instructions) on every cell that should share FE.\n&e3.&r Name cards/networks by purpose — Factory, Dims, Backup.",
		"",
		"&7Tip:&r Mismatched or blank names cause accidental cross-wiring on multiplayer.",
		"",
		"&7Next:&r Add a Dimensional Cell for cross-dimension FE."
	]
	quest.B1000000000001C2.title: "Dimensional Cell"
	quest.B1000000000001C2.quest_subtitle: "RFTools · Power networking"
	quest.B1000000000001C2.quest_desc: [
		"&6Goal:&r Craft a Dimensional Cell.",
		"",
		"Moves FE across distance and dimensions without running physical cables.",
		"",
		"&6How:&r\n&e1.&r Place a Dimensional Cell in the overworld next to your main buffer.\n&e2.&r Link it with a Powercell Card to the same network as your Power Cells.\n&e3.&r Place another linked cell in remote bases or future dimensions; charge from Powah.",
		"",
		"&7Tip:&r Use Powah generation to charge the network that supports teleporters and dimensions.",
		"",
		"&7Next:&r Matter Transmitters need this kind of reliable FE."
	]
	quest.B1000000000001C3.title: "Automated Crafter"
	quest.B1000000000001C3.quest_subtitle: "RFTools · Automation"
	quest.B1000000000001C3.quest_desc: [
		"&6Goal:&r Craft a Tier 1 RFTools Crafter.",
		"",
		"Continuously processes buffered recipes — compact material loops beside Create lines.",
		"",
		"&6How:&r\n&e1.&r Place the Crafter and power it with FE.\n&e2.&r Open the GUI, set a recipe, and define input/output sides.\n&e3.&r Pipe ingredients in with Create or Pipez; export results to Refined Storage.",
		"",
		"&7Tip:&r Start with one high-volume craft (plates, gears) before multi-recipe setups.",
		"",
		"&7Next:&r Upgrade to Tier 3 for multi-recipe crafting."
	]
	quest.B1000000000001C4.title: "Tier 3 Crafter"
	quest.B1000000000001C4.quest_subtitle: "RFTools · Automation"
	quest.B1000000000001C4.quest_desc: [
		"&6Goal:&r Upgrade to a Tier 3 RFTools Crafter.",
		"",
		"Handles many recipes in one block and can retain intermediates internally.",
		"",
		"&6How:&r\n&e1.&r Craft/upgrade to Crafter Tier 3 and reinstall your recipes.\n&e2.&r Enable remembered/internal buffers only for steps that need them.\n&e3.&r Watch for recipe loops — disable retain on outputs that re-enter as inputs.",
		"",
		"&7Tip:&r Use remembered outputs carefully to prevent clogging loops.",
		"",
		"&7Next:&r Build Screens to monitor the factory."
	]
	quest.B1000000000001C5.title: "Information Screen"
	quest.B1000000000001C5.quest_subtitle: "RFTools · Monitoring"
	quest.B1000000000001C5.quest_desc: [
		"&6Goal:&r Craft an RFTools Screen.",
		"",
		"Presents power, inventory, fluid, machine, and text data through installable modules.",
		"",
		"&6How:&r\n&e1.&r Place the Screen on a wall in your control room.\n&e2.&r Craft the module that matches what you need (energy, fluid, inventory, etc.).\n&e3.&r Install the module and link it to the target machine or cell with the wrench/GUI.",
		"",
		"&7Tip:&r Build modules for systems you actually monitor — empty screens are just art.",
		"",
		"&7Next:&r Add a Screen Controller for powered dashboards."
	]
	quest.B1000000000001C6.title: "Screen Controller"
	quest.B1000000000001C6.quest_subtitle: "RFTools · Monitoring"
	quest.B1000000000001C6.quest_desc: [
		"&6Goal:&r Craft a Screen Controller.",
		"",
		"Supplies power and data to nearby screens for a clean factory dashboard.",
		"",
		"&6How:&r\n&e1.&r Place the Screen Controller within range of your Screens.\n&e2.&r Cable FE into the controller.\n&e3.&r Confirm screens update; expand the room only within controller range.",
		"",
		"&7Tip:&r Keep range and FE use in mind — huge control rooms need power and proximity.",
		"",
		"&7Next:&r Add a Power Monitor for redstone thresholds."
	]
	quest.B1000000000001C7.title: "Power Monitor"
	quest.B1000000000001C7.quest_subtitle: "RFTools · Monitoring"
	quest.B1000000000001C7.quest_desc: [
		"&6Goal:&r Craft a Power Monitor.",
		"",
		"Watches stored energy and emits redstone at useful thresholds before brownouts.",
		"",
		"&6How:&r\n&e1.&r Place the Power Monitor near your main Power/Dimensional Cell.\n&e2.&r Link it to the cell and set low/high thresholds in the GUI.\n&e3.&r Wire the redstone signal to backup Powah generators or nonessential shutoffs.",
		"",
		"&7Tip:&r A low-power signal that starts Magmators beats discovering a dead RS network.",
		"",
		"&7Next:&r With power solid, build Matter Transmitters."
	]
	quest.B1000000000001C8.title: "Matter Transmitter"
	quest.B1000000000001C8.quest_subtitle: "RFTools · Teleportation"
	quest.B1000000000001C8.quest_desc: [
		"&6Goal:&r Craft a Matter Transmitter.",
		"",
		"Sends players to linked receivers — the travel backbone for RFTools Dimensions.",
		"",
		"&6How:&r\n&e1.&r Place the Matter Transmitter on a safe pad with clear standing space.\n&e2.&r Cable a large FE buffer into it (Dimensional Cell recommended).\n&e3.&r Do not dial destinations until a powered receiver exists.",
		"",
		"&7Tip:&r Teleportation needs buffered FE — never trust live generation alone.",
		"",
		"&7Next:&r Craft a Matter Receiver destination."
	]
	quest.B1000000000001C9.title: "Matter Receiver"
	quest.B1000000000001C9.quest_subtitle: "RFTools · Teleportation"
	quest.B1000000000001C9.quest_desc: [
		"&6Goal:&r Craft a Matter Receiver.",
		"",
		"Creates a destination for transmitters, including in distant or custom dimensions.",
		"",
		"&6How:&r\n&e1.&r Place the receiver at the destination with clear landing space.\n&e2.&r Power it and protect the area (lighting, walls, no lava pits).\n&e3.&r Note its name/location for the Dialing Device.",
		"",
		"&7Tip:&r Power and protect the destination before dialing it.",
		"",
		"&7Next:&r Link routes with a Dialing Device."
	]
	quest.B1000000000001CA.title: "Dialing Device"
	quest.B1000000000001CA.quest_subtitle: "RFTools · Teleportation"
	quest.B1000000000001CA.quest_desc: [
		"&6Goal:&r Craft a Dialing Device.",
		"",
		"Discovers nearby transmitters and receivers and connects the selected route.",
		"",
		"&6How:&r\n&e1.&r Place the Dialing Device near your Matter Transmitter.\n&e2.&r Open it, select transmitter → receiver, and dial the route.\n&e3.&r Give destinations clear names so travel stays safe and predictable.",
		"",
		"&7Tip:&r Rename “Receiver” to “Factory / Mining / Dim Hub” before you have twelve of them.",
		"",
		"&7Next:&r Optional utility: Environmental Controller — then Dimensions path."
	]
	quest.B1000000000001CB.title: "Environmental Controller"
	quest.B1000000000001CB.quest_subtitle: "RFTools · Utility"
	quest.B1000000000001CB.quest_desc: [
		"&6Goal:&r Craft an Environmental Controller.",
		"",
		"With modules installed, applies useful effects across a configurable area.",
		"",
		"&6How:&r\n&e1.&r Place and power the Environmental Controller in the target area.\n&e2.&r Craft and insert modules (regen, flight, haste, etc. per JEI).\n&e3.&r Set radius and filters; measure FE cost before expanding range.",
		"",
		"&7Tip:&r Ongoing FE cost rises with range and modules — start small.",
		"",
		"&7Next:&r Storage Scanner branch for local inventory access."
	]
	quest.B1000000000001CC.title: "Storage Module"
	quest.B1000000000001CC.quest_subtitle: "RFTools · Storage"
	quest.B1000000000001CC.quest_desc: [
		"&6Goal:&r Craft a Tier 1 Storage Module.",
		"",
		"Storage Modules set the capacity of Modular Storage blocks.",
		"",
		"&6How:&r\n&e1.&r Craft the Tier 1 Storage Module.\n&e2.&r Keep higher-tier modules for later capacity upgrades.\n&e3.&r Treat this as complementary local storage — bulk searchable stock stays in RS.",
		"",
		"&7Tip:&r Modules are swappable — upgrade capacity without rebuilding the block.",
		"",
		"&7Next:&r Install it in Modular Storage."
	]
	quest.B1000000000001CD.title: "Modular Storage"
	quest.B1000000000001CD.quest_subtitle: "RFTools · Storage"
	quest.B1000000000001CD.quest_desc: [
		"&6Goal:&r Craft Modular Storage and install your module.",
		"",
		"One compact block exposes the module's inventory with filtering and a convenient UI.",
		"",
		"&6How:&r\n&e1.&r Place Modular Storage at a work cell.\n&e2.&r Insert the Storage Module in the GUI.\n&e3.&r Configure filters so this inventory stays separate from the main RS network.",
		"",
		"&7Tip:&r Great for work-cell kits that should not dump into digital storage.",
		"",
		"&7Next:&r Scan nearby inventories with a Storage Scanner."
	]
	quest.B1000000000001CE.title: "Storage Scanner"
	quest.B1000000000001CE.quest_subtitle: "RFTools · Storage"
	quest.B1000000000001CE.quest_desc: [
		"&6Goal:&r Craft a Storage Scanner.",
		"",
		"Searches and accesses nearby inventories from one interface without replacing them.",
		"",
		"&6How:&r\n&e1.&r Place the Storage Scanner near Create vaults, chests, and Modular Storage.\n&e2.&r Power it and scan/radius-configure until target inventories appear.\n&e3.&r Pull and push items from the scanner UI; keep global stock in RS.",
		"",
		"&7Tip:&r Scan Create vaults and local chests — RS remains pack-wide storage.",
		"",
		"&7Next:&r Craft a Storage Scanner Tablet for remote access."
	]
	quest.B1000000000001CF.title: "Remote Storage Tablet"
	quest.B1000000000001CF.quest_subtitle: "RFTools · Storage"
	quest.B1000000000001CF.quest_desc: [
		"&6Goal:&r Craft a Storage Scanner Tablet.",
		"",
		"Portable access to a linked scanner when it has power and connectivity.",
		"",
		"&6How:&r\n&e1.&r Craft the tablet and link it to your Storage Scanner.\n&e2.&r Keep the tablet charged (Powah Player Transmitter works well).\n&e3.&r Open it in the field to pull from the linked scanner inventories.",
		"",
		"&7Tip:&r Charge before expeditions — a dead tablet is a fancy brick.",
		"",
		"&7Next:&r Optional Crafting Manager, then Dimensions."
	]
	quest.B1000000000001D0.title: "Crafting Manager"
	quest.B1000000000001D0.quest_subtitle: "RFTools · Storage automation"
	quest.B1000000000001D0.quest_desc: [
		"&6Goal:&r Craft an RFTools Crafting Manager.",
		"",
		"Coordinates RFTools storage and crafting resources from a central interface.",
		"",
		"&6How:&r\n&e1.&r Place the Crafting Manager near Modular Storage and crafters.\n&e2.&r Link storage/crafting resources in its GUI.\n&e3.&r Use it for self-contained production cells; keep pack-wide autocrafting in RS.",
		"",
		"&7Tip:&r RFTools crafting cells complement RS — they do not replace pattern halls.",
		"",
		"&7Next:&r Collect Dimensional Shards for custom worlds."
	]
	quest.B1000000000001D1.title: "Dimensional Shards"
	quest.B1000000000001D1.quest_subtitle: "RFTools · Dimensions"
	quest.B1000000000001D1.quest_desc: [
		"&6Goal:&r Collect &68 Dimensional Shards&r.",
		"",
		"Rare materials that gate advanced RFTools machinery and the custom-dimension path.",
		"",
		"&6How:&r\n&e1.&r Check JEI's ore-height display and dimension sources.\n&e2.&r Mine or process shards until you have eight.\n&e3.&r Store them for the Dimlet Workbench chain.",
		"",
		"&7Tip:&r Bring a Waystone and FE tools — shard hunts are long trips.",
		"",
		"&7Next:&r Craft a Dimlet Workbench."
	]
	quest.B1000000000001D2.title: "Dimlet Workbench"
	quest.B1000000000001D2.quest_subtitle: "RFTools · Dimensions"
	quest.B1000000000001D2.quest_desc: [
		"&6Goal:&r Craft a Dimlet Workbench.",
		"",
		"Assembles researched parts into dimlets that describe terrain, biomes, blocks, and features.",
		"",
		"&6How:&r\n&e1.&r Place and power the Dimlet Workbench.\n&e2.&r Craft or research dimlet parts, then assemble a simple low-cost world dimlet set.\n&e3.&r Avoid stacking expensive effects on your first world.",
		"",
		"&7Tip:&r Start simple — a boring safe world beats an unstable expensive one.",
		"",
		"&7Next:&r Research knowledge with a Dimlet Researcher."
	]
	quest.B1000000000001D3.title: "Dimlet Researcher"
	quest.B1000000000001D3.quest_subtitle: "RFTools · Dimensions"
	quest.B1000000000001D3.quest_desc: [
		"&6Goal:&r Craft a Dimlet Researcher.",
		"",
		"Turns lost knowledge into usable information for building custom dimlets.",
		"",
		"&6How:&r\n&e1.&r Place the Researcher and supply FE.\n&e2.&r Insert researchable knowledge items per JEI.\n&e3.&r Automate inputs only after you understand rarity tiers and waste rates.",
		"",
		"&7Tip:&r Read rarity before dumping stacks — expensive knowledge is easy to burn.",
		"",
		"&7Next:&r Combine dimlets in a Dimension Enscriber."
	]
	quest.B1000000000001D4.title: "Dimension Enscriber"
	quest.B1000000000001D4.quest_subtitle: "RFTools · Dimensions"
	quest.B1000000000001D4.quest_desc: [
		"&6Goal:&r Craft a Dimension Enscriber.",
		"",
		"Combines selected dimlets with a dimension tab to define a realizable world.",
		"",
		"&6How:&r\n&e1.&r Place the Enscriber and insert your chosen dimlets plus a dimension tab.\n&e2.&r Read the projected maintenance cost and stability before confirming.\n&e3.&r Avoid unstable combinations until you can afford continuous FE.",
		"",
		"&7Tip:&r If maintenance cost looks scary, remove fancy dimlets and retry.",
		"",
		"&7Next:&r Realize the world with a Dimension Builder."
	]
	quest.B1000000000001D5.title: "Dimension Builder"
	quest.B1000000000001D5.quest_subtitle: "RFTools · Dimensions"
	quest.B1000000000001D5.quest_desc: [
		"&6Goal:&r Craft a Dimension Builder.",
		"",
		"Realizes and continuously powers your designed dimension.",
		"",
		"&6How:&r\n&e1.&r Place the Dimension Builder and cable a large Powah/RFTools energy buffer into it.\n&e2.&r Insert the enscribed dimension tab and start realization.\n&e3.&r Place a powered Matter Receiver in the new dimension before exploring deep.",
		"",
		"&7Tip:&r Dimensions idle-cost FE forever — budget generation before tourism.",
		"",
		"&7Next:&r RFTools path complete — Flux Networks can wireless your FE grid next."
	]
	quest.B1000000000001D6.title: "Flux from Bedrock"
	quest.B1000000000001D6.quest_subtitle: "Flux Networks · Materials"
	quest.B1000000000001D6.quest_desc: [
		"&6Goal:&r Produce &616 Flux Dust&r.",
		"",
		"Foundation material for a wireless FE network — made via the special bedrock interaction recipe.",
		"",
		"&6How:&r\n&e1.&r Open JEI on Flux Dust and note the exact in-world bedrock process.\n&e2.&r Bring redstone (and any other listed ingredients) to bedrock level.\n&e3.&r Run the interaction until you have a batch of 16+ dust.",
		"",
		"&7Tip:&r Batch dust early — every Flux device eats cores made from it.",
		"",
		"&7Next:&r Craft Flux Cores.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Dimensional Cell\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000001C2\"}}"
	]
	quest.B1000000000001D7.title: "Flux Cores"
	quest.B1000000000001D7.quest_subtitle: "Flux Networks · Components"
	quest.B1000000000001D7.quest_desc: [
		"&6Goal:&r Craft &68 Flux Cores&r.",
		"",
		"Cores turn Flux Dust into network devices and storage components.",
		"",
		"&6How:&r\n&e1.&r Craft eight Flux Cores from dust and JEI ingredients.\n&e2.&r Store extras in Refined Storage for Plug/Point/Controller crafts.\n&e3.&r Keep producing dust so cores never gate expansion.",
		"",
		"&7Tip:&r Stock cores before you place half a wireless grid.",
		"",
		"&7Next:&r Compress into Flux Blocks."
	]
	quest.B1000000000001D8.title: "Flux Block"
	quest.B1000000000001D8.quest_subtitle: "Flux Networks · Components"
	quest.B1000000000001D8.quest_desc: [
		"&6Goal:&r Craft &64 Flux Blocks&r.",
		"",
		"Compressed network material used by the more capable Flux devices.",
		"",
		"&6How:&r\n&e1.&r Craft four Flux Blocks from cores/dust per JEI.\n&e2.&r Hold them for Plugs, Points, Controllers, and storage tiers.\n&e3.&r Automate dust → core → block before building at scale.",
		"",
		"&7Tip:&r Automate the material chain once wireless FE becomes factory-critical.",
		"",
		"&7Next:&r Craft a Flux Plug to inject FE."
	]
	quest.B1000000000001D9.title: "Flux Plug"
	quest.B1000000000001D9.quest_subtitle: "Flux Networks · Wireless input"
	quest.B1000000000001D9.quest_desc: [
		"&6Goal:&r Craft a Flux Plug.",
		"",
		"Takes FE from an attached generator, cell, or machine and inserts it into your wireless network.",
		"",
		"&6How:&r\n&e1.&r Place the Flux Plug on the output face of a Powah or RFTools energy cell.\n&e2.&r Open the Plug GUI, create or select a named network, and join it.\n&e3.&r Set a transfer limit so one Plug does not dump the entire buffer instantly.",
		"",
		"&7Tip:&r Name the network (“Main Factory”) before placing the first Point.",
		"",
		"&7Next:&r Craft a Flux Point to pull FE out."
	]
	quest.B1000000000001DA.title: "Flux Point"
	quest.B1000000000001DA.quest_subtitle: "Flux Networks · Wireless output"
	quest.B1000000000001DA.quest_desc: [
		"&6Goal:&r Craft a Flux Point.",
		"",
		"Extracts FE from the wireless network into RS, RFTools, Create electrical machines, and more.",
		"",
		"&6How:&r\n&e1.&r Place the Flux Point on a machine or cell that should receive FE.\n&e2.&r Join the same network name as your Plug.\n&e3.&r Set priority and transfer limits so one hungry machine cannot starve the base.",
		"",
		"&7Tip:&r High priority for RS Controllers and teleporters; low for optional gadgets.",
		"",
		"&7Next:&r Craft a Configurator, then a Controller."
	]
	quest.B1000000000001DB.title: "Flux Configurator"
	quest.B1000000000001DB.quest_subtitle: "Flux Networks · Network tools"
	quest.B1000000000001DB.quest_desc: [
		"&6Goal:&r Craft a Flux Configurator.",
		"",
		"Speeds up network-device management while building and troubleshooting.",
		"",
		"&6How:&r\n&e1.&r Craft the Configurator and keep it on your hotbar.\n&e2.&r Use it to edit network membership, names, and device settings without digging GUIs.\n&e3.&r On multiplayer, set security so strangers cannot join your FE grid.",
		"",
		"&7Tip:&r Name networks by purpose and lock them on servers.",
		"",
		"&7Next:&r Add a Flux Controller for central management."
	]
	quest.B1000000000001DC.title: "Flux Controller"
	quest.B1000000000001DC.quest_subtitle: "Flux Networks · Network control"
	quest.B1000000000001DC.quest_desc: [
		"&6Goal:&r Craft a Flux Controller.",
		"",
		"Central network management — enables wireless charging options and advanced network features.",
		"",
		"&6How:&r\n&e1.&r Place the Flux Controller and join it to your main network.\n&e2.&r Open network settings: review chunk loading, transfer bypass, and member permissions.\n&e3.&r Enable only the features you need — do not turn everything on blindly.",
		"",
		"&7Tip:&r Wireless player charging still needs surplus generation wired in via Plugs.",
		"",
		"&7Next:&r Add Flux Storage for wireless buffers."
	]
	quest.B1000000000001DD.title: "Basic Flux Storage"
	quest.B1000000000001DD.quest_subtitle: "Flux Networks · Energy storage"
	quest.B1000000000001DD.quest_desc: [
		"&6Goal:&r Craft Basic Flux Storage.",
		"",
		"Network storage absorbs surplus generation and covers demand spikes without extra cables.",
		"",
		"&6How:&r\n&e1.&r Place Basic Flux Storage and join it to the same network as Plugs/Points.\n&e2.&r Confirm it charges from Plug surplus and discharges when Points demand FE.\n&e3.&r Keep a physical Powah/RFTools buffer too for layered resilience.",
		"",
		"&7Tip:&r Wireless + physical buffers beat either alone when teleporters spike.",
		"",
		"&7Next:&r Upgrade to Herculean storage."
	]
	quest.B1000000000001DE.title: "Herculean Storage"
	quest.B1000000000001DE.quest_subtitle: "Flux Networks · Energy storage"
	quest.B1000000000001DE.quest_desc: [
		"&6Goal:&r Upgrade to Herculean Flux Storage.",
		"",
		"Factory-scale reserves for autocrafting, teleportation, and dimension upkeep.",
		"",
		"&6How:&r\n&e1.&r Craft Herculean Flux Storage and join the main network.\n&e2.&r Watch actual input/output rates in the GUI under load.\n&e3.&r If capacity is full but Points still starve, add generation — not only storage.",
		"",
		"&7Tip:&r Capacity alone does not solve a generation shortage.",
		"",
		"&7Next:&r Cap the grid with Gargantuan storage."
	]
	quest.B1000000000001DF.title: "Gargantuan Storage"
	quest.B1000000000001DF.quest_subtitle: "Flux Networks · Energy storage"
	quest.B1000000000001DF.quest_desc: [
		"&6Goal:&r Craft Gargantuan Flux Storage.",
		"",
		"Largest survival Flux storage tier — endgame reservoir for a fully wireless power grid.",
		"",
		"&6How:&r\n&e1.&r Craft Gargantuan Flux Storage and attach it to the main network.\n&e2.&r Feed it from automated high-tier Powah (reactors/Nitro) via Plugs.\n&e3.&r Monitor fill from your RFTools control room or Flux GUI during peak autocrafting.",
		"",
		"&7Tip:&r Pair Gargantuan storage with Nitro-tier generation for real endgame wireless FE.",
		"",
		"&7Next:&r Flux chapter complete — wireless power your factories and dimensions."
	]
	quest.B100000000000258.title: "Osmium Supply"
	quest.B100000000000258.quest_subtitle: "Mekanism · Materials"
	quest.B100000000000258.quest_desc: [
		"&6Goal:&r Smelt &616 Osmium Ingots&r.",
		"",
		"Osmium is Mekanism's core metal — circuits, machines, compressors, and alloys all burn through it.",
		"",
		"&6How:&r\n&e1.&r Mine &6Osmium Ore&r (or raw osmium) from the world.\n&e2.&r Smelt ore/raw into &6Osmium Ingots&r in any furnace, or enrich first for double dust yield.",
		"",
		"&7Tip:&r Create crushers work for early ore lines if your Mekanism hall is not up yet.",
		"",
		"&7Next:&r Stock iron and carbon — steel infusion is next.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Brass Age\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000DF\"}}"
	]
	quest.B100000000000259.title: "Steel Infusion"
	quest.B100000000000259.quest_subtitle: "Mekanism · Materials"
	quest.B100000000000259.quest_desc: [
		"&6Goal:&r Craft &616 Steel Ingots&r.",
		"",
		"Steel unlocks &6Steel Casings&r — the chassis under nearly every Mekanism machine.",
		"",
		"&6How:&r\n&e1.&r Place a &6Metallurgic Infuser&r and power it (Energy Cube, cable, or charged Energy Tablet).\n&e2.&r Put &6Coal&r, &6Charcoal&r, or &6Enriched Carbon&r in the infusion extra slot.\n&e3.&r Insert &6Iron Ingots&r; collect &6Steel Ingots&r from the output (or pull steel from IE/MI if you already make it elsewhere).",
		"",
		"&7Tip:&r Enrich coal in an Enrichment Chamber later — enriched carbon lasts far longer than raw fuel.",
		"",
		"&7Next:&r Batch steel into Steel Casings."
	]
	quest.B10000000000025A.title: "Steel Casing"
	quest.B10000000000025A.quest_subtitle: "Mekanism · Foundation"
	quest.B10000000000025A.quest_desc: [
		"&6Goal:&r Craft &68 Steel Casings&r.",
		"",
		"Almost every Mekanism machine sits on a Steel Casing. Batch them before the machine rush.",
		"",
		"&6How:&r\n&e1.&r Craft casings from &6Steel&r, &6Osmium&r, and &6Glass&r (check JEI for the exact pattern).\n&e2.&r Keep a stack ready — Enrichment Chamber, Crusher, Factories, and Energy Cubes all consume them.",
		"",
		"&7Tip:&r Pair casings with Basic Control Circuits for the first machine wave.",
		"",
		"&7Next:&r Make Basic Control Circuits next."
	]
	quest.B10000000000025B.title: "Basic Circuits"
	quest.B10000000000025B.quest_subtitle: "Mekanism · Foundation"
	quest.B10000000000025B.quest_desc: [
		"&6Goal:&r Craft &68 Basic Control Circuits&r.",
		"",
		"Circuits gate every machine tier. Basic is the first stop; Advanced/Elite/Ultimate climb the alloy ladder.",
		"",
		"&6How:&r\n&e1.&r Enrich &6Redstone&r in an Enrichment Chamber (or craft circuits once you have the recipe unlocked).\n&e2.&r In a &6Metallurgic Infuser&r, infuse &6Osmium Ingots&r with &6Enriched Redstone&r to form Basic Control Circuits.\n&e3.&r Stockpile — cables, transporters, and early machines each want several.",
		"",
		"&7Tip:&r Automate redstone enrichment before you mass-produce Advanced circuits.",
		"",
		"&7Next:&r Build a dedicated Metallurgic Infuser for the alloy line."
	]
	quest.B10000000000025C.title: "Metallurgic Infuser"
	quest.B10000000000025C.quest_subtitle: "Mekanism · Machines"
	quest.B10000000000025C.quest_desc: [
		"&6Goal:&r Craft a Metallurgic Infuser.",
		"",
		"The Infuser is the heart of Mekanism — steel, circuits, infused/reinforced/atomic alloys, and enriched materials all start here.",
		"",
		"&6How:&r\n&e1.&r Craft and place the Infuser; connect FE via &6Universal Cable&r or an &6Energy Cube&r.\n&e2.&r Open the GUI: main slot for the metal, left/extra slot for the infusion material (carbon, redstone, diamond, refined obsidian, tin, etc.).\n&e3.&r Use a &6Configurator&r (Shift+right-click) to set auto-eject and side modes so pipes can pull outputs.\n&e4.&r Optional: enrich materials first (coal→enriched carbon, redstone→enriched redstone) so each bar lasts longer.",
		"",
		"&7Tip:&r Energy Tablets charge early machines before your cable network is ready.",
		"",
		"&7Next:&r Add an Enrichment Chamber for 2× ore dust and enriched infusion stock."
	]
	quest.B10000000000025D.title: "Enrichment Chamber"
	quest.B10000000000025D.quest_subtitle: "Mekanism · Machines"
	quest.B10000000000025D.quest_desc: [
		"&6Goal:&r Craft an Enrichment Chamber.",
		"",
		"Tier-1 ore processing: enrich ore → dust → smelt for double ingots. Also makes enriched redstone/diamond/carbon for the Infuser.",
		"",
		"&6How:&r\n&e1.&r Place and power the chamber; pipe ores into the input with Logistical Transporters or hoppers.\n&e2.&r Enrich raw ores/ores into dusts, then smelt dusts for ~2× yield versus raw smelting.\n&e3.&r Enrich redstone, diamond, coal, and refined-obsidian inputs for Metallurgic Infuser bars.\n&e4.&r Configurator: enable auto-eject and lock sides so dusts leave cleanly into a furnace line.",
		"",
		"&7Tip:&r Speed and energy upgrades pay for themselves once ore lines are feeding it.",
		"",
		"&7Next:&r Add a Crusher for dirt/dust intermediates and factory upgrades later."
	]
	quest.B10000000000025E.title: "Mekanism Crusher"
	quest.B10000000000025E.quest_subtitle: "Mekanism · Machines"
	quest.B10000000000025E.quest_desc: [
		"&6Goal:&r Craft a Mekanism Crusher.",
		"",
		"Crushers turn clumps, shards, and crystals into dirty dusts/dusts along the higher ore-processing tiers — and crush solids for FE-powered dust lines.",
		"",
		"&6How:&r\n&e1.&r Place next to your Enrichment Chamber and power both.\n&e2.&r Basic line: Enrich ore → smelt. Better line: Purification/Injection products → Crusher → Enrichment → Furnace.\n&e3.&r Set side config so crushed outputs feed the Enrichment Chamber automatically.",
		"",
		"&7Tip:&r A Basic Tier Installer turns this into a multi-slot factory later.",
		"",
		"&7Next:&r Infuse iron with redstone for Infused Alloy."
	]
	quest.B10000000000025F.title: "Infused Alloy"
	quest.B10000000000025F.quest_subtitle: "Mekanism · Alloys"
	quest.B10000000000025F.quest_desc: [
		"&6Goal:&r Craft &68 Infused Alloys&r.",
		"",
		"Redstone-infused iron is the first alloy tier — Advanced circuits, mid machines, and transporters need it.",
		"",
		"&6How:&r\n&e1.&r In the Metallurgic Infuser, load &6Enriched Redstone&r (or redstone) as the infusion type.\n&e2.&r Insert &6Iron Ingots&r; collect &6Infused Alloy&r from the output.",
		"",
		"&7Tip:&r Keep a dedicated Infuser on redstone so you are not constantly swapping carbon/redstone/diamond bars.",
		"",
		"&7Next:&r Craft Advanced Control Circuits."
	]
	quest.B100000000000260.title: "Advanced Circuits"
	quest.B100000000000260.quest_subtitle: "Mekanism · Alloys"
	quest.B100000000000260.quest_desc: [
		"&6Goal:&r Craft &64 Advanced Control Circuits&r.",
		"",
		"Advanced circuits unlock Purification, Injection, Osmium Compressor, Digital Miner, and factory installers.",
		"",
		"&6How:&r\n&e1.&r Craft Advanced Control Circuits from &6Basic Control Circuits&r + &6Infused Alloy&r (JEI).\n&e2.&r Stockpile extras — every upgrade path burns through these.",
		"",
		"&7Tip:&r Automate infused alloy before chasing Elite circuits (reinforced alloy + advanced circuit).",
		"",
		"&7Next:&r Build the Purification Chamber for the next ore-yield jump."
	]
	quest.B100000000000261.title: "Purification Chamber"
	quest.B100000000000261.quest_subtitle: "Mekanism · Ore processing"
	quest.B100000000000261.quest_desc: [
		"&6Goal:&r Craft a Purification Chamber.",
		"",
		"Oxygen-assisted purification is the next yield tier after enrichment — ores become clumps that crush into more dust.",
		"",
		"&6How:&r\n&e1.&r Place and power the Purification Chamber.\n&e2.&r Pipe &6Oxygen&r in via &6Pressurized Tubes&r from an Electrolytic Separator (or Chemical Tank).\n&e3.&r Feed ores; clumps leave the item output — crush → enrich → smelt for the upgraded chain.\n&e4.&r Configurator: chemical input on one side, items on others; enable auto-eject.",
		"",
		"&7Tip:&r One separator can feed multiple purification machines if oxygen is buffered in a chemical tank.",
		"",
		"&7Next:&r Build the Electrolytic Separator for O₂/H₂."
	]
	quest.B100000000000262.title: "Electrolytic Separator"
	quest.B100000000000262.quest_subtitle: "Mekanism · Gases"
	quest.B100000000000262.quest_desc: [
		"&6Goal:&r Craft an Electrolytic Separator.",
		"",
		"Splits water into &6Hydrogen&r and &6Oxygen&r — purification, HCl, gas-burning power, and many chemical recipes depend on it.",
		"",
		"&6How:&r\n&e1.&r Place and power the Separator; pipe &6Water&r into the fluid input (sink, pump, or Create hose).\n&e2.&r Connect &6Pressurized Tubes&r from the O₂ and H₂ sides to tanks or machines.\n&e3.&r Configurator: set dump modes if one gas backs up and stalls the machine (common when only oxygen is used).\n&e4.&r Store surplus hydrogen in a Chemical Tank or burn it in a Gas-Burning Generator.",
		"",
		"&cCaution:&r If either gas output is full and dump is off, electrolysis stops — always give both gases somewhere to go.",
		"",
		"&7Tip:&r Salt → brine electrolysis later yields chlorine for Hydrogen Chloride.",
		"",
		"&7Next:&r Chemical Injection Chamber for elite ore yields."
	]
	quest.B100000000000263.title: "Chemical Injection"
	quest.B100000000000263.quest_subtitle: "Mekanism · Ore processing"
	quest.B100000000000263.quest_desc: [
		"&6Goal:&r Craft a Chemical Injection Chamber.",
		"",
		"Hydrogen Chloride injection pushes ore processing into elite shard yields — the step before full slurry/crystal lines.",
		"",
		"&6How:&r\n&e1.&r Make &6Hydrogen Chloride&r: Chemical Infuser combining &6Hydrogen&r + &6Chlorine&r (chlorine from brine in an Electrolytic Separator).\n&e2.&r Pipe HCl into the Injection Chamber via Pressurized Tubes; power the machine.\n&e3.&r Feed ores → shards; crush shards → dirty dust → enrich → smelt.\n&e4.&r Later (optional): Chemical Dissolution + Sulfuric Acid → slurry → Chemical Washer → Crystalizer for max yield.",
		"",
		"&7Tip:&r Buffer HCl in a Basic Chemical Tank so the chamber never starves mid-batch.",
		"",
		"&7Next:&r Osmium Compressor for refined glowstone/obsidian products."
	]
	quest.B100000000000264.title: "Osmium Compressor"
	quest.B100000000000264.quest_subtitle: "Mekanism · Machines"
	quest.B100000000000264.quest_desc: [
		"&6Goal:&r Craft an Osmium Compressor.",
		"",
		"Compresses liquid osmium onto dusts for refined glowstone, refined obsidian, and other late intermediates on the Atomic Alloy path.",
		"",
		"&6How:&r\n&e1.&r Place and power the compressor; feed it &6Osmium&r (ingots/blocks as the recipe requires — check JEI).\n&e2.&r Insert the dust/material to compress; collect refined products from the output.\n&e3.&r Pipe inputs with Logistical Transporters; keep a chest of osmium beside it.",
		"",
		"&7Tip:&r Pair with a Combiner when recipes want compressed blocks or blended dusts.",
		"",
		"&7Next:&r Climb to Atomic Alloy once reinforced alloy and refined obsidian are flowing."
	]
	quest.B100000000000265.title: "Universal Cables"
	quest.B100000000000265.quest_subtitle: "Mekanism · Logistics"
	quest.B100000000000265.quest_desc: [
		"&6Goal:&r Craft &632 Basic Universal Cables&r.",
		"",
		"Universal Cables move FE between cubes, machines, chargepads, and generators — Mekanism's power bus.",
		"",
		"&6How:&r\n&e1.&r Craft a stack of &6Basic Universal Cables&r and place them like redstone dust between machines.\n&e2.&r Connect an &6Energy Cube&r or generator on one end and your machine cluster on the other.\n&e3.&r Sneak-Configurator on a cable connection to set pull/push if energy is not flowing the way you expect.",
		"",
		"&7Tip:&r Upgrade cable tiers when transfer rate stalls under factory load.",
		"",
		"&7Next:&r Add Logistical Transporters for items."
	]
	quest.B100000000000266.title: "Logistical Transporters"
	quest.B100000000000266.quest_subtitle: "Mekanism · Logistics"
	quest.B100000000000266.quest_desc: [
		"&6Goal:&r Craft &632 Basic Logistical Transporters&r.",
		"",
		"Mekanism item pipes with filters, color coding, and round-robin — excellent beside Create belts.",
		"",
		"&6How:&r\n&e1.&r Place transporters between inventories/machines like pipes.\n&e2.&r Use a Configurator to set pull on the source chest and push toward machines.\n&e3.&r Shift-Configurator cycles color; matching colors keep ore lines from mixing.\n&e4.&r Add Logistical Sorters later for filtered routing into multiple machines.",
		"",
		"&7Tip:&r Round-robin helps feed multi-slot factories evenly.",
		"",
		"&7Next:&r Pressurized Tubes for chemicals and gases."
	]
	quest.B100000000000267.title: "Pressurized Tubes"
	quest.B100000000000267.quest_subtitle: "Mekanism · Logistics"
	quest.B100000000000267.quest_desc: [
		"&6Goal:&r Craft &616 Basic Pressurized Tubes&r.",
		"",
		"Move chemicals and gases between separators, chambers, tanks, and injectors without buckets.",
		"",
		"&6How:&r\n&e1.&r Place tubes from Electrolytic Separator outputs to Purification / Injection / Chemical Tanks.\n&e2.&r Configurator on tube ends sets pull/push; mismatched modes are the usual 'no gas flowing' bug.\n&e3.&r Buffer expensive gases in Chemical Tanks so machines do not stall mid-craft.",
		"",
		"&7Tip:&r Keep radioactive or expensive gases on dedicated color-coded networks.",
		"",
		"&7Next:&r Park an Energy Cube at the center of the machine hall."
	]
	quest.B100000000000268.title: "Energy Cube"
	quest.B100000000000268.quest_subtitle: "Mekanism · Power"
	quest.B100000000000268.quest_desc: [
		"&6Goal:&r Craft a Basic Energy Cube.",
		"",
		"Cubes buffer FE for machine halls so generators can keep working through demand spikes.",
		"",
		"&6How:&r\n&e1.&r Place the cube centrally among machines; cable generators into input sides.\n&e2.&r Configurator each face: input from power, output toward machines (or use Universal Cables freely).\n&e3.&r Upgrade Advanced → Elite → Ultimate as Digital Miner and factories demand more buffer.",
		"",
		"&7Tip:&r Short cable runs from a central cube cut transfer bottlenecks.",
		"",
		"&7Next:&r QIO storage once power is stable — or Tier Installers for factories."
	]
	quest.B100000000000269.title: "Factory Installer"
	quest.B100000000000269.quest_subtitle: "Mekanism · Factories"
	quest.B100000000000269.quest_desc: [
		"&6Goal:&r Craft a Basic Tier Installer.",
		"",
		"Right-click a machine to turn it into a Factory with more parallel processing slots — huge ore-line throughput.",
		"",
		"&6How:&r\n&e1.&r Craft a &6Basic Tier Installer&r (Advanced circuits + alloys — check JEI).\n&e2.&r Right-click a placed Enrichment Chamber, Crusher, Infuser, etc. to convert it into a Basic Factory.\n&e3.&r Higher installers (Advanced/Elite/Ultimate) upgrade the same machine further in place.\n&e4.&r Re-pipe items after upgrading — slot counts and side configs can need a refresh.",
		"",
		"&7Tip:&r Plan floor space; factories are wider in the GUI and hungry for power.",
		"",
		"&7Next:&r Digital Miner when you want filter-based area mining."
	]
	quest.B10000000000026A.title: "Digital Miner"
	quest.B10000000000026A.quest_subtitle: "Mekanism · Late tools"
	quest.B10000000000026A.quest_desc: [
		"&6Goal:&r Craft a Digital Miner.",
		"",
		"Filter-based area mining that pulls ores (and more) without you swinging a pick — the ultimate ore vacuum.",
		"",
		"&6How:&r\n&e1.&r Place the miner with clear space; connect serious FE (Energy Cube + upgraded cables).\n&e2.&r Open the GUI: set radius, Y min/max, silk touch / fortune modes as desired.\n&e3.&r Add item filters for the ores you want (or inverse-filter junk).\n&e4.&r Start the miner; pull items out with Logistical Transporters into storage.",
		"",
		"&cCaution:&r A wide unfiltered miner will shred the landscape and lag the area — set filters before starting.",
		"",
		"&7Tip:&r Anchor it near a QIO or RS system so ores never sit in the internal buffer.",
		"",
		"&7Next:&r Atomic Disassembler for a configurable all-tool."
	]
	quest.B10000000000026B.title: "Atomic Disassembler"
	quest.B10000000000026B.quest_subtitle: "Mekanism · Late tools"
	quest.B10000000000026B.quest_desc: [
		"&6Goal:&r Craft an Atomic Disassembler.",
		"",
		"A configurable all-tool that scales with energy — mining, combat, vein, and slow modes in one charged package.",
		"",
		"&6How:&r\n&e1.&r Craft the Disassembler (Atomic Alloy and late components — JEI).\n&e2.&r Charge it on a &6Chargepad&r wired to your energy network, or in an Energy Cube GUI.\n&e3.&r Sneak-scroll or use the mode key to switch digging/vein/slow modes as needed.",
		"",
		"&7Tip:&r Energy upgrades and a full cube make vein mode feel instant.",
		"",
		"&7Next:&r QIO Dashboard for wireless bulk storage."
	]
	quest.B10000000000026C.title: "QIO Dashboard"
	quest.B10000000000026C.quest_subtitle: "Mekanism · Storage"
	quest.B10000000000026C.quest_desc: [
		"&6Goal:&r Craft a QIO Dashboard.",
		"",
		"Quantum Item Orchestration stores huge item volumes wirelessly once drives and frequencies are linked.",
		"",
		"&6How:&r\n&e1.&r Craft a &6QIO Drive Array&r, insert &6QIO Drives&r, and set a frequency name.\n&e2.&r Craft the &6QIO Dashboard&r and set it to the same frequency.\n&e3.&r Place QIO Exporters/Importers on chests or machine I/O to move items on that frequency.\n&e4.&r Expand with larger drives as ore lines fill the first drive.",
		"",
		"&7Tip:&r One frequency per base keeps things simple until you need isolation.",
		"",
		"&7Next:&r Atomic Alloy for teleporters and elite crafts."
	]
	quest.B10000000000026D.title: "Atomic Alloy"
	quest.B10000000000026D.quest_subtitle: "Mekanism · Endgame"
	quest.B10000000000026D.quest_desc: [
		"&6Goal:&r Craft &64 Atomic Alloys&r.",
		"",
		"Diamond-then-obsidian infused alloy is Mekanism's top crafting tier for teleporters, elite machines, and MekaSuit modules.",
		"",
		"&6How:&r\n&e1.&r Infuse &6Infused Alloy&r with diamond → &6Reinforced Alloy&r.\n&e2.&r Make &6Refined Obsidian Dust&r (Enrich obsidian → compress with osmium as recipes require).\n&e3.&r Infuse Reinforced Alloy with refined obsidian → &6Atomic Alloy&r.",
		"",
		"&7Tip:&r Automate the full alloy ladder before chasing MekaSuit modules.",
		"",
		"&7Next:&r Frame a Mekanism Teleporter."
	]
	quest.B10000000000026E.title: "Mekanism Teleporter"
	quest.B10000000000026E.quest_subtitle: "Mekanism · Endgame"
	quest.B10000000000026E.quest_desc: [
		"&6Goal:&r Craft a Mekanism Teleporter.",
		"",
		"Linked portals give instant base-to-base travel once frames and frequencies are set.",
		"",
		"&6How:&r\n&e1.&r Build a portal frame from &6Teleporter Frame&r blocks (usually a hollow rectangle like a nether portal).\n&e2.&r Place the &6Teleporter&r block in the frame; power it heavily.\n&e3.&r Set matching frequencies on two teleporters; walk in to travel.\n&e4.&r Buffer FE in an Energy Cube beside each pad — jumps are energy-hungry.",
		"",
		"&7Tip:&r Frames are cheap; energy cost and correct frequency linking are the real setup.",
		"",
		"&7Next:&r Chapter complete — push factories, ore tiers, and QIO as your base grows."
	]
	quest.B10000000000028A.title: "Heat Generator"
	quest.B10000000000028A.quest_subtitle: "Mekanism Generators · Early power"
	quest.B10000000000028A.quest_desc: [
		"Mekanism Generators climbs from lava-side heat and rooftop solar up through fission, industrial turbines, and fusion ignition. Wire each step before you touch nuclear fuel.",
		"",
		"&6You will:&r\n&e•&r Bootstrap FE with heat, solar, wind, bio, and gas-burning generators\n&e•&r Assemble a water-cooled fission reactor and spin an Industrial Turbine\n&e•&r Frame a fusion reactor, load a Hohlraum, and ignite with lasers",
		"",
		"&7Tip:&r Buffer every generator into an Energy Cube — nuclear lessons are easier with spare FE.",
		"",
		"&6Goal:&r Craft a Heat Generator.",
		"",
		"The Heat Generator is your first Mekanism FE — burn solid fuel or park it beside lava for quiet bootstrap power while steel casings and circuits come online.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Heat Generator&r and place it next to lava (or feed it solid fuel in the GUI).\n&e2.&r Set an output side and pull FE with a Universal Cable into a Basic Energy Cube.\n&e3.&r Keep the cube charged so Metallurgic Infusers and early machines never brown out.",
		"",
		"&7Tip:&r Lava-adjacent heat is steady and fuel-free once the pool is safe.",
		"",
		"&7Next:&r Solar covers daytime loads without babysitting fuel.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Osmium Supply\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B100000000000258\"}}"
	]
	quest.B10000000000028B.title: "Solar Generator"
	quest.B10000000000028B.quest_subtitle: "Mekanism Generators · Early power"
	quest.B10000000000028B.quest_desc: [
		"&6Goal:&r Craft &62 Solar Generators&r.",
		"",
		"Solar is silent daytime FE with zero fuel logistics. Pair it with storage so night shifts still run enrichment and crushing.",
		"",
		"&6How:&r\n&e1.&r Craft two &6Solar Generators&r and place them with a clear view of the sky.\n&e2.&r Cable both into the same Energy Cube (or Induction Matrix later).\n&e3.&r Confirm daytime charge in the cube GUI — if night drains you dry, add more panels or cubes before expanding machines.",
		"",
		"&7Tip:&r Advanced Solar (later) covers a 3×3 footprint for a big jump in output.",
		"",
		"&7Next:&r Wind keeps producing after sunset."
	]
	quest.B10000000000028C.title: "Wind Generator"
	quest.B10000000000028C.quest_subtitle: "Mekanism Generators · Early power"
	quest.B10000000000028C.quest_desc: [
		"&6Goal:&r Craft a Wind Generator.",
		"",
		"Wind scales with height and runs day and night — perfect rooftop power once your factory has a tall enough tower.",
		"",
		"&6How:&r\n&e1.&r Craft a &6Wind Generator&r and place it high above the base (clear air around the rotor).\n&e2.&r Open the GUI after placing — higher Y-level means more FE/t.\n&e3.&r Cable it into your cube bus alongside solar so nights stay covered.",
		"",
		"&7Tip:&r Scaffold a dedicated wind tower; burying the generator at ground level wastes potential.",
		"",
		"&7Next:&r Bio-fuel is the compact fuel-based option."
	]
	quest.B10000000000028D.title: "Bio-Generator"
	quest.B10000000000028D.quest_subtitle: "Mekanism Generators · Early power"
	quest.B10000000000028D.quest_desc: [
		"&6Goal:&r Craft a Bio-Generator.",
		"",
		"Bio-Generators burn bio fuel refined from organic matter — dense FE when you already farm crops or compost leftovers.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Bio-Generator&r and place it near your farm or compost line.\n&e2.&r Produce &eBio Fuel&r (Crusher / enrichment routes — check JEI) and pipe or insert it into the generator.\n&e3.&r Wire FE out to the same cube network as solar and wind.",
		"",
		"&7Tip:&r A small crop farm beats coal runs once the bio loop is automatic.",
		"",
		"&7Next:&r Gas-burning turns electrolyzed hydrogen into serious FE."
	]
	quest.B10000000000028E.title: "Gas-Burning Generator"
	quest.B10000000000028E.quest_subtitle: "Mekanism Generators · Gas power"
	quest.B10000000000028E.quest_desc: [
		"&6Goal:&r Craft a Gas-Burning Generator.",
		"",
		"Burn hydrogen (and other burnable gases) from an Electrolytic Separator for dense FE that scales with your water and power budget.",
		"",
		"&6How:&r\n&e1.&r Set up an &6Electrolytic Separator&r with water input; collect &eHydrogen&r in a gas tank or pressurized tube.\n&e2.&r Place the &6Gas-Burning Generator&r and pipe hydrogen in with Pressurized Tubes.\n&e3.&r Cable FE out — surplus electrolysis power often pays for itself once the loop is closed.",
		"",
		"&7Tip:&r Dump oxygen or store it; don't let gas backups stall the separator.",
		"",
		"&7Next:&r Fission starts with a lot of casing — stock up first."
	]
	quest.B10000000000028F.title: "Advanced Solar"
	quest.B10000000000028F.quest_subtitle: "Mekanism Generators · Early power"
	quest.B10000000000028F.quest_desc: [
		"&6Goal:&r Craft an Advanced Solar Generator.",
		"",
		"Advanced Solar is a mid-game array — much higher daytime output before you commit to fission logistics and radiation planning.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Advanced Solar Generator&r (it needs a 3×3 clear footprint).\n&e2.&r Place it with open sky, cable into an Energy Cube or Induction Matrix.\n&e3.&r Use the buffer to ride through night and brownouts while you prep fission parts.",
		"",
		"&7Tip:&r Still daylight-gated — matrices beat a pile of small cubes for nuclear prep.",
		"",
		"&7Next:&r Fission casings build the hollow reactor shell."
	]
	quest.B100000000000290.title: "Fission Casing"
	quest.B100000000000290.quest_subtitle: "Mekanism Generators · Fission"
	quest.B100000000000290.quest_desc: [
		"&6Goal:&r Craft &632 Fission Reactor Casings&r.",
		"",
		"Fission is a hollow cuboid of casing, ports, fuel assemblies, and control rods. Water cools the core; heated coolant and nuclear waste come out the other side — plan containment before the first assembly goes in.",
		"",
		"&6How:&r\n&e1.&r Choose a starter size (small hollow cuboid) and gather &632 Fission Reactor Casings&r plus glass/ports as JEI shows.\n&e2.&r Build a hollow shell: casing floor, walls, and ceiling with air inside. Corners and edges must form correctly or the multiblock fails.\n&e3.&r Leave face slots open for &eFission Reactor Ports&r; interior space must fit fuel assemblies and control rod assemblies above them.",
		"",
		"&cCaution:&r Fission leaks radiation when things go wrong. Build away from living areas and keep a Geiger Counter handy.",
		"",
		"&7Tip:&r Use the multiblock overlay — missing corners and solid interiors are the usual formation killers.",
		"",
		"&7Next:&r Fuel assemblies hold fissile fuel inside the shell."
	]
	quest.B100000000000291.title: "Fuel Assemblies"
	quest.B100000000000291.quest_subtitle: "Mekanism Generators · Fission"
	quest.B100000000000291.quest_desc: [
		"&6Goal:&r Craft &64 Fission Fuel Assemblies&r.",
		"",
		"Fuel assemblies are the interior columns that hold &6Fissile Fuel&r. More assemblies raise heat and steam potential — and meltdown risk if cooling lags.",
		"",
		"&6How:&r\n&e1.&r Place vertical &6Fission Fuel Assemblies&r inside the hollow casing, leaving the top of each column free for a control rod assembly.\n&e2.&r Start with a few assemblies only — four is a teaching core, not a megabase.\n&e3.&r Produce &eFissile Fuel&r through the Mekanism processing line before you plan to run; never light an empty or uncooled core.",
		"",
		"&7Tip:&r Add assemblies only after coolant flow and waste barrels are proven.",
		"",
		"&7Next:&r Control rods sit above the fuel columns."
	]
	quest.B100000000000292.title: "Control Rods"
	quest.B100000000000292.quest_subtitle: "Mekanism Generators · Fission"
	quest.B100000000000292.quest_desc: [
		"&6Goal:&r Craft &62 Control Rod Assemblies&r.",
		"",
		"Control rod assemblies throttle the reaction from the fission GUI (and redstone / logic adapters). Enough rods let you SCRAM if heat spikes.",
		"",
		"&6How:&r\n&e1.&r Place a &6Control Rod Assembly&r directly above each fuel-assembly column (through the ceiling as the multiblock requires).\n&e2.&r Confirm formation, then keep rods inserted until coolant and waste ports are connected.\n&e3.&r Optionally wire a Logic Adapter for emergency insertion from redstone or industrial alarms.",
		"",
		"&7Tip:&r Never run with rods yanked out 'to see what happens' — heat climbs fast.",
		"",
		"&7Next:&r Ports move coolant, heated coolant, fuel, and waste."
	]
	quest.B100000000000293.title: "Fission Ports"
	quest.B100000000000293.quest_subtitle: "Mekanism Generators · Fission"
	quest.B100000000000293.quest_desc: [
		"&6Goal:&r Craft &62 Fission Reactor Ports&r.",
		"",
		"Ports are the only safe way to inject coolant and pull heated coolant / waste. Without a planned loop, the reactor cooks itself and radiates the chunk.",
		"",
		"&6How:&r\n&e1.&r Replace face casings with &6Fission Reactor Ports&r and configure modes: coolant in (water), heated coolant out, waste out, fuel in as needed.\n&e2.&r Pipe &ewater&r coolant in and route &eheated coolant&r toward a Thermoelectric Boiler (or equivalent) that makes steam for the Industrial Turbine.\n&e3.&r Barrel or pipe &enuclear waste&r to safe storage immediately — never dump it into the world.\n&e4.&r Activate only after coolant flow is continuous; watch burn rate and heat, ready to insert rods.",
		"",
		"&cCaution:&r Meltdowns and waste mishandling spread radiation. Wear a Hazmat Suit and keep scrap / absorbent supplies ready.",
		"",
		"&7Tip:&r Prove the coolant loop on a short run before you scale fuel assemblies.",
		"",
		"&7Next:&r Turbine casings turn that steam into FE."
	]
	quest.B100000000000294.title: "Industrial Turbine"
	quest.B100000000000294.quest_subtitle: "Mekanism Generators · Turbine"
	quest.B100000000000294.quest_desc: [
		"&6Goal:&r Craft &624 Turbine Casings&r.",
		"",
		"The Industrial Turbine converts steam into massive FE. Fission (via boiler) or other steam sources feed it — this is the payoff for the nuclear loop.",
		"",
		"&6How:&r\n&e1.&r Build a hollow turbine structure from &6Turbine Casings&r with room for a rotor shaft, blades, vents, condensers, and electromagnetic coils.\n&e2.&r Add a turbine valve / steam input from your boiler and plan water return from condensers so the coolant loop can close.\n&e3.&r Leave coil and blade space clear — stuffing the interior with casing blocks prevents formation.",
		"",
		"&7Tip:&r Match turbine size to steam supply; a giant empty turbine won't invent pressure.",
		"",
		"&7Next:&r Blades set how much steam the rotor can catch."
	]
	quest.B100000000000295.title: "Turbine Blades"
	quest.B100000000000295.quest_subtitle: "Mekanism Generators · Turbine"
	quest.B100000000000295.quest_desc: [
		"&6Goal:&r Craft &68 Turbine Blades&r.",
		"",
		"Blades on the rotor shaft set flow capacity. Undersized vents choke output; oversized blade stacks without steam waste materials.",
		"",
		"&6How:&r\n&e1.&r Install &6Turbine Blades&r on the rotor shaft segments inside the casing.\n&e2.&r Add pressure dispersers / vents as the multiblock guide requires so steam can expand across the blades.\n&e3.&r Spin up with a modest steam feed and confirm RPM / production before maxing blade count.",
		"",
		"&7Tip:&r Balance blades, vents, and condensers — any weak link caps FE.",
		"",
		"&7Next:&r Electromagnetic coils turn rotor motion into energy."
	]
	quest.B100000000000296.title: "Electromagnetic Coils"
	quest.B100000000000296.quest_subtitle: "Mekanism Generators · Turbine"
	quest.B100000000000296.quest_desc: [
		"&6Goal:&r Craft &62 Electromagnetic Coils&r.",
		"",
		"Coils convert rotor spin into FE. More coils raise energy production for a given steam flow once vents and condensers keep up.",
		"",
		"&6How:&r\n&e1.&r Place &6Electromagnetic Coils&r in the coil layer of the turbine multiblock.\n&e2.&r Add saturating condensers to reclaim water and close the loop back to your boiler / fission coolant circuit.\n&e3.&r Cable FE from the turbine's energy output into an Induction Matrix — fission spikes will saturate small cubes.",
		"",
		"&7Tip:&r If production plateaus, check steam feed and vent count before crafting more coils.",
		"",
		"&7Next:&r Fusion is the endgame — start framing next."
	]
	quest.B100000000000297.title: "Fusion Frame"
	quest.B100000000000297.quest_subtitle: "Mekanism Generators · Fusion"
	quest.B100000000000297.quest_desc: [
		"&6Goal:&r Craft &616 Fusion Reactor Frames&r.",
		"",
		"Fusion is Mekanism's endgame power: a framed reactor burns deuterium–tritium fuel after laser ignition. Stock frames, ports, and cooling before you chase a Hohlraum.",
		"",
		"&6How:&r\n&e1.&r Craft &616 Fusion Reactor Frames&r and gather the matching ports, glass, and controller parts from JEI.\n&e2.&r Build the hollow fusion reactor structure — frames form the skeleton; leave faces for the controller, ports, and laser focus access.\n&e3.&r Prepare &eDeuterium&r and &eTritium&r production (heavy water / gas processing lines) so ignition isn't starved for fuel.",
		"",
		"&7Tip:&r Budget serious FE for the laser charging step — weak grids fail ignition awkwardly.",
		"",
		"&7Next:&r The fusion controller is the multiblock brain."
	]
	quest.B100000000000298.title: "Fusion Controller"
	quest.B100000000000298.quest_subtitle: "Mekanism Generators · Fusion"
	quest.B100000000000298.quest_desc: [
		"&6Goal:&r Craft a Fusion Reactor Controller.",
		"",
		"The controller assembles the fusion multiblock and shows heat, fuel injection, and status. Water cooling and steam extraction can feed the same turbine network as fission.",
		"",
		"&6How:&r\n&e1.&r Place the &6Fusion Reactor Controller&r on a valid face and confirm the reactor forms.\n&e2.&r Configure ports for D-T fuel injection and coolant / steam handling.\n&e3.&r Build or aim a &6Laser Focus Matrix&r (and amplifiers) at the reactor — ignition needs a charged laser pulse, not just filled tanks.",
		"",
		"&7Tip:&r Dial injection rates slowly after the first successful burn; runaway heat still punishes greed.",
		"",
		"&7Next:&r Load a Hohlraum to light the first sustained reaction."
	]
	quest.B100000000000299.title: "Hohlraum"
	quest.B100000000000299.quest_subtitle: "Mekanism Generators · Fusion"
	quest.B100000000000299.quest_desc: [
		"&6Goal:&r Craft a Hohlraum.",
		"",
		"A Hohlraum loaded with fusion fuel is what the laser ignites. Failed starts and restarts consume them — keep spares on the shelf.",
		"",
		"&6How:&r\n&e1.&r Craft a &6Hohlraum&r and fill it with the fusion fuel mix JEI / the reactor GUI expects (D-T).\n&e2.&r Insert the loaded Hohlraum into the fusion reactor per the controller interface.\n&e3.&r Charge the laser network, fire into the &eLaser Focus Matrix&r, and watch the controller for a successful ignition.\n&e4.&r Once burning, maintain deuterium/tritium injection and cooling; pull steam/FE through your existing turbine if configured.",
		"",
		"&cCaution:&r Ignition pulls a huge power spike. If lasers brown out mid-charge, stop and reinforce the grid before retrying.",
		"",
		"&7Tip:&r Craft spare Hohlraums before the first attempt — learning runs are rarely one-and-done."
	]
	quest.B1000000000002BC.title: "Yellorium"
	quest.B1000000000002BC.quest_subtitle: "Extreme Reactors · Fuel"
	quest.B1000000000002BC.quest_desc: [
		"Extreme Reactors turns yellorium into FE — first as a small passive reactor, then as an actively cooled steam loop into a turbine. This chapter walks you from ore to ludicrite endgame.",
		"",
		"&6You will:&r\n&e•&r Mine yellorite and stock graphite for reactor parts\n&e•&r Build a hollow Basic reactor with fuel rods, control rods, and a power tap\n&e•&r Graduate to active cooling, turbines, cyanite reprocessing, and Reinforced tier",
		"",
		"&7Tip:&r Start tiny. A 5×5×5 outer shell (~3×3×3 interior) teaches the layout before you scale.",
		"",
		"&6Goal:&r Smelt &616 Yellorium Ingots&r.",
		"",
		"Yellorium is the fuel metal every Basic reactor burns. Without a stockpile, your first controller is just a fancy doorstop.",
		"",
		"&6How:&r\n&e1.&r Hunt &6Yellorite Ore&r underground (deepslate variants count). Nature's Compass won't find it — dig, explore, or filter a Digital Miner.\n&e2.&r Smelt the ore into &eYellorium Ingots&r and keep extras for fuel rods plus later crafts.",
		"",
		"&7Tip:&r Batch-smelt; inserting fuel and crafting parts both chew through ingots.",
		"",
		"&7Next:&r Graphite next — casings and rods need it in bulk.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Alternator\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000019B\"}}"
	]
	quest.B1000000000002BD.title: "Graphite Bars"
	quest.B1000000000002BD.quest_subtitle: "Extreme Reactors · Materials"
	quest.B1000000000002BD.quest_desc: [
		"&6Goal:&r Craft &616 Graphite Bars&r.",
		"",
		"Graphite shows up in casings, fuel rods, control rods, and turbine parts. Treat it like a second fuel supply for the whole chapter.",
		"",
		"&6How:&r\n&e1.&r Open JEI for &6Graphite Bar&r — charcoal, coal coke, or similar carbon routes depending on the pack.\n&e2.&r Craft a chestful and park it next to your reactor build site.",
		"",
		"&7Tip:&r Running out mid-shell is painful; overshoot on the first batch.",
		"",
		"&7Next:&r Casings form the hollow reactor shell."
	]
	quest.B1000000000002BE.title: "Reactor Casing"
	quest.B1000000000002BE.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002BE.quest_desc: [
		"&6Goal:&r Craft &624 Basic Reactor Casings&r.",
		"",
		"Casings (and glass) make the hollow cuboid shell. Controllers, ports, and taps replace face blocks later — corners must always stay casing.",
		"",
		"&6How:&r\n&e1.&r Pick a starter footprint: outer &e5×5×5&r (about &e3×3×3&r interior) is ideal. Basic reactors top out near &e5×5×5&r interior — don't max it on day one.\n&e2.&r Build a hollow cuboid: floor, walls, and ceiling of &6Basic Reactor Casing&r. Leave the interior empty air.\n&e3.&r Corners and edges must be casing. You can swap some wall faces for reactor glass once you craft it — never the corners.",
		"",
		"&7Tip:&r Frame the shell first, then punch holes for the controller, power tap, and access port.",
		"",
		"&7Next:&r The controller validates the multiblock."
	]
	quest.B1000000000002BF.title: "Reactor Controller"
	quest.B1000000000002BF.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002BF.quest_desc: [
		"&6Goal:&r Craft a Basic Reactor Controller.",
		"",
		"The controller is the brain — it assembles the multiblock and shows heat, fuel, reactivity, and power. No valid controller, no reactor.",
		"",
		"&6How:&r\n&e1.&r Replace one face block (not a corner) with the &6Basic Reactor Controller&r.\n&e2.&r Stand back and confirm the structure assembles (outline / GUI). If it fails, check hollow interior, casing corners, and that only valid reactor parts sit on the shell.\n&e3.&r Leave room on other faces for a &ePower Tap&r and &eAccess Port&r — don't cover every wall with glass yet.",
		"",
		"&7Tip:&r Controller on the front face, ports on the sides keeps cable runs tidy.",
		"",
		"&7Next:&r Fuel rods go in interior columns under control rods."
	]
	quest.B1000000000002C0.title: "Fuel Rods"
	quest.B1000000000002C0.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002C0.quest_desc: [
		"&6Goal:&r Craft &64 Basic Reactor Fuel Rods&r.",
		"",
		"Fuel rods hold yellorium inside the hollow core. Each column of rods is one fuel channel — more rods means more heat and power, and more waste.",
		"",
		"&6How:&r\n&e1.&r Inside the hollow volume, place vertical columns of &6Basic Reactor Fuel Rods&r from floor level up toward the ceiling.\n&e2.&r Start with one or two short columns — four rods is plenty for a first reactor.\n&e3.&r Leave the block directly above each column free for a &eControl Rod&r (next quest).",
		"",
		"&7Tip:&r Don't pack the entire interior on the first build; learn heat before you scale.",
		"",
		"&7Next:&r Control rods sit on top of each fuel column."
	]
	quest.B1000000000002C1.title: "Control Rods"
	quest.B1000000000002C1.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002C1.quest_desc: [
		"&6Goal:&r Craft &62 Basic Reactor Control Rods&r.",
		"",
		"Control rods cap each fuel column and let you throttle reactivity from the controller GUI. Insertion high = cooler, safer startup.",
		"",
		"&6How:&r\n&e1.&r Place a &6Basic Reactor Control Rod&r in the ceiling / top face directly above each fuel-rod column.\n&e2.&r Confirm every fuel column has a matching control rod — orphan rods won't moderate properly.\n&e3.&r Before inserting fuel, set insertion high (nearly fully inserted) so the first light-off stays gentle.",
		"",
		"&7Tip:&r Always throttle with rods before you add more fuel rods later.",
		"",
		"&7Next:&r A passive power tap pulls FE without a turbine."
	]
	quest.B1000000000002C2.title: "Power Tap"
	quest.B1000000000002C2.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002C2.quest_desc: [
		"&6Goal:&r Craft a Basic Passive FE Power Tap.",
		"",
		"Passive cooling dumps heat as FE through a power tap — the simplest Extreme Reactors setup. Active cooling (steam out → turbine) comes later for much higher output.",
		"",
		"&6How:&r\n&e1.&r Replace a face casing (not a corner) with the &6Passive FE Power Tap&r.\n&e2.&r Connect energy cables / conduits from the tap to a battery or your factory bus.\n&e3.&r Insert yellorium through an access port (next) or by hand, then slowly withdraw control rods while watching heat in the controller.",
		"",
		"&7Tip:&r If heat climbs faster than your cables can drain, push rods back in before you expand.",
		"",
		"&7Next:&r Access ports automate fuel in and cyanite out."
	]
	quest.B1000000000002C3.title: "Access Port"
	quest.B1000000000002C3.quest_subtitle: "Extreme Reactors · Reactor"
	quest.B1000000000002C3.quest_desc: [
		"&6Goal:&r Craft a Basic Solid Access Port.",
		"",
		"The solid access port is how yellorium enters and cyanite waste leaves. Automate it early so you aren't hand-feeding a hot core.",
		"",
		"&6How:&r\n&e1.&r Replace another face block with the &6Basic Solid Access Port&r.\n&e2.&r Configure the port for fuel input / waste output, then pipe yellorium in and cyanite out with item pipes or transporters.\n&e3.&r With port, tap, controller, fuel columns, and control rods in place, light the reactor and confirm FE on the tap.",
		"",
		"&7Tip:&r Cyanite stacks up fast — chest it or send it toward the reprocessor branch.",
		"",
		"&7Next:&r Two paths open: collect cyanite, or start the turbine line for active cooling."
	]
	quest.B1000000000002C4.title: "Cyanite Waste"
	quest.B1000000000002C4.quest_subtitle: "Extreme Reactors · Fuel cycle"
	quest.B1000000000002C4.quest_desc: [
		"&6Goal:&r Collect &68 Cyanite Ingots&r.",
		"",
		"Burned yellorium becomes cyanite. It's not trash — reprocessing turns waste into the next fuel tier toward blutonium and ludicrite.",
		"",
		"&6How:&r\n&e1.&r Run the reactor until spent fuel ejects as &6Cyanite&r through the access port.\n&e2.&r Pull eight ingots into your inventory (or a chest the quest can see).\n&e3.&r Stockpile the rest; the reprocessor will want a steady feed.",
		"",
		"&7Tip:&r Don't void cyanite if you care about the endgame fuel ladder.",
		"",
		"&7Next:&r Craft the reprocessor controller when you're ready to recycle."
	]
	quest.B1000000000002C5.title: "Turbine Housing"
	quest.B1000000000002C5.quest_subtitle: "Extreme Reactors · Turbine"
	quest.B1000000000002C5.quest_desc: [
		"&6Goal:&r Craft &620 Basic Turbine Housings&r.",
		"",
		"Active cooling vents steam from the reactor into a turbine multiblock. Steam → rotor → coils makes far more FE than a passive power tap alone.",
		"",
		"&6How:&r\n&e1.&r Build a hollow turbine shell from &6Basic Turbine Housing&r — leave room for a central rotor shaft, blades, coils, and a bearing.\n&e2.&r Plan fluid ports: steam in from the reactor (or a steam buffer), water/condensate out.\n&e3.&r Keep the turbine near the reactor so steam pipes stay short.",
		"",
		"&7Tip:&r Switch the reactor to active cooling only after the turbine shell and ports are ready.",
		"",
		"&7Next:&r The turbine controller assembles the multiblock."
	]
	quest.B1000000000002C6.title: "Turbine Controller"
	quest.B1000000000002C6.quest_subtitle: "Extreme Reactors · Turbine"
	quest.B1000000000002C6.quest_desc: [
		"&6Goal:&r Craft a Basic Turbine Controller.",
		"",
		"The controller validates the turbine and exposes RPM, steam intake, and energy output. Tune coil and blade counts from here.",
		"",
		"&6How:&r\n&e1.&r Place the &6Basic Turbine Controller&r on a housing face (not a corner).\n&e2.&r Add a rotor bearing, a straight &eRotor Shaft&r down the axis, and leave space for blades and inductive coils around/along the design JEI shows.\n&e3.&r Mount fluid ports for steam intake and water exhaust, plus a power tap for FE out.",
		"",
		"&7Tip:&r Match blades and coils to your steam supply — overspeed or under-coiled rotors waste efficiency.",
		"",
		"&7Next:&r Rotor blades catch the steam flow."
	]
	quest.B1000000000002C7.title: "Rotor Blades"
	quest.B1000000000002C7.quest_subtitle: "Extreme Reactors · Turbine"
	quest.B1000000000002C7.quest_desc: [
		"&6Goal:&r Craft &68 Basic Turbine Rotor Blades&r.",
		"",
		"Blades on the rotor convert steam flow into shaft RPM. Coils then turn that spin into FE — balance both sides of the machine.",
		"",
		"&6How:&r\n&e1.&r Attach &6Rotor Blades&r along the shaft per the turbine layout (pairs of blades on shaft segments).\n&e2.&r Install inductive coils in their designated coil region so RPM produces energy instead of free-spinning.\n&e3.&r Feed steam, watch RPM in the controller, and adjust blade/coil count if intake and induction don't match.",
		"",
		"&7Tip:&r Too many blades without coils stalls; too many coils without blades underproduce.",
		"",
		"&7Next:&r Meanwhile, recycle cyanite in the reprocessor."
	]
	quest.B1000000000002C8.title: "Cyanite Reprocessor"
	quest.B1000000000002C8.quest_subtitle: "Extreme Reactors · Fuel cycle"
	quest.B1000000000002C8.quest_desc: [
		"&6Goal:&r Craft a Reprocessor Controller.",
		"",
		"The cyanite reprocessor multiblock turns waste back into useful fuel feedstocks for the next tier — required if you want blutonium and ludicrite.",
		"",
		"&6How:&r\n&e1.&r Build the reprocessor shell from its casings (JEI / Patchouli list every part).\n&e2.&r Place the &6Collector&r on the bottom center and the &6Waste Injector&r on the top center.\n&e3.&r Put power, fluid, and output ports on the sides; pipe cyanite into the injector and pull products from the output.\n&e4.&r Power the machine and run a small cyanite batch to confirm the loop before you scale the reactor.",
		"",
		"&7Tip:&r Keep a buffer chest between the reactor access port and the waste injector.",
		"",
		"&7Next:&r Reinforced parts unlock larger, hotter cores."
	]
	quest.B1000000000002C9.title: "Reinforced Reactor"
	quest.B1000000000002C9.quest_subtitle: "Extreme Reactors · Endgame"
	quest.B1000000000002C9.quest_desc: [
		"&6Goal:&r Craft a Reinforced Reactor Controller.",
		"",
		"Reinforced reactors dwarf Basic size limits, handle hotter fuels, and pair with serious turbine loops. Upgrade when Basic heat or footprint is the bottleneck — not before cyanite recycling is stable.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Reinforced Reactor Controller&r and matching reinforced casings / rods as JEI shows.\n&e2.&r Build a larger hollow cuboid the same way: casing corners, hollow interior, fuel columns with control rods on top, ports on faces.\n&e3.&r Move to active cooling + turbine if you haven't already — Reinforced output will swamp a lone passive tap.",
		"",
		"&cCaution:&r Bigger cores melt faster when cooling or rod control lags. Commission cool before you fill every fuel column.",
		"",
		"&7Tip:&r Migrate your access-port automation and waste line before the first Reinforced light-off.",
		"",
		"&7Next:&r Ludicrite is the bragging-rights endgame metal."
	]
	quest.B1000000000002CA.title: "Ludicrite"
	quest.B1000000000002CA.quest_subtitle: "Extreme Reactors · Endgame"
	quest.B1000000000002CA.quest_desc: [
		"&6Goal:&r Craft &64 Ludicrite Ingots&r.",
		"",
		"Ludicrite is Extreme Reactors' endgame material — top-tier components and proof your fuel cycle (cyanite → blutonium → ludicrite) actually works.",
		"",
		"&6How:&r\n&e1.&r Follow JEI for &6Ludicrite&r — blutonium from reprocessing plus End-dimension or other gated ingredients typically appear.\n&e2.&r Keep the reprocessor fed so blutonium doesn't become the bottleneck mid-craft.\n&e3.&r Craft four ingots and stash spares for any ludicrite-tier parts you still want.",
		"",
		"&7Tip:&r If a ingredient looks alien, check the End and your cyanite stocks first."
	]
	quest.B1000000000002EE.title: "Forge Hammer"
	quest.B1000000000002EE.quest_subtitle: "Modern Industrialization · Age 1"
	quest.B1000000000002EE.quest_desc: [
		"&6Goal:&r Craft a Forge Hammer.",
		"",
		"MI starts with manual forging — plates, rods, rings, and bolts from ingots before steam machines take over.",
		"",
		"&6How:&r\n&e1.&r Craft and place the &6Forge Hammer&r.\n&e2.&r Right-click with &6Iron&r (and other) ingots to form plates/rods per JEI; repeat for a starter stockpile.\n&e3.&r Keep the hammer until bronze compressors automate plate spam.",
		"",
		"&7Tip:&r Pound a stack of iron plates now; bronze recipes will thank you.",
		"",
		"&7Next:&r Alloy copper and tin into Bronze.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B1000000000002EF.title: "Bronze Age"
	quest.B1000000000002EF.quest_subtitle: "Modern Industrialization · Age 1"
	quest.B1000000000002EF.quest_desc: [
		"&6Goal:&r Craft &616 Bronze Ingots&r.",
		"",
		"Bronze unlocks the first steam machines and boilers — MI's true beginning.",
		"",
		"&6How:&r\n&e1.&r Combine &6Copper&r + &6Tin&r into bronze via MI recipes (forge hammer dusts, mixing, or JEI path for this pack).\n&e2.&r Smelt dusts/blends into &6Bronze Ingots&r if needed.\n&e3.&r Hammer bronze into plates/rods for boiler and machine crafts.",
		"",
		"&7Tip:&r Create mixing can help if you already run a brass factory nearby.",
		"",
		"&7Next:&r Craft a Bronze Boiler and get steam flowing."
	]
	quest.B1000000000002F0.title: "Bronze Boiler"
	quest.B1000000000002F0.quest_subtitle: "Modern Industrialization · Steam"
	quest.B1000000000002F0.quest_desc: [
		"&6Goal:&r Craft a Bronze Boiler.",
		"",
		"Burns fuel with water to make steam — the lifeblood of every bronze-age machine.",
		"",
		"&6How:&r\n&e1.&r Place the &6Bronze Boiler&r; put solid fuel in the fuel slot.\n&e2.&r Pipe or bucket &6Water&r into the water hatch/tank — a dry boiler makes no steam.\n&e3.&r Connect &6Fluid Pipes&r from the steam output to the steam input of nearby bronze machines.\n&e4.&r Wrench pipe connections if steam is not arriving (MI pipes are directional).",
		"",
		"&7Tip:&r A Water Pump or continuous Create hose keeps boilers topped up.",
		"",
		"&7Next:&r Bronze Furnace for steam smelting."
	]
	quest.B1000000000002F1.title: "Bronze Furnace"
	quest.B1000000000002F1.quest_subtitle: "Modern Industrialization · Steam"
	quest.B1000000000002F1.quest_desc: [
		"&6Goal:&r Craft a Bronze Furnace.",
		"",
		"Steam-powered smelting that outpaces a vanilla furnace once steam is stable.",
		"",
		"&6How:&r\n&e1.&r Place the furnace beside the boiler; pipe &6Steam&r into its fluid input.\n&e2.&r Pipe ores/items into the item input; pull ingots from the output with item pipes.\n&e3.&r Use a wrench to set pipe push/pull so steam and items flow the right way.",
		"",
		"&7Tip:&r One boiler can feed several steam machines if pipe throughput holds.",
		"",
		"&7Next:&r Bronze Compressor to automate plates."
	]
	quest.B1000000000002F2.title: "Bronze Compressor"
	quest.B1000000000002F2.quest_subtitle: "Modern Industrialization · Steam"
	quest.B1000000000002F2.quest_desc: [
		"&6Goal:&r Craft a Bronze Compressor.",
		"",
		"Automates plates and compressed parts so you can retire the Forge Hammer for bulk work.",
		"",
		"&6How:&r\n&e1.&r Place and pipe in steam + ingots.\n&e2.&r Pull plates into a chest feeding machine crafts.\n&e3.&r Overproduce — steel-age recipes still want piles of plates.",
		"",
		"&7Tip:&r Keep a small forge hammer for odd parts the compressor does not cover yet.",
		"",
		"&7Next:&r Bronze Macerator for early dusts."
	]
	quest.B1000000000002F3.title: "Bronze Macerator"
	quest.B1000000000002F3.quest_subtitle: "Modern Industrialization · Steam"
	quest.B1000000000002F3.quest_desc: [
		"&6Goal:&r Craft a Bronze Macerator.",
		"",
		"Crush ores and solids with steam power — MI's early dust line and better ore yields.",
		"",
		"&6How:&r\n&e1.&r Pipe steam in; feed ores to the item input.\n&e2.&r Macerate → furnace (or further MI processing) for improved yield where recipes allow.\n&e3.&r Buffer dusts before the furnace so steam blips do not idle the line.",
		"",
		"&7Tip:&r Double-process ores when JEI shows a dust path with bonus outputs.",
		"",
		"&7Next:&r Build the Coke Oven multiblock for coal coke."
	]
	quest.B1000000000002F4.title: "Coke Oven"
	quest.B1000000000002F4.quest_subtitle: "Modern Industrialization · Steel"
	quest.B1000000000002F4.quest_desc: [
		"&6Goal:&r Build a Coke Oven multiblock.",
		"",
		"Coal coke and creosote start the steel path — required fuel/input for the Steam Blast Furnace.",
		"",
		"&6How:&r\n&e1.&r Craft &6Coke Oven Bricks&r (fire clay path — JEI) and check the in-game guidebook shape.\n&e2.&r Build the hollow brick structure; place &6Item/Fluid Hatches&r where the diagram shows.\n&e3.&r Use the &6Wrench&r to form/configure the controller once the shape is valid.\n&e4.&r Feed coal; pull coke from the item hatch and creosote from the fluid hatch into a tank.",
		"",
		"&7Tip:&r Creosote is useful for treated wood elsewhere — store it instead of voiding.",
		"",
		"&7Next:&r Steam Blast Furnace for steel."
	]
	quest.B1000000000002F5.title: "Steam Blast Furnace"
	quest.B1000000000002F5.quest_subtitle: "Modern Industrialization · Steel"
	quest.B1000000000002F5.quest_desc: [
		"&6Goal:&r Build a Steam Blast Furnace.",
		"",
		"Blasts iron with coke toward steel — the gate to steel machines and the electric age.",
		"",
		"&6How:&r\n&e1.&r Follow JEI/guidebook for the &6Steam Blast Furnace&r brick shape (fire-clay / coke oven bricks).\n&e2.&r Replace edge/face blocks with &6Item Inputs&r, &6Item Outputs&r, and &6Fluid Inputs&r (steam) hatches as required.\n&e3.&r Wrench the controller to form the multiblock when the shape turns valid.\n&e4.&r Pipe steam from boilers, insert iron + coke per recipe, pull steel from the output hatch.",
		"",
		"&cCaution:&r Missing or wrong-tier hatches prevent formation — compare every layer to the guide.",
		"",
		"&7Tip:&r Keep steam pressure high; starved SBFs crawl. Parallel bronze boilers help.",
		"",
		"&7Next:&r Stockpile Steel Ingots."
	]
	quest.B1000000000002F6.title: "Steel Stockpile"
	quest.B1000000000002F6.quest_subtitle: "Modern Industrialization · Steel"
	quest.B1000000000002F6.quest_desc: [
		"&6Goal:&r Produce &616 Steel Ingots&r.",
		"",
		"Steel unlocks stronger machines, better boilers, hulls, and the jump toward electricity.",
		"",
		"&6How:&r\n&e1.&r Run iron + coke through the Steam Blast Furnace until you have 16+ &6Steel Ingots&r.\n&e2.&r Immediately compress/hammer plates and rods — steel machine crafts eat them.",
		"",
		"&7Tip:&r Batch plates and rods right after the first steel pour.",
		"",
		"&7Next:&r Steel Boiler and Analog Circuits in parallel."
	]
	quest.B1000000000002F7.title: "Steel Boiler"
	quest.B1000000000002F7.quest_subtitle: "Modern Industrialization · Steel"
	quest.B1000000000002F7.quest_desc: [
		"&6Goal:&r Craft a Steel Boiler.",
		"",
		"Higher steam output for steel-tier machines, larger steam multiblocks, and denser factories.",
		"",
		"&6How:&r\n&e1.&r Craft and place the &6Steel Boiler&r; feed fuel + water like the bronze version.\n&e2.&r Upgrade fluid pipe networks when steam demand outruns bronze boilers.\n&e3.&r Optional: progress toward a &6Large Steam Boiler&r multiblock when single-block boilers fall behind.",
		"",
		"&7Tip:&r Water input rate is as important as fuel — add pumps early.",
		"",
		"&7Next:&r Analog Circuits for electric machines."
	]
	quest.B1000000000002F8.title: "Analog Circuits"
	quest.B1000000000002F8.quest_subtitle: "Modern Industrialization · Electric"
	quest.B1000000000002F8.quest_desc: [
		"&6Goal:&r Craft &68 Analog Circuits&r.",
		"",
		"Circuits are MI's long progression spine — analog today, electronic/digital/quantum later.",
		"",
		"&6How:&r\n&e1.&r Craft circuit boards and analog components per JEI (wires, resistors, plates).\n&e2.&r Assemble &6Analog Circuits&r in batches of 8+.\n&e3.&r Start automating board ingredients before the craft spam hurts.",
		"",
		"&7Tip:&r A dedicated steam assembler line for circuits pays for itself quickly.",
		"",
		"&7Next:&r Basic Machine Hulls for LV electric machines."
	]
	quest.B1000000000002F9.title: "Basic Machine Hull"
	quest.B1000000000002F9.quest_subtitle: "Modern Industrialization · Electric"
	quest.B1000000000002F9.quest_desc: [
		"&6Goal:&r Craft &64 Basic Machine Hulls&r.",
		"",
		"Electric machines are built on hulls. Basic hulls cover LV; advanced tiers follow.",
		"",
		"&6How:&r\n&e1.&r Craft hulls from steel/analog parts (JEI).\n&e2.&r Stock motors, cables, and conveyors alongside — they share materials with hull crafts.",
		"",
		"&7Tip:&r Never craft just one hull; the next four machines will want them immediately.",
		"",
		"&7Next:&r Motors, then Electric Macerator."
	]
	quest.B1000000000002FA.title: "Motors"
	quest.B1000000000002FA.quest_subtitle: "Modern Industrialization · Electric"
	quest.B1000000000002FA.quest_desc: [
		"&6Goal:&r Craft &64 Motors&r.",
		"",
		"Motors drive electric machines and appear in countless component recipes.",
		"",
		"&6How:&r\n&e1.&r Craft &6Tin Cables&r / rubber-insulated wire as JEI requires.\n&e2.&r Assemble &6Motors&r from rods, cables, and magnetic parts.\n&e3.&r Keep extras — conveyors, robot arms, and generators eat motors too.",
		"",
		"&7Tip:&r Rubber often gates early motor crafts — solve latex/rubber before mass production.",
		"",
		"&7Next:&r Electric Macerator on LV power."
	]
	quest.B1000000000002FB.title: "Electric Macerator"
	quest.B1000000000002FB.quest_subtitle: "Modern Industrialization · Electric"
	quest.B1000000000002FB.quest_desc: [
		"&6Goal:&r Craft an Electric Macerator.",
		"",
		"EU/FE-powered crushing for serious ore throughput once LV power is online.",
		"",
		"&6How:&r\n&e1.&r Place the macerator; connect &6LV Cables&r from a generator or energy storage to the energy hatch/side.\n&e2.&r Pipe items in/out; wrench cable and pipe ends if IO is wrong.\n&e3.&r Feed dusts into electric furnaces or further MI processing lines.",
		"",
		"&7Tip:&r Pull dusts into RS or Create storage so the machine never jams full.",
		"",
		"&7Next:&r LV Diesel Generator for steady power."
	]
	quest.B1000000000002FC.title: "LV Diesel Generator"
	quest.B1000000000002FC.quest_subtitle: "Modern Industrialization · Electric"
	quest.B1000000000002FC.quest_desc: [
		"&6Goal:&r Craft an LV Diesel Generator.",
		"",
		"Burns diesel/biodiesel for steady LV energy when steam turbines are not enough.",
		"",
		"&6How:&r\n&e1.&r Place the generator; pipe &6Diesel&r or &6Biodiesel&r into the fluid input.\n&e2.&r Connect LV cables from the energy output to machines or a storage block.\n&e3.&r Buffer fuel in a tank so the generator does not pulse empty.",
		"",
		"&7Tip:&r Oil drilling and distillation unlock proper fuel logistics later.",
		"",
		"&7Next:&r Electronic Circuits for MV progression."
	]
	quest.B1000000000002FD.title: "Electronic Circuits"
	quest.B1000000000002FD.quest_subtitle: "Modern Industrialization · Mid game"
	quest.B1000000000002FD.quest_desc: [
		"&6Goal:&r Craft &64 Electronic Circuits&r.",
		"",
		"MV progression and better machines demand electronic circuits — the next circuit factory tier.",
		"",
		"&6How:&r\n&e1.&r Unlock and craft electronic-tier boards/components (JEI).\n&e2.&r Assemble &6Electronic Circuits&r; automate boards before you feel the spam.",
		"",
		"&7Tip:&r Treat circuit crafting as its own factory wing, not a crafting-table chore.",
		"",
		"&7Next:&r Electric Quarry for bulk resources."
	]
	quest.B1000000000002FE.title: "Electric Quarry"
	quest.B1000000000002FE.quest_subtitle: "Modern Industrialization · Mid game"
	quest.B1000000000002FE.quest_desc: [
		"&6Goal:&r Craft an Electric Quarry.",
		"",
		"Automated area mining with drill heads and power — MI's answer to bulk resource gathering.",
		"",
		"&6How:&r\n&e1.&r Place the &6Electric Quarry&r with clear working volume below/around per guidebook.\n&e2.&r Insert &6Drill Heads&r and connect serious LV/MV power.\n&e3.&r Pipe or inventory-pull mined items into storage; restock drill heads as they wear.\n&e4.&r Wrench/configure the work area before leaving it running overnight.",
		"",
		"&cCaution:&r Quarries erase terrain in their zone — do not aim one under your base.",
		"",
		"&7Tip:&r Clear the work area and supply drill heads before activating.",
		"",
		"&7Next:&r Digital Circuits for HV-tier brains."
	]
	quest.B1000000000002FF.title: "Digital Circuits"
	quest.B1000000000002FF.quest_subtitle: "Modern Industrialization · Late"
	quest.B1000000000002FF.quest_desc: [
		"&6Goal:&r Craft &62 Digital Circuits&r.",
		"",
		"HV-tier brains for advanced machines and late multiblocks.",
		"",
		"&6How:&r\n&e1.&r Craft digital-tier components from electronic circuits and advanced parts (JEI).\n&e2.&r Assemble &6Digital Circuits&r; keep the line automated.",
		"",
		"&7Tip:&r If circuit crafting is still manual, fix that before HV multiblocks.",
		"",
		"&7Next:&r Chapter complete — push large boilers, blast furnaces, and HV machines next."
	]
	quest.B100000000000320.title: "Pity Machine Frame"
	quest.B100000000000320.quest_subtitle: "Industrial Foregoing · Frames"
	quest.B100000000000320.quest_desc: [
		"&6Goal:&r Craft &64 Pity Machine Frames&r.",
		"",
		"Industrial Foregoing starts with Pity frames — wooden-tier chassis for extractors and early machines.",
		"",
		"&6How:&r\n&e1.&r Craft &6Pity Machine Frames&r from wood, iron, and redstone parts (JEI).\n&e2.&r Keep extras — Fluid Extractors and the Latex Processing Unit each want frames.",
		"",
		"&7Tip:&r You will rebuild these into Simple/Advanced/Supreme frames as you climb.",
		"",
		"&7Next:&r Fluid Extractors against a tree line.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B100000000000321.title: "Fluid Extractor"
	quest.B100000000000321.quest_subtitle: "Industrial Foregoing · Latex"
	quest.B100000000000321.quest_desc: [
		"&6Goal:&r Craft &62 Fluid Extractors&r.",
		"",
		"Extractors pull &6Latex&r from logs — the start of dry rubber and plastic.",
		"",
		"&6How:&r\n&e1.&r Place each &6Fluid Extractor&r facing into a log (oak and most logs work).\n&e2.&r Power the extractors (Pitiful Generator later, or any FE cable).\n&e3.&r Pipe latex out of the fluid side into a tank or straight into the Latex Processing Unit.\n&e4.&r Keep a tree farm or Plant Gatherer replacing logs as they get stripped/consumed.",
		"",
		"&7Tip:&r Multiple extractors on one trunk speed latex if the wood type allows.",
		"",
		"&7Next:&r Latex Processing Unit to make dry rubber."
	]
	quest.B100000000000322.title: "Latex Processing"
	quest.B100000000000322.quest_subtitle: "Industrial Foregoing · Latex"
	quest.B100000000000322.quest_desc: [
		"&6Goal:&r Craft a Latex Processing Unit.",
		"",
		"Turns latex into tiny dry rubber → dry rubber → plastic — IF's core material chain.",
		"",
		"&6How:&r\n&e1.&r Place the unit; connect FE and pipe in &6Latex&r + &6Water&r.\n&e2.&r Pull &6Tiny Dry Rubber&r / &6Dry Rubber&r from the item output into a chest.\n&e3.&r Buffer latex in a fluid tank so extractors never back up into a full machine.",
		"",
		"&7Tip:&r Water and power keep the unit running — a sink or Create hose is enough water.",
		"",
		"&7Next:&r Craft Plastic from dry rubber."
	]
	quest.B100000000000323.title: "Plastic"
	quest.B100000000000323.quest_subtitle: "Industrial Foregoing · Latex"
	quest.B100000000000323.quest_desc: [
		"&6Goal:&r Craft &616 Plastic&r.",
		"",
		"Plastic appears in nearly every IF machine and upgrade. Overproduce early.",
		"",
		"&6How:&r\n&e1.&r Compress or craft &6Dry Rubber&r from tiny dry rubber (JEI).\n&e2.&r Smelt/craft dry rubber into &6Plastic&r.\n&e3.&r Stockpile at least a stack before building Simple-tier machines.",
		"",
		"&7Tip:&r Pink slime later supplements high-tier crafts — plastic never stops being useful.",
		"",
		"&7Next:&r Upgrade to Simple Machine Frames."
	]
	quest.B100000000000324.title: "Simple Machine Frame"
	quest.B100000000000324.quest_subtitle: "Industrial Foregoing · Frames"
	quest.B100000000000324.quest_desc: [
		"&6Goal:&r Craft &62 Simple Machine Frames&r.",
		"",
		"Simple frames unlock the main farming, generator, and mob machines.",
		"",
		"&6How:&r\n&e1.&r Craft Simple frames from &6Pity Frames&r + &6Plastic&r + iron-tier materials (JEI).\n&e2.&r Save them for Plant Sower/Gatherer, Pitiful Generator, and Mob Slaughter.",
		"",
		"&7Tip:&r Iron, plastic, and pity frames typically combine here — check JEI.",
		"",
		"&7Next:&r Pitiful Generator to bootstrap FE."
	]
	quest.B100000000000325.title: "Pitiful Generator"
	quest.B100000000000325.quest_subtitle: "Industrial Foregoing · Power"
	quest.B100000000000325.quest_desc: [
		"&6Goal:&r Craft a Pitiful Generator.",
		"",
		"A humble solid-fuel FE generator to bootstrap IF machines before biofuel or pink-slime power.",
		"",
		"&6How:&r\n&e1.&r Place the generator near your latex/farm machines.\n&e2.&r Insert solid fuel; pull FE out with energy cables/conduits into machine sides.\n&e3.&r Replace later with Biofuel or Protein generators once farms and mob lines run.",
		"",
		"&7Tip:&r One generator can feed several early machines if you buffer with an energy cell.",
		"",
		"&7Next:&r Plant Sower for crop automation."
	]
	quest.B100000000000326.title: "Plant Sower"
	quest.B100000000000326.quest_subtitle: "Industrial Foregoing · Farming"
	quest.B100000000000326.quest_desc: [
		"&6Goal:&r Craft a Plant Sower.",
		"",
		"Auto-plants seeds in a working area — the start of IF crop automation.",
		"",
		"&6How:&r\n&e1.&r Place the &6Plant Sower&r facing a farmland / Hydroponic Bed grid.\n&e2.&r Power it; put seeds in the input slots.\n&e3.&r Open the GUI and set the work area (or insert &6Range Addons&r).\n&e4.&r Pair with a Plant Gatherer covering the same plots.",
		"",
		"&7Tip:&r Fertilizer addon / fertilizer fluid speeds growth when you are ready.",
		"",
		"&7Next:&r Plant Gatherer to harvest the field."
	]
	quest.B100000000000327.title: "Plant Gatherer"
	quest.B100000000000327.quest_subtitle: "Industrial Foregoing · Farming"
	quest.B100000000000327.quest_desc: [
		"&6Goal:&r Craft a Plant Gatherer.",
		"",
		"Harvests grown crops into its inventory or pipes — essential beside the sower.",
		"",
		"&6How:&r\n&e1.&r Place the Gatherer so its area overlaps the sower's crops.\n&e2.&r Power it; insert &6Range&r and &6Speed Addons&r as needed.\n&e3.&r Pipe crops out to storage; return seeds to the Sower.",
		"",
		"&7Tip:&r Speed addons keep up with bone-meal or fertilizer spam.",
		"",
		"&7Next:&r Hydroponic Beds for compact indoor farms."
	]
	quest.B100000000000328.title: "Hydroponic Bed"
	quest.B100000000000328.quest_subtitle: "Industrial Foregoing · Farming"
	quest.B100000000000328.quest_desc: [
		"&6Goal:&r Craft &62 Hydroponic Beds&r.",
		"",
		"Compact soil substitutes for dense indoor farms without vanilla farmland water tricks.",
		"",
		"&6How:&r\n&e1.&r Craft and place &6Hydroponic Beds&r in a grid under your sower/gatherer.\n&e2.&r Plant via the Plant Sower as if they were farmland.\n&e3.&r Pipe water/fertilizer into beds if the recipe/GUI requires fluid for max speed.",
		"",
		"&7Tip:&r Great under sowers when you do not want to manage vanilla farmland water.",
		"",
		"&7Next:&r Mob Slaughter Factory on a separate branch."
	]
	quest.B100000000000329.title: "Mob Slaughter"
	quest.B100000000000329.quest_subtitle: "Industrial Foregoing · Mobs"
	quest.B100000000000329.quest_desc: [
		"&6Goal:&r Craft a Mob Slaughter Factory.",
		"",
		"Grinds mobs into meat and &6Pink Slime&r fluid — brutal but efficient for frames and infinity tools.",
		"",
		"&6How:&r\n&e1.&r Build a contained mob spawn area (dark room, spawner, or cursed earth style).\n&e2.&r Place the &6Mob Slaughter Factory&r so mobs walk into its working range; power it.\n&e3.&r Pipe &6Meat&r and &6Pink Slime&r fluids into tanks; pull item drops if enabled.\n&e4.&r Insert range/speed addons so the kill box covers the whole pad.",
		"",
		"&cCaution:&r Open kill boxes near your base are messy — wall them in and vacuum items.",
		"",
		"&7Tip:&r Pink slime fluid is the prize — do not void it.",
		"",
		"&7Next:&r Dissolution Chamber for pink slime crafting."
	]
	quest.B10000000000032A.title: "Dissolution Chamber"
	quest.B10000000000032A.quest_subtitle: "Industrial Foregoing · Processing"
	quest.B10000000000032A.quest_desc: [
		"&6Goal:&r Craft a Dissolution Chamber.",
		"",
		"Mixes items and fluids into advanced IF components, including pink slimeballs and many mid/late crafts.",
		"",
		"&6How:&r\n&e1.&r Place and power the chamber; pipe in required fluids (pink slime, latex, etc. per JEI).\n&e2.&r Insert catalog items into the item slots for the recipe.\n&e3.&r Pull crafted outputs automatically — keep one chamber piped as a permanent station.",
		"",
		"&7Tip:&r Many mid/late crafts are dissolution recipes — treat it like a second crafting table with tanks.",
		"",
		"&7Next:&r Collect Pink Slimeballs."
	]
	quest.B10000000000032B.title: "Pink Slime"
	quest.B10000000000032B.quest_subtitle: "Industrial Foregoing · Mobs"
	quest.B10000000000032B.quest_desc: [
		"&6Goal:&r Collect &68 Pink Slimeballs&r.",
		"",
		"Pink slime is the prestige goo for Advanced/Supreme frames and infinity tools.",
		"",
		"&6How:&r\n&e1.&r Pipe pink slime fluid from the Mob Slaughter Factory into the Dissolution Chamber.\n&e2.&r Run the slimeball recipes; stockpile at least 8.",
		"",
		"&7Tip:&r Mob slaughter is the usual farm — never discard slime fluid.",
		"",
		"&7Next:&r Advanced Machine Frame."
	]
	quest.B10000000000032C.title: "Advanced Frame"
	quest.B10000000000032C.quest_subtitle: "Industrial Foregoing · Frames"
	quest.B10000000000032C.quest_desc: [
		"&6Goal:&r Craft an Advanced Machine Frame.",
		"",
		"Advanced frames unlock stronger generators, ore lasers, and late machines.",
		"",
		"&6How:&r\n&e1.&r Craft from &6Simple Frames&r + &6Plastic&r + &6Pink Slime&r + gold-tier materials (JEI).\n&e2.&r Reserve the first frame for the Ore Laser Base.",
		"",
		"&7Tip:&r Automate plastic and pink slime before you need a second Advanced frame.",
		"",
		"&7Next:&r Ore Laser Base."
	]
	quest.B10000000000032D.title: "Ore Laser Base"
	quest.B10000000000032D.quest_subtitle: "Industrial Foregoing · Lasers"
	quest.B10000000000032D.quest_desc: [
		"&6Goal:&r Craft an Ore Laser Base.",
		"",
		"Laser drills mine specific ores from a vertical beam when paired with a lens and drill — excellent for rare resources.",
		"",
		"&6How:&r\n&e1.&r Place the &6Ore Laser Base&r with clear vertical space for the beam.\n&e2.&r Power it heavily; insert the correct &6Laser Lens&r for your target ore (JEI weights).\n&e3.&r Mount a &6Laser Drill&r above/below as the structure requires.\n&e4.&r Pipe ores out; biome and dimension affect drop tables — check JEI.",
		"",
		"&7Tip:&r Power hungry but steady once tuned — buffer FE beside the base.",
		"",
		"&7Next:&r Craft the Laser Drill itself."
	]
	quest.B10000000000032E.title: "Laser Drill"
	quest.B10000000000032E.quest_subtitle: "Industrial Foregoing · Lasers"
	quest.B10000000000032E.quest_desc: [
		"&6Goal:&r Craft a Laser Drill.",
		"",
		"Works with the Ore Laser Base and lens to actually mine the ore table.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Laser Drill&r and place it on the laser base stack per JEI/guidebook.\n&e2.&r Confirm the lens in the base matches the ore you want.\n&e3.&r Pull outputs into storage; swap lenses when changing targets.",
		"",
		"&7Tip:&r Biome and dimension affect tables — check JEI for lens weights before building a second drill.",
		"",
		"&7Next:&r Supreme Machine Frame for endgame tools."
	]
	quest.B10000000000032F.title: "Supreme Frame"
	quest.B10000000000032F.quest_subtitle: "Industrial Foregoing · Endgame"
	quest.B10000000000032F.quest_desc: [
		"&6Goal:&r Craft a Supreme Machine Frame.",
		"",
		"Top chassis tier for the strongest IF machines and infinity tool crafting.",
		"",
		"&6How:&r\n&e1.&r Craft from Advanced frames + pink slime + late materials (JEI).\n&e2.&r By now latex, plastic, and pink slime lines should be fully automatic.",
		"",
		"&7Tip:&r Make two if you plan multiple infinity tools.",
		"",
		"&7Next:&r Infinity Drill."
	]
	quest.B100000000000330.title: "Infinity Drill"
	quest.B100000000000330.quest_subtitle: "Industrial Foregoing · Endgame"
	quest.B100000000000330.quest_desc: [
		"&6Goal:&r Craft an Infinity Drill.",
		"",
		"A chargeable, upgradeable drill that grows with additives — IF's signature mining tool.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Infinity Drill&r at the Dissolution Chamber / crafting path JEI shows (Supreme frame tier).\n&e2.&r Charge it with FE; open the GUI to add tank size, speed, and special additives.\n&e3.&r Mine in area modes once upgraded — keep a power station nearby for top-ups.",
		"",
		"&7Tip:&r Feed it power and materials; tank size and speed upgrades change everything.",
		"",
		"&7Next:&r Chapter complete — ether gas and more infinity tools await in JEI when you are ready."
	]
	quest.B100000000000352.title: "Engineer's Hammer"
	quest.B100000000000352.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000352.quest_desc: [
		"&6Goal:&r Craft an Engineer's Hammer.",
		"",
		"Multiblock formation, plate crafting, and most IE interactions start with this hammer — keep it hotbarred.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Engineer's Hammer&r (iron + stick pattern — JEI).\n&e2.&r Right-click metal ingots in-world or in crafting contexts to form plates when recipes call for hammering.\n&e3.&r After building a brick multiblock, right-click the center face block to form it.",
		"",
		"&7Tip:&r Without the hammer, Coke Ovens and Blast Furnaces stay as pretty brick piles.",
		"",
		"&7Next:&r Craft the Engineer's Manual for in-game diagrams.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Iron Stockpile\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B10000000000006A\"}}"
	]
	quest.B100000000000353.title: "Engineer's Manual"
	quest.B100000000000353.quest_subtitle: "Immersive Engineering · Tools"
	quest.B100000000000353.quest_desc: [
		"&6Goal:&r Craft the Engineer's Manual.",
		"",
		"In-game documentation for every multiblock, wire tier, and blueprint — worth a permanent offhand/Curios slot.",
		"",
		"&6How:&r\n&e1.&r Craft the &6Engineer's Manual&r and open it.\n&e2.&r Find the Coke Oven / Blast Furnace pages and note the 3×3×3 brick layouts before you place blocks.",
		"",
		"&7Tip:&r Form structures exactly as the book shows; the hammer click confirms when they assemble.",
		"",
		"&7Next:&r Make Treated Wood once you have creosote (or bootstrap from another coke source)."
	]
	quest.B100000000000354.title: "Treated Wood"
	quest.B100000000000354.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000354.quest_desc: [
		"&6Goal:&r Craft &632 Treated Wood Planks&r.",
		"",
		"Creosote-treated wood is IE scaffolding for waterwheels, windmills, crafting stations, and many recipes.",
		"",
		"&6How:&r\n&e1.&r Obtain &6Creosote Oil&r from a Coke Oven (or another mod's coke byproduct).\n&e2.&r Craft planks with creosote in the crafting grid / JEI recipe to make &6Treated Wood&r.\n&e3.&r Stock a chest — sails, scaffolds, and engineering crafts burn through it.",
		"",
		"&7Tip:&r Pipe creosote into a wooden barrel or tank so the Coke Oven never voids fluid.",
		"",
		"&7Next:&r Grow Industrial Hemp for fabric and insulation."
	]
	quest.B100000000000355.title: "Industrial Hemp"
	quest.B100000000000355.quest_subtitle: "Immersive Engineering · Materials"
	quest.B100000000000355.quest_desc: [
		"&6Goal:&r Collect &624 Industrial Hemp Fibers&r.",
		"",
		"Hemp makes tough fabric for windmill sails, wiring insulation, and engineering crafts.",
		"",
		"&6How:&r\n&e1.&r Find or craft &6Industrial Hemp Seeds&r and plant them on farmland.\n&e2.&r Harvest mature hemp for fibers; craft fabric/rope as recipes need.",
		"",
		"&7Tip:&r Farm hemp like a crop — rope and fabric recipes burn stacks.",
		"",
		"&7Next:&r Craft Coke Bricks for the Coke Oven multiblock."
	]
	quest.B100000000000356.title: "Coke Bricks"
	quest.B100000000000356.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000356.quest_desc: [
		"&6Goal:&r Craft &627 Coke Bricks&r.",
		"",
		"Exactly 27 Coke Bricks build the 3×3×3 Coke Oven — coal in, coal coke + creosote out.",
		"",
		"&6How:&r\n&e1.&r Craft &627 Coke Bricks&r (clay + sand + brick pattern — JEI).\n&e2.&r Build a solid &63×3×3&r cube of Coke Bricks on flat ground.\n&e3.&r Right-click the &6center block of any face&r with the &6Engineer's Hammer&r to form the Coke Oven.\n&e4.&r Open the formed oven GUI — if it did not form, recheck the cube is complete and flush.",
		"",
		"&7Tip:&r Leave space beside one face for hoppers/pipes; the GUI face is where you hammered.",
		"",
		"&7Next:&r Run coal through for Coal Coke and creosote."
	]
	quest.B100000000000357.title: "Coal Coke"
	quest.B100000000000357.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000357.quest_desc: [
		"&6Goal:&r Produce &616 Coal Coke&r from a Coke Oven.",
		"",
		"Coke fuels the Blast Furnace. Creosote byproduct treats wood for more IE structures.",
		"",
		"&6How:&r\n&e1.&r Put &6Coal&r (or cokeable blocks) into the Coke Oven input.\n&e2.&r Wait for the process; pull &6Coal Coke&r from the item output.\n&e3.&r Pipe or bucket &6Creosote&r from the fluid output into a tank/barrel — do not let it void.",
		"",
		"&7Tip:&r Hopper coal in and coke out for a hands-free coke stack.",
		"",
		"&7Next:&r Craft Blast Bricks for the Crude Blast Furnace."
	]
	quest.B100000000000358.title: "Blast Bricks"
	quest.B100000000000358.quest_subtitle: "Immersive Engineering · Multiblocks"
	quest.B100000000000358.quest_desc: [
		"&6Goal:&r Craft &627 Blast Bricks&r.",
		"",
		"Assemble a Crude Blast Furnace and hammer-form it to smelt iron + coke into steel.",
		"",
		"&6How:&r\n&e1.&r Craft &627 Blast Bricks&r.\n&e2.&r Build a solid &63×3×3&r cube of Blast Bricks (same shape as the Coke Oven).\n&e3.&r Engineer's Hammer the &6center of a face&r to form the Crude Blast Furnace.\n&e4.&r Later: upgrade bricks to &6Reinforced Blast Bricks&r for the Improved Blast Furnace (faster, keeps fuel).",
		"",
		"&7Tip:&r Keep coke and iron chests next to the GUI face before you start steel runs.",
		"",
		"&7Next:&r Smelt your first IE Steel batch."
	]
	quest.B100000000000359.title: "IE Steel"
	quest.B100000000000359.quest_subtitle: "Immersive Engineering · Steel"
	quest.B100000000000359.quest_desc: [
		"&6Goal:&r Produce &616 Steel Ingots&r via Immersive Engineering.",
		"",
		"Steel feeds Heavy Engineering blocks, steel scaffolding, HV components, and many multiblocks.",
		"",
		"&6How:&r\n&e1.&r In the Blast Furnace GUI, add &6Iron Ingots&r and &6Coal Coke&r as fuel/input (JEI shows ratios).\n&e2.&r Collect &6Steel Ingots&r and &6Slag&r from the outputs.\n&e3.&r Hopper slag aside so it does not clog the item output.",
		"",
		"&7Tip:&r Improved Blast Furnace recycles coke better — upgrade when steel demand spikes.",
		"",
		"&7Next:&r Craft Light Engineering Blocks from components."
	]
	quest.B10000000000035A.title: "Light Engineering"
	quest.B10000000000035A.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035A.quest_desc: [
		"&6Goal:&r Craft &68 Light Engineering Blocks&r.",
		"",
		"Component blocks for mid-tier IE machines, workbenches, and many multiblock recipes.",
		"",
		"&6How:&r\n&e1.&r Craft &6Iron Components&r / related parts (plates, copper) as JEI shows.\n&e2.&r Assemble &6Light Engineering Blocks&r in batches of 8+.",
		"",
		"&7Tip:&r Create presses help plate spam if you already have a brass factory.",
		"",
		"&7Next:&r Heavy Engineering for crushers, diesel, and arc furnaces."
	]
	quest.B10000000000035B.title: "Heavy Engineering"
	quest.B10000000000035B.quest_subtitle: "Immersive Engineering · Components"
	quest.B10000000000035B.quest_desc: [
		"&6Goal:&r Craft &64 Heavy Engineering Blocks&r.",
		"",
		"Steel-tier component blocks for crushers, diesel generators, excavators, and arc furnaces.",
		"",
		"&6How:&r\n&e1.&r Craft steel components / sheetmetal as required (JEI).\n&e2.&r Assemble &6Heavy Engineering Blocks&r; store beside steel scaffolding.",
		"",
		"&7Tip:&r Keep steel sheetmetal and scaffolding in the same chest as these blocks.",
		"",
		"&7Next:&r Engineer's Workbench for blueprints, then wiring."
	]
	quest.B10000000000035C.title: "Engineer's Workbench"
	quest.B10000000000035C.quest_subtitle: "Immersive Engineering · Crafting"
	quest.B10000000000035C.quest_desc: [
		"&6Goal:&r Craft an Engineer's Workbench.",
		"",
		"Craft blueprints, schematics, and specialized IE recipes — electrodes and many tools start here.",
		"",
		"&6How:&r\n&e1.&r Craft and place the &6Engineer's Workbench&r.\n&e2.&r Insert a &6Blueprint&r (engineer's craft) and the listed materials to make blueprint items.\n&e3.&r Use it for Graphite Electrodes and other schematic crafts before Arc Furnace work.",
		"",
		"&7Tip:&r The Automated Workbench later runs blueprint recipes hands-free.",
		"",
		"&7Next:&r LV Copper Coils to start the power grid."
	]
	quest.B10000000000035D.title: "LV Copper Coils"
	quest.B10000000000035D.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035D.quest_desc: [
		"&6Goal:&r Craft &616 LV Wire Coils&r.",
		"",
		"Spool copper coils between LV connectors to move Immersive Flux (IFE) across your workshop.",
		"",
		"&6How:&r\n&e1.&r Craft &6Copper Wire&r then wind &6LV Wire Coils&r.\n&e2.&r Hold a coil and right-click from one connector to another to string the wire.\n&e3.&r Use &6Wire Cutters&r to remove bad links; add &6LV Relays&r to extend long runs.",
		"",
		"&7Tip:&r Do not mix LV coils onto MV/HV connectors — voltage tiers are separate.",
		"",
		"&7Next:&r Craft LV Wire Connectors to attach to machines."
	]
	quest.B10000000000035E.title: "LV Connectors"
	quest.B10000000000035E.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035E.quest_desc: [
		"&6Goal:&r Craft &68 LV Wire Connectors&r.",
		"",
		"Connectors attach to machines and capacitors — then you spool wire between them.",
		"",
		"&6How:&r\n&e1.&r Place &6LV Wire Connectors&r on machine faces or capacitor sides that should receive/send power.\n&e2.&r String &6LV Wire Coils&r connector-to-connector.\n&e3.&r Add an &6LV Transformer&r (or MV/HV equivalents) when stepping between voltage tiers.",
		"",
		"&cCaution:&r Wrong-tier wire on a connector fails or wastes the coil — match LV/MV/HV.",
		"",
		"&7Tip:&r Capacitors in the middle of a run buffer brownouts from kinetic dynamos.",
		"",
		"&7Next:&r Craft an LV Accumulator for storage."
	]
	quest.B10000000000035F.title: "LV Accumulator"
	quest.B10000000000035F.quest_subtitle: "Immersive Engineering · Power"
	quest.B10000000000035F.quest_desc: [
		"&6Goal:&r Craft an LV Accumulator.",
		"",
		"Buffers IFE so waterwheels, windmills, and diesel generators do not brown out machines mid-craft.",
		"",
		"&6How:&r\n&e1.&r Place the &6LV Accumulator&r near your machine cluster.\n&e2.&r Put connectors on the capacitor and on machines; spool LV wire between them.\n&e3.&r Feed power from a Kinetic Dynamo / Diesel Generator into the capacitor first, then out to loads.",
		"",
		"&7Tip:&r Upgrade to MV/HV capacitors as you climb wire tiers and Arc Furnace power draw.",
		"",
		"&7Next:&r Optional kinetic: Windmill — or Radiators toward diesel."
	]
	quest.B100000000000360.title: "Windmill"
	quest.B100000000000360.quest_subtitle: "Immersive Engineering · Kinetic"
	quest.B100000000000360.quest_desc: [
		"&6Goal:&r Craft a Windmill.",
		"",
		"Kinetic power from wind — attach sails and convert through a Kinetic Dynamo into IFE.",
		"",
		"&6How:&r\n&e1.&r Place the &6Windmill&r high with clear air around the blades.\n&e2.&r Craft &6Windmill Sails&r (hemp fabric) and right-click them onto the windmill hub.\n&e3.&r Connect a &6Wooden Axle&r from the windmill into a &6Kinetic Dynamo&r.\n&e4.&r Wire the dynamo with LV connectors/coils into your accumulator.",
		"",
		"&7Tip:&r More sails and higher placement improve capture; waterwheels are steadier if you have flowing water.",
		"",
		"&7Next:&r Radiator Blocks for Diesel Generator multiblocks."
	]
	quest.B100000000000361.title: "Radiator Block"
	quest.B100000000000361.quest_subtitle: "Immersive Engineering · Power"
	quest.B100000000000361.quest_desc: [
		"&6Goal:&r Craft &64 Radiator Blocks&r.",
		"",
		"Radiators appear in the Diesel Generator multiblock and other heat-heavy IE structures.",
		"",
		"&6How:&r\n&e1.&r Craft &6Radiator Blocks&r from plate/copper recipes (JEI).\n&e2.&r Open the Engineer's Manual Diesel Generator page and place Heavy Engineering, Radiators, and generators per the diagram.\n&e3.&r Hammer-form the multiblock on the indicated block face.\n&e4.&r Pipe &6Biodiesel&r (or diesel) into the fuel hatch; wire IFE out with MV-capable connectors.",
		"",
		"&7Tip:&r Refine biodiesel from ethanol + plant oil in IE fermenters/refineries before relying on diesel power.",
		"",
		"&7Next:&r Conveyors for machine I/O, then Graphite Electrodes for the Arc Furnace."
	]
	quest.B100000000000362.title: "IE Conveyors"
	quest.B100000000000362.quest_subtitle: "Immersive Engineering · Processing"
	quest.B100000000000362.quest_desc: [
		"&6Goal:&r Craft &616 Basic Conveyors&r.",
		"",
		"Move items into crushers, furnaces, and assemblers without Create belts if you prefer IE logistics.",
		"",
		"&6How:&r\n&e1.&r Place conveyors in a line into machine input faces; sneak-place to change direction.\n&e2.&r Use covered/vertical variants to climb into crusher or Arc Furnace inputs.\n&e3.&r Drop items from hoppers onto belts, or pull from chests with conveyor variants that extract.",
		"",
		"&7Tip:&r Covered conveyors keep players and stray items from kicking stacks off the line.",
		"",
		"&7Next:&r Blueprint a Graphite Electrode for the Arc Furnace."
	]
	quest.B100000000000363.title: "Graphite Electrode"
	quest.B100000000000363.quest_subtitle: "Immersive Engineering · Endgame"
	quest.B100000000000363.quest_desc: [
		"&6Goal:&r Craft a Graphite Electrode.",
		"",
		"Electrodes fuel the Arc Furnace multiblock — IE's high-throughput alloying and smelting endgame.",
		"",
		"&6How:&r\n&e1.&r At the Engineer's Workbench, use the electrode &6Blueprint&r with the listed materials to craft &6Graphite Electrodes&r.\n&e2.&r Build the &6Arc Furnace&r from the Manual (refractory bricks, Heavy Engineering, electrodes on top).\n&e3.&r Hammer-form the structure; insert electrodes into the electrode slots.\n&e4.&r Feed IFE (HV recommended), ores/ingots on conveyors, and pull slag/metals from the outputs.",
		"",
		"&cCaution:&r Electrodes wear out — keep spares crafted or the furnace stops mid-run.",
		"",
		"&7Tip:&r Pair with a Crusher multiblock upstream for dust → Arc Furnace alloy lines.",
		"",
		"&7Next:&r Chapter complete — excavator and metal press await in the Manual when you need bulk ore."
	]
	quest.B1000000000001F4.title: "Netherite"
	quest.B1000000000001F4.quest_subtitle: "Endgame gate"
	quest.B1000000000001F4.quest_desc: [
		"&6Goal:&r Smith a netherite ingot.",
		"",
		"Ancient debris + gold — the late-game material gate for this book.",
		"",
		"&6How:&r\n&e1.&r Mine ancient debris in the Nether (bed mining or strip mining Y~8–22).\n&e2.&r Smelt debris into netherite scrap, then smith scrap + gold into an ingot.\n&e3.&r Bring fire resistance and a Waystone before long Nether runs.",
		"",
		"&7Tip:&r One ingot unlocks the endgame checklist — furnaces, flight, flex crafts.",
		"",
		"&7Next:&r Flight, trains, cannons, and finale bosses branch from here.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Precision Mechanisms\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000E3\"}}"
	]
	quest.B1000000000001F5.title: "Netherite Furnace"
	quest.B1000000000001F5.quest_subtitle: "Smelting"
	quest.B1000000000001F5.quest_desc: [
		"&6Goal:&r Craft a Netherite Furnace.",
		"",
		"Top-tier smelting speed for when your ore drill finally wakes up.",
		"",
		"&6How:&r\n&e1.&r Upgrade through Iron Furnaces tiers or craft the Netherite Furnace per JEI.\n&e2.&r Place it on your smelting line and feed ore + fuel (or FE if upgraded that way).\n&e3.&r Pipe outputs into RS or drawers so the furnace never backs up.",
		"",
		"&7Tip:&r Pair with hopper/pipe automation — speed is wasted if outputs clog.",
		"",
		"&7Next:&r Optional chests, or push flight thrusters."
	]
	quest.B1000000000001F6.title: "Obsidian Chest"
	quest.B1000000000001F6.quest_subtitle: "Storage"
	quest.B1000000000001F6.quest_desc: [
		"&6Goal:&r Craft an Obsidian Chest.",
		"",
		"Blast-resistant storage for bases that experiment with Big Cannons.",
		"",
		"&6How:&r\n&e1.&r Craft the Obsidian Chest (upgrade path via Iron Chests).\n&e2.&r Place it for valuables near risky test ranges.\n&e3.&r Keep a Waystone nearby — “experiment” is doing a lot of work here.",
		"",
		"&7Tip:&r Optional flex storage — skip if RS already holds everything.",
		"",
		"&7Next:&r Diamond Chest is the other optional chest branch."
	]
	quest.B1000000000001F7.title: "Diamond Chest"
	quest.B1000000000001F7.quest_subtitle: "Storage"
	quest.B1000000000001F7.quest_desc: [
		"&6Goal:&r Craft a Diamond Chest.",
		"",
		"Huge mixed storage before full digital networks take over.",
		"",
		"&6How:&r\n&e1.&r Upgrade an Iron/Gold chest path to Diamond per JEI.\n&e2.&r Use it as a local dump chest beside a Create line.\n&e3.&r Importer into RS when you are ready to digitize the pile.",
		"",
		"&7Tip:&r Optional — drawers + RS usually outscale mixed chests.",
		"",
		"&7Next:&r Back to flight or trains from Netherite."
	]
	quest.B1000000000001F8.title: "Jetpack Thrusters"
	quest.B1000000000001F8.quest_subtitle: "Flight"
	quest.B1000000000001F8.quest_desc: [
		"&6Goal:&r Craft &62 Iron Jetpacks thrusters&r.",
		"",
		"Thrusters combine with coils, capacitors, cells, and a strap into modular jetpacks.",
		"",
		"&6How:&r\n&e1.&r Craft two thrusters for your chosen jetpack tier.\n&e2.&r Gather matching coils/capacitors while you craft.\n&e3.&r Plan FE charging: Powah Player Transmitter, alternator, or diesel.",
		"",
		"&7Tip:&r Charge with FE from your alternator / diesel / Powah setup.",
		"",
		"&7Next:&r Craft the jetpack energy cell."
	]
	quest.B1000000000001F9.title: "Jetpack Cell"
	quest.B1000000000001F9.quest_subtitle: "Flight"
	quest.B1000000000001F9.quest_desc: [
		"&6Goal:&r Craft an Iron Jetpacks energy cell.",
		"",
		"Energy storage for your jetpack assembly — don't skip the battery.",
		"",
		"&6How:&r\n&e1.&r Craft the energy cell for your jetpack tier.\n&e2.&r Keep the matching capacitor ready for final assembly.\n&e3.&r Higher cells = longer flights before you need a charger.",
		"",
		"&7Tip:&r Upgrade the cell when you upgrade thrusters — mismatched tiers feel weak.",
		"",
		"&7Next:&r Assemble the Iron Jetpack."
	]
	quest.B1000000000001FA.title: "Iron Jetpack"
	quest.B1000000000001FA.quest_subtitle: "Flight"
	quest.B1000000000001FA.quest_desc: [
		"&6Goal:&r Assemble an Iron Jetpacks jetpack.",
		"",
		"Charge it and take to the skies — independent from Create backtanks.",
		"",
		"&6How:&r\n&e1.&r Combine thrusters, cell, capacitor, coils, and strap per JEI.\n&e2.&r Equip the jetpack and charge it fully before a long flight.\n&e3.&r Bind hover/engine keys and test over water, not lava.",
		"",
		"&7Tip:&r Powah Player Transmitters keep jetpacks topped up while you build.",
		"",
		"&7Next:&r Create Jetpack if you prefer pressure over FE."
	]
	quest.B1000000000001FB.title: "Create Jetpack"
	quest.B1000000000001FB.quest_subtitle: "Flight"
	quest.B1000000000001FB.quest_desc: [
		"&6Goal:&r Craft the Create Jetpack.",
		"",
		"Runs off copper backtank pressure — perfect if your factory already fills tanks.",
		"",
		"&6How:&r\n&e1.&r Craft the Create Jetpack and a Copper Backtank.\n&e2.&r Fill the backtank at an Encased Fan + water/lava setup or tank filler.\n&e3.&r Equip both and verify thrust before long climbs.",
		"",
		"&7Tip:&r Factory air compressors beat hand-pumping before every trip.",
		"",
		"&7Next:&r Optional Brass Jetpack, or stockpile mechanisms."
	]
	quest.B1000000000001FC.title: "Brass Jetpack"
	quest.B1000000000001FC.quest_subtitle: "Flight"
	quest.B1000000000001FC.quest_desc: [
		"&6Goal:&r Craft Stuff 'N Additions brass jetpack chestplate.",
		"",
		"Another flight option for brass-rich factories — pick your favorite sky kit.",
		"",
		"&6How:&r\n&e1.&r Craft the brass jetpack chestplate per JEI.\n&e2.&r Charge/fuel it according to its tooltip requirements.\n&e3.&r Keep one flight system as daily driver; stash the rest.",
		"",
		"&7Tip:&r Optional — you only need one reliable way to fly.",
		"",
		"&7Next:&r Mechanism stockpile or trains."
	]
	quest.B1000000000001FD.title: "Cannon Mount"
	quest.B1000000000001FD.quest_subtitle: "Chaos"
	quest.B1000000000001FD.quest_desc: [
		"&6Goal:&r Craft a Create Big Cannons mount.",
		"",
		"Base of a buildable cannon — build responsibly (or don’t).",
		"",
		"&6How:&r\n&e1.&r Craft the Cannon Mount and place it on a solid test pad far from the factory.\n&e2.&r Use foundries and cast moulds for proper barrels — JEI lists the chain.\n&e3.&r Add controls/seats before loading live shot.",
		"",
		"&7Tip:&r Test ranges strongly recommended. Bases are rebuildable; friends are not.",
		"",
		"&7Next:&r Craft solid shot ammunition."
	]
	quest.B1000000000001FE.title: "Solid Shot"
	quest.B1000000000001FE.quest_subtitle: "Chaos"
	quest.B1000000000001FE.quest_desc: [
		"&6Goal:&r Craft solid shot ammunition.",
		"",
		"Optional gunnery goal — proves the barrel works.",
		"",
		"&6How:&r\n&e1.&r Craft solid shot per JEI.\n&e2.&r Load the cannon on a clear test range with a backstop.\n&e3.&r Fire once, then decide if the factory roof needed that hole.",
		"",
		"&7Tip:&r Optional chaos quest — skip without shame.",
		"",
		"&7Next:&r Back to serious endgame: bosses and elytra."
	]
	quest.B1000000000001FF.title: "Rail Empire"
	quest.B1000000000001FF.quest_subtitle: "Trains"
	quest.B1000000000001FF.quest_desc: [
		"&6Goal:&r Craft &664 Create tracks&r.",
		"",
		"Link factories across the map — trains move bulk ore, fuel, and players.",
		"",
		"&6How:&r\n&e1.&r Automate track crafting (mechanical crafters love this).\n&e2.&r Place a line between two stations with proper slopes and signals.\n&e3.&r Schedule a train for ore/fuel before decorating.",
		"",
		"&7Tip:&r Trains beat shulker relays for bulk Create logistics.",
		"",
		"&7Next:&r Steam ’n’ Rails conductor whistle for railway QoL.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Train Track\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000EE\"}}"
	]
	quest.B100000000000200.title: "Conductor Whistle"
	quest.B100000000000200.quest_subtitle: "Trains"
	quest.B100000000000200.quest_desc: [
		"&6Goal:&r Craft a Steam 'n' Rails conductor whistle.",
		"",
		"Conductors, fancy tracks, and train QoL — run the railway like you mean it.",
		"",
		"&6How:&r\n&e1.&r Craft the conductor whistle.\n&e2.&r Recruit/place conductors and bind them to your routes as the mod requires.\n&e3.&r Add fuel tanks and proper schedules so trains return home.",
		"",
		"&7Tip:&r A fueled, scheduled train beats a decorative locomotive.",
		"",
		"&7Next:&r Optional Bells \\& Whistles headlight flair."
	]
	quest.B100000000000201.title: "Train Headlight"
	quest.B100000000000201.quest_subtitle: "Trains"
	quest.B100000000000201.quest_desc: [
		"&6Goal:&r Craft a Bells \\& Whistles headlight.",
		"",
		"Dress up locomotives — pilots, grab rails, metro casing, and station flair.",
		"",
		"&6How:&r\n&e1.&r Craft the headlight and mount it on a locomotive.\n&e2.&r Add metro casing and other cosmetics if you want a full livery.\n&e3.&r Night runs look better with lights — function first, paint second.",
		"",
		"&7Tip:&r Optional cosmetics — skip if you are mid-Wither prep.",
		"",
		"&7Next:&r Mechanism stockpile toward bosses."
	]
	quest.B100000000000202.title: "Mechanism Stockpile"
	quest.B100000000000202.quest_subtitle: "Logistics flex"
	quest.B100000000000202.quest_desc: [
		"&6Goal:&r Stockpile &632 precision mechanisms&r.",
		"",
		"If this hurts, your assembly line isn't automated enough yet.",
		"",
		"&6How:&r\n&e1.&r Set mechanical crafters + deployers + arms to feed a chest nonstop.\n&e2.&r Pull mechanisms into RS or a drawer wall.\n&e3.&r Do not hand-craft thirty-two — fix the line instead.",
		"",
		"&7Tip:&r This quest is a factory exam disguised as a number.",
		"",
		"&7Next:&r Fight the Wither for a nether star.",
		"",
		"&6Connected:&r",
		"{\"text\":\"\\u2192 Precision Mechanisms\",\"color\":\"yellow\",\"underlined\":true,\"clickEvent\":{\"action\":\"change_page\",\"value\":\"B1000000000000E3\"}}"
	]
	quest.B100000000000203.title: "Wither Down"
	quest.B100000000000203.quest_subtitle: "Boss"
	quest.B100000000000203.quest_desc: [
		"&6Goal:&r Defeat the Wither and hold a nether star.",
		"",
		"Beacon bases make Create factories feel unfair — haste + speed while building is cracked.",
		"",
		"&6How:&r\n&e1.&r Prep a Wither arena (bedrock box, underground, or open desert — your call).\n&e2.&r Bring netherite gear, potions, and a Waystone escape.\n&e3.&r Kill the Wither, collect the nether star, and keep it for a beacon.",
		"",
		"&7Tip:&r Cheese is allowed. Pride is optional.",
		"",
		"&7Next:&r Dragon egg / elytra / beacon — endgame checklist."
	]
	quest.B100000000000204.title: "Dragon Egg"
	quest.B100000000000204.quest_subtitle: "Boss"
	quest.B100000000000204.quest_desc: [
		"&6Goal:&r Claim the dragon egg after beating the Ender Dragon.",
		"",
		"Trophy of the End — keep it safe or display it above the factory.",
		"",
		"&6How:&r\n&e1.&r Reach the End, destroy crystals, defeat the dragon.\n&e2.&r Click the egg carefully (piston/torch trick if it teleports).\n&e3.&r Store or display the egg somewhere you will not explode later.",
		"",
		"&7Tip:&r Optional trophy — elytra is the practical End reward.",
		"",
		"&7Next:&r Grab elytra from End ships."
	]
	quest.B100000000000205.title: "Elytra"
	quest.B100000000000205.quest_subtitle: "Finale"
	quest.B100000000000205.quest_desc: [
		"&6Goal:&r Claim elytra from the End.",
		"",
		"Combine with a jetpack or fireworks — you're done with walking.",
		"",
		"&6How:&r\n&e1.&r Find an End ship (outer islands) and take the elytra from the item frame.\n&e2.&r Craft firework rockets for boosting; mend elytra with XP/mending.\n&e3.&r Optional: shulker shells for portable storage on the same trip.",
		"",
		"&7Tip:&r You've reached the end of the guided quest book — keep building absurd factories.",
		"",
		"&7Next:&r Optional beacon base, then free play."
	]
	quest.B100000000000206.title: "Netherite Construction Stick"
	quest.B100000000000206.quest_subtitle: "Building"
	quest.B100000000000206.quest_desc: [
		"&6Goal:&r Craft the netherite construction stick.",
		"",
		"Maximum reach building for megabases and rail yards.",
		"",
		"&6How:&r\n&e1.&r Upgrade Construction Stick tiers to netherite per JEI.\n&e2.&r Configure placement mode (wall/floor/fill) before big builds.\n&e3.&r Bring shulker boxes of building blocks to the site.",
		"",
		"&7Tip:&r Optional QoL — worth it before paving a rail empire.",
		"",
		"&7Next:&r Keep building."
	]
	quest.B100000000000207.title: "Tombstone Dust"
	quest.B100000000000207.quest_subtitle: "Death QoL"
	quest.B100000000000207.quest_desc: [
		"&6Goal:&r Collect &68 grave dust&r from Corail Tombstone.",
		"",
		"Graves protect items on death — dust feeds magic crafts.",
		"",
		"&6How:&r\n&e1.&r Die less; when you do, recover from your grave.\n&e2.&r Collect grave dust from Tombstone mechanics/crafts per JEI.\n&e3.&r Stock eight dust for magic recipes you care about.",
		"",
		"&7Tip:&r Optional death QoL path — the best strategy is still not dying.",
		"",
		"&7Next:&r Optional tools, or back to bosses."
	]
	quest.B100000000000208.title: "Brass Drill Head"
	quest.B100000000000208.quest_subtitle: "Tools"
	quest.B100000000000208.quest_desc: [
		"&6Goal:&r Craft a brass drill head (Stuff 'N Additions).",
		"",
